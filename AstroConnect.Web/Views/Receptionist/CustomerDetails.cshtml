@using AstroConnect.Domain.Enums
@model AstroConnect.Web.ViewModels.Receptionist.ReceptionistCustomerDetailsViewModel

@{
    ViewData["Title"] = "Customer Details";
}

<div class="container-fluid py-4">

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">

                <i class="fa-solid fa-user text-primary me-2"></i>

                Customer Details

            </h2>

            <p class="text-muted mb-0">
                View customer information and booking history.
            </p>

        </div>

        <a asp-controller="Customer"
           asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="fa-solid fa-arrow-left me-1"></i>

            Back to Customers

        </a>

    </div>


    <!-- =====================================================
         CUSTOMER INFORMATION
         ===================================================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-primary text-white py-3">

            <h5 class="mb-0">

                <i class="fa-solid fa-user me-2"></i>

                Customer Information

            </h5>

        </div>


        <div class="card-body p-4">

            <div class="row g-4">

                <!-- FULL NAME -->

                <div class="col-md-6 col-lg-4">

                    <div class="detail-item">

                        <span class="detail-label">
                            Full Name
                        </span>

                        <span class="detail-value">

                            <i class="fa-solid fa-user text-primary me-2"></i>

                            @Model.Customer.FullName

                        </span>

                    </div>

                </div>


                <!-- EMAIL -->

                <div class="col-md-6 col-lg-4">

                    <div class="detail-item">

                        <span class="detail-label">
                            Email
                        </span>

                        <span class="detail-value">

                            <i class="fa-solid fa-envelope text-primary me-2"></i>

                            @Model.Customer.Email

                        </span>

                    </div>

                </div>


                <!-- PHONE -->

                <div class="col-md-6 col-lg-4">

                    <div class="detail-item">

                        <span class="detail-label">
                            Phone Number
                        </span>

                        <span class="detail-value">

                            <i class="fa-solid fa-phone text-success me-2"></i>

                            @Model.Customer.PhoneNumber

                        </span>

                    </div>

                </div>


                <!-- DATE OF BIRTH -->

                <div class="col-md-6 col-lg-4">

                    <div class="detail-item">

                        <span class="detail-label">
                            Date of Birth
                        </span>

                        <span class="detail-value">

                            <i class="fa-solid fa-calendar text-primary me-2"></i>

                            @Model.Customer.DateOfBirth.ToString("dd MMM yyyy")

                        </span>

                    </div>

                </div>


                <!-- GENDER -->

                <div class="col-md-6 col-lg-4">

                    <div class="detail-item">

                        <span class="detail-label">
                            Gender
                        </span>

                        <span class="detail-value">

                            <i class="fa-solid fa-venus-mars text-danger me-2"></i>

                            @Model.Customer.Gender

                        </span>

                    </div>

                </div>


                <!-- BIRTH TIME -->

                <div class="col-md-6 col-lg-4">

                    <div class="detail-item">

                        <span class="detail-label">
                            Birth Time
                        </span>

                        <span class="detail-value">

                            <i class="fa-solid fa-clock text-warning me-2"></i>

                            @Model.Customer.BirthTime

                        </span>

                    </div>

                </div>


                <!-- BIRTH PLACE -->

                <div class="col-md-6 col-lg-6">

                    <div class="detail-item">

                        <span class="detail-label">
                            Birth Place
                        </span>

                        <span class="detail-value">

                            <i class="fa-solid fa-location-dot text-danger me-2"></i>

                            @Model.Customer.BirthPlace

                        </span>

                    </div>

                </div>


                <!-- ADDRESS -->

                <div class="col-md-6 col-lg-6">

                    <div class="detail-item">

                        <span class="detail-label">
                            Address
                        </span>

                        <span class="detail-value">

                            <i class="fa-solid fa-house text-info me-2"></i>

                            @Model.Customer.Address

                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         BOOKING HISTORY
         ===================================================== -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-dark text-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0">

                    <i class="fa-solid fa-calendar-days me-2"></i>

                    Booking History

                </h5>

                <span class="badge bg-light text-dark">

                    @Model.Bookings.Count Booking(s)

                </span>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model.Bookings.Any())
            {

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4">
                                    #
                                </th>

                                <th>
                                    Service
                                </th>

                                <th>
                                    Astrologer
                                </th>

                                <th>
                                    Date
                                </th>

                                <th>
                                    Time
                                </th>

                                <th>
                                    Status
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @{
                                int slNo = 1;
                            }

                            @foreach (var booking in Model.Bookings)
                            {

                                <tr>

                                    <!-- NUMBER -->

                                    <td class="ps-4">

                                        @slNo

                                    </td>


                                    <!-- SERVICE -->

                                    <td>

                                        <a asp-controller="Receptionist"
                                           asp-action="BookingDetails"
                                           asp-route-id="@booking.Id"
                                           class="text-decoration-none fw-semibold">

                                            @(booking.Service?.Name ?? "N/A")

                                        </a>

                                    </td>


                                    <!-- ASTROLOGER -->

                                    <td>

                                        @(booking.Astrologer?.FullName ?? "N/A")

                                    </td>


                                    <!-- DATE -->

                                    <td>

                                        @booking.BookingDate.ToString("dd MMM yyyy")

                                    </td>


                                    <!-- TIME -->

                                    <td>

                                        <span class="fw-semibold">

                                            @booking.StartTime.ToString("hh:mm tt")

                                        </span>

                                        <span class="text-muted">

                                            -

                                            @booking.EndTime.ToString("hh:mm tt")

                                        </span>

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        @switch (booking.Status)
                                        {

                                            case BookingStatus.Pending:

                                                <span class="badge bg-warning text-dark">

                                                    <i class="fa-solid fa-clock me-1"></i>

                                                    Pending

                                                </span>

                                                break;


                                            case BookingStatus.Confirmed:

                                                <span class="badge bg-primary">

                                                    <i class="fa-solid fa-circle-check me-1"></i>

                                                    Confirmed

                                                </span>

                                                break;


                                            case BookingStatus.Completed:

                                                <span class="badge bg-success">

                                                    <i class="fa-solid fa-check-double me-1"></i>

                                                    Completed

                                                </span>

                                                break;


                                            case BookingStatus.Cancelled:

                                                <span class="badge bg-danger">

                                                    <i class="fa-solid fa-circle-xmark me-1"></i>

                                                    Cancelled

                                                </span>

                                                break;


                                            default:

                                                <span class="badge bg-secondary">

                                                    @booking.Status

                                                </span>

                                                break;

                                        }

                                    </td>

                                </tr>

                                slNo++;

                            }

                        </tbody>

                    </table>

                </div>

            }
            else
            {

                <div class="text-center py-5">

                    <div class="empty-icon mx-auto mb-3">

                        <i class="fa-solid fa-calendar-xmark"></i>

                    </div>

                    <h5 class="fw-bold">
                        No Booking History
                    </h5>

                    <p class="text-muted mb-0">

                        This customer has not made any bookings yet.

                    </p>

                </div>

            }

        </div>

    </div>

</div>


<!-- =====================================================
     STYLES
     ===================================================== -->

<style>

    .detail-item {
        height: 100%;
        padding: 16px;
        border: 1px solid #e9ecef;
        border-radius: 12px;
        background: #fafafa;
        transition: all .2s ease;
    }

        .detail-item:hover {
            background: #f8f9fa;
            transform: translateY(-2px);
        }

    .detail-label {
        display: block;
        color: #6c757d;
        font-size: .8rem;
        font-weight: 600;
        margin-bottom: 6px;
        text-transform: uppercase;
    }

    .detail-value {
        display: flex;
        align-items: center;
        font-weight: 600;
        color: #212529;
        word-break: break-word;
    }

    .empty-icon {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: #f1f3f5;
        color: #6c757d;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

</style>