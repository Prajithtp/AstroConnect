@using AstroConnect.Domain.Enums
@model AstroConnect.Web.ViewModels.Receptionist.ReceptionistCustomerDetailsViewModel

@{
    ViewData["Title"] = "Customer Details";
}

<section class="customer-details-page">

    <div class="container">

        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="page-header">

            <div>

                <span class="section-label">
                    RECEPTION DESK
                </span>

                <h1>
                    Customer Details
                </h1>

                <p>
                    Review customer information, birth details
                    and complete booking history.
                </p>

            </div>


            <a asp-controller="Customer"
               asp-action="Index"
               class="back-btn">

                <i class="fa-solid fa-arrow-left"></i>

                Back to Customers

            </a>

        </div>


        <!-- =====================================================
             CUSTOMER HERO
             ===================================================== -->

        <section class="customer-hero">

            <div class="hero-orbit orbit-one"></div>
            <div class="hero-orbit orbit-two"></div>

            <div class="customer-identity">

                <div class="customer-avatar">

                    @{
                        var initials = string.Join("",
                        (Model.Customer.FullName ?? "Customer")
                        .Split(
                        ' ',
                        StringSplitOptions.RemoveEmptyEntries)
                        .Take(2)
                        .Select(x => x[0]))
                        .ToUpper();
                    }

                    @initials

                </div>


                <div>

                    <span class="hero-label">
                        CUSTOMER PROFILE
                    </span>

                    <h2>
                        @Model.Customer.FullName
                    </h2>

                    <p>
                        @Model.Customer.Email
                    </p>

                </div>

            </div>


            <div class="hero-booking-count">

                <span>
                    TOTAL BOOKINGS
                </span>

                <strong>
                    @Model.Bookings.Count
                </strong>

                <small>
                    @(Model.Bookings.Count == 1 ? "appointment" : "appointments")
                </small>

            </div>

        </section>


        <!-- =====================================================
             CUSTOMER INFORMATION
             ===================================================== -->

        <section class="customer-info-card">

            <div class="card-heading">

                <div class="heading-icon">

                    <i class="fa-solid fa-user"></i>

                </div>

                <div>

                    <span>
                        CUSTOMER PROFILE
                    </span>

                    <h2>
                        Customer Information
                    </h2>

                    <p>
                        Personal, contact and birth details.
                    </p>

                </div>

            </div>


            <div class="row g-3">


                <!-- FULL NAME -->

                <div class="col-md-6 col-lg-4">

                    <div class="detail-item">

                        <div class="detail-icon">

                            <i class="fa-solid fa-user"></i>

                        </div>

                        <div>

                            <span>
                                FULL NAME
                            </span>

                            <strong>
                                @Model.Customer.FullName
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- EMAIL -->

                <div class="col-md-6 col-lg-4">

                    <div class="detail-item">

                        <div class="detail-icon">

                            <i class="fa-regular fa-envelope"></i>

                        </div>

                        <div>

                            <span>
                                EMAIL
                            </span>

                            <strong>
                                @Model.Customer.Email
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- PHONE -->

                <div class="col-md-6 col-lg-4">

                    <div class="detail-item">

                        <div class="detail-icon">

                            <i class="fa-solid fa-phone"></i>

                        </div>

                        <div>

                            <span>
                                PHONE NUMBER
                            </span>

                            <strong>
                                @Model.Customer.PhoneNumber
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- DATE OF BIRTH -->

                <div class="col-md-6 col-lg-4">

                    <div class="detail-item">

                        <div class="detail-icon gold-icon">

                            <i class="fa-solid fa-calendar"></i>

                        </div>

                        <div>

                            <span>
                                DATE OF BIRTH
                            </span>

                            <strong>
                                @Model.Customer.DateOfBirth.ToString("dd MMM yyyy")
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- GENDER -->

                <div class="col-md-6 col-lg-4">

                    <div class="detail-item">

                        <div class="detail-icon">

                            <i class="fa-solid fa-venus-mars"></i>

                        </div>

                        <div>

                            <span>
                                GENDER
                            </span>

                            <strong>
                                @Model.Customer.Gender
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- BIRTH TIME -->

                <div class="col-md-6 col-lg-4">

                    <div class="detail-item">

                        <div class="detail-icon gold-icon">

                            <i class="fa-solid fa-clock"></i>

                        </div>

                        <div>

                            <span>
                                BIRTH TIME
                            </span>

                            <strong>
                                @Model.Customer.BirthTime
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- BIRTH PLACE -->

                <div class="col-md-6">

                    <div class="detail-item">

                        <div class="detail-icon">

                            <i class="fa-solid fa-location-dot"></i>

                        </div>

                        <div>

                            <span>
                                BIRTH PLACE
                            </span>

                            <strong>
                                @Model.Customer.BirthPlace
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- ADDRESS -->

                <div class="col-md-6">

                    <div class="detail-item">

                        <div class="detail-icon">

                            <i class="fa-solid fa-house"></i>

                        </div>

                        <div>

                            <span>
                                ADDRESS
                            </span>

                            <strong>
                                @Model.Customer.Address
                            </strong>

                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- =====================================================
             BOOKING HISTORY
             ===================================================== -->

        <section class="booking-history-card">

            <div class="booking-heading">

                <div class="booking-heading-main">

                    <div class="heading-icon dark-heading-icon">

                        <i class="fa-solid fa-calendar-days"></i>

                    </div>

                    <div>

                        <span>
                            APPOINTMENT HISTORY
                        </span>

                        <h2>
                            Booking History
                        </h2>

                        <p>
                            Previous and current consultations for this customer.
                        </p>

                    </div>

                </div>


                <div class="booking-count">

                    <strong>
                        @Model.Bookings.Count
                    </strong>

                    <span>
                        @(Model.Bookings.Count == 1 ? "booking" : "bookings")
                    </span>

                </div>

            </div>


            @if (Model.Bookings.Any())
            {
                <!-- =================================================
                     DESKTOP TABLE
                     ================================================= -->

                <div class="desktop-bookings">

                    <div class="table-responsive">

                        <table class="table booking-table align-middle">

                            <thead>

                                <tr>

                                    <th>
                                        #
                                    </th>

                                    <th>
                                        Service
                                    </th>

                                    <th>
                                        Astrologer
                                    </th>

                                    <th>
                                        Date
                                    </th>

                                    <th>
                                        Time
                                    </th>

                                    <th>
                                        Status
                                    </th>

                                    <th class="text-end">
                                        Details
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @{
                                    int slNo = 1;
                                }

                                @foreach (var booking in Model.Bookings)
                                {
                                    <tr>

                                        <!-- NUMBER -->

                                        <td>

                                            <span class="serial-number">
                                                @slNo
                                            </span>

                                        </td>


                                        <!-- SERVICE -->

                                        <td>

                                            <div class="service-cell">

                                                <div class="table-icon">

                                                    <i class="fa-solid fa-moon"></i>

                                                </div>

                                                <div>

                                                    <span>
                                                        SERVICE
                                                    </span>

                                                    <strong>
                                                        @(booking.Service?.Name ?? "N/A")
                                                    </strong>

                                                </div>

                                            </div>

                                        </td>


                                        <!-- ASTROLOGER -->

                                        <td>

                                            <div class="astrologer-cell">

                                                <div class="astrologer-icon">

                                                    <i class="fa-solid fa-star"></i>

                                                </div>

                                                <div>

                                                    <span>
                                                        ASTROLOGER
                                                    </span>

                                                    <strong>
                                                        @(booking.Astrologer?.FullName ?? "N/A")
                                                    </strong>

                                                </div>

                                            </div>

                                        </td>


                                        <!-- DATE -->

                                        <td>

                                            <div class="date-cell">

                                                <i class="fa-regular fa-calendar"></i>

                                                @booking.BookingDate.ToString("dd MMM yyyy")

                                            </div>

                                        </td>


                                        <!-- TIME -->

                                        <td>

                                            <div class="time-cell">

                                                <i class="fa-regular fa-clock"></i>

                                                <div>

                                                    <strong>
                                                        @booking.StartTime.ToString("hh:mm tt")
                                                    </strong>

                                                    <span>
                                                        to @booking.EndTime.ToString("hh:mm tt")
                                                    </span>

                                                </div>

                                            </div>

                                        </td>


                                        <!-- STATUS -->

                                        <td>

                                            @switch (booking.Status)
                                            {
                                                case BookingStatus.Pending:

                                                    <span class="status-badge status-pending">

                                                        <span class="status-dot"></span>

                                                        Pending

                                                    </span>

                                                    break;


                                                case BookingStatus.Confirmed:

                                                    <span class="status-badge status-confirmed">

                                                        <span class="status-dot"></span>

                                                        Confirmed

                                                    </span>

                                                    break;


                                                case BookingStatus.Completed:

                                                    <span class="status-badge status-completed">

                                                        <span class="status-dot"></span>

                                                        Completed

                                                    </span>

                                                    break;


                                                case BookingStatus.Cancelled:

                                                    <span class="status-badge status-cancelled">

                                                        <span class="status-dot"></span>

                                                        Cancelled

                                                    </span>

                                                    break;


                                                default:

                                                    <span class="status-badge status-default">

                                                        <span class="status-dot"></span>

                                                        @booking.Status

                                                    </span>

                                                    break;
                                            }

                                        </td>


                                        <!-- DETAILS -->

                                        <td class="text-end">

                                            <a asp-controller="Receptionist"
                                               asp-action="BookingDetails"
                                               asp-route-id="@booking.Id"
                                               class="details-btn"
                                               title="View Booking Details">

                                                <i class="fa-solid fa-eye"></i>

                                            </a>

                                        </td>

                                    </tr>

                                    slNo++;
                                }

                            </tbody>

                        </table>

                    </div>

                </div>


                <!-- =================================================
                     MOBILE CARDS
                     ================================================= -->

                <div class="mobile-bookings">

                    @foreach (var booking in Model.Bookings)
                    {
                        <article class="mobile-booking-card">

                            <div class="mobile-card-top">

                                <div>

                                    <span class="mobile-label">
                                        CONSULTATION
                                    </span>

                                    <h3>
                                        @(booking.Service?.Name ?? "N/A")
                                    </h3>

                                </div>


                                @switch (booking.Status)
                                {
                                    case BookingStatus.Pending:

                                        <span class="status-badge status-pending">

                                            <span class="status-dot"></span>

                                            Pending

                                        </span>

                                        break;


                                    case BookingStatus.Confirmed:

                                        <span class="status-badge status-confirmed">

                                            <span class="status-dot"></span>

                                            Confirmed

                                        </span>

                                        break;


                                    case BookingStatus.Completed:

                                        <span class="status-badge status-completed">

                                            <span class="status-dot"></span>

                                            Completed

                                        </span>

                                        break;


                                    case BookingStatus.Cancelled:

                                        <span class="status-badge status-cancelled">

                                            <span class="status-dot"></span>

                                            Cancelled

                                        </span>

                                        break;
                                }

                            </div>


                            <div class="mobile-detail-grid">

                                <div>

                                    <i class="fa-solid fa-star"></i>

                                    <div>

                                        <span>
                                            Astrologer
                                        </span>

                                        <strong>
                                            @(booking.Astrologer?.FullName ?? "N/A")
                                        </strong>

                                    </div>

                                </div>


                                <div>

                                    <i class="fa-regular fa-calendar"></i>

                                    <div>

                                        <span>
                                            Date
                                        </span>

                                        <strong>
                                            @booking.BookingDate.ToString("dd MMM yyyy")
                                        </strong>

                                    </div>

                                </div>


                                <div>

                                    <i class="fa-regular fa-clock"></i>

                                    <div>

                                        <span>
                                            Time
                                        </span>

                                        <strong>
                                            @booking.StartTime.ToString("hh:mm tt")
                                            -
                                            @booking.EndTime.ToString("hh:mm tt")
                                        </strong>

                                    </div>

                                </div>

                            </div>


                            <a asp-controller="Receptionist"
                               asp-action="BookingDetails"
                               asp-route-id="@booking.Id"
                               class="mobile-details-btn">

                                <i class="fa-solid fa-eye"></i>

                                View Booking Details

                            </a>

                        </article>
                    }

                </div>
            }
            else
            {
                <!-- =================================================
                     EMPTY STATE
                     ================================================= -->

                <div class="empty-state">

                    <div class="empty-icon">

                        <i class="fa-solid fa-calendar-xmark"></i>

                    </div>

                    <span>
                        APPOINTMENT HISTORY
                    </span>

                    <h3>
                        No booking history.
                    </h3>

                    <p>
                        This customer has not made any bookings yet.
                    </p>


                    <a asp-controller="Booking"
                       asp-action="Create"
                       class="create-booking-btn">

                        <i class="fa-solid fa-calendar-plus"></i>

                        Create Booking

                    </a>

                </div>
            }

        </section>


        <!-- =====================================================
             FOOTER CTA
             ===================================================== -->

        <section class="customer-footer">

            <div>

                <div class="footer-icon">

                    <i class="fa-solid fa-headset"></i>

                </div>

                <div>

                    <span>
                        RECEPTION SUPPORT
                    </span>

                    <h3>
                        Need to schedule a consultation for this customer?
                    </h3>

                    <p>
                        Create a new booking using the customer appointment workflow.
                    </p>

                </div>

            </div>


            <a asp-controller="Booking"
               asp-action="Create"
               class="footer-booking-btn">

                <i class="fa-solid fa-calendar-plus"></i>

                New Booking

            </a>

        </section>

    </div>

</section>


<style>

    /* =====================================================
           PAGE
           ===================================================== */

    .customer-details-page {
        min-height: 100vh;
        padding: 45px 0 80px;
        background: #f8f5ec;
    }


    /* =====================================================
           HEADER
           ===================================================== */

    .page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 30px;
        margin-bottom: 28px;
    }

    .section-label {
        display: block;
        margin-bottom: 8px;
        color: #987918;
        font-size: .63rem;
        font-weight: 800;
        letter-spacing: .17em;
    }

    .page-header h1 {
        margin-bottom: 8px;
        color: #181710;
        font-family: 'DM Serif Display', serif;
        font-size: clamp(2.5rem, 4vw, 3.8rem);
        font-weight: 400;
        line-height: 1;
    }

    .page-header p {
        max-width: 620px;
        margin: 0;
        color: #817b70;
        font-size: .8rem;
        line-height: 1.7;
    }

    .back-btn {
        min-height: 43px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        flex-shrink: 0;
        padding: 9px 16px;
        border: 1px solid #ccc2af;
        border-radius: 9px;
        background: transparent;
        color: #181710;
        font-size: .67rem;
        font-weight: 700;
        text-decoration: none;
        transition: all .2s ease;
    }

        .back-btn:hover {
            border-color: #181710;
            background: #181710;
            color: white;
        }


    /* =====================================================
           CUSTOMER HERO
           ===================================================== */

    .customer-hero {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
        overflow: hidden;
        margin-bottom: 20px;
        padding: 29px 31px;
        border-radius: 20px;
        background: #181710;
        color: white;
    }

    .customer-identity {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .customer-avatar {
        width: 58px;
        height: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 50%;
        background: #e1bf4a;
        color: #181710;
        font-family: 'DM Serif Display', serif;
        font-size: 1.35rem;
    }

    .hero-label {
        display: block;
        margin-bottom: 3px;
        color: #e1bf4a;
        font-size: .5rem;
        font-weight: 800;
        letter-spacing: .14em;
    }

    .customer-identity h2 {
        margin-bottom: 3px;
        font-family: 'DM Serif Display', serif;
        font-size: 1.8rem;
        font-weight: 400;
    }

    .customer-identity p {
        margin: 0;
        color: rgba(255,255,255,.46);
        font-size: .65rem;
    }

    .hero-booking-count {
        position: relative;
        z-index: 2;
        flex-shrink: 0;
        text-align: center;
    }

        .hero-booking-count span,
        .hero-booking-count strong,
        .hero-booking-count small {
            display: block;
        }

        .hero-booking-count span {
            margin-bottom: 3px;
            color: rgba(255,255,255,.34);
            font-size: .47rem;
            font-weight: 800;
            letter-spacing: .09em;
        }

        .hero-booking-count strong {
            color: #e1bf4a;
            font-family: 'DM Serif Display', serif;
            font-size: 2rem;
            font-weight: 400;
            line-height: 1;
        }

        .hero-booking-count small {
            margin-top: 3px;
            color: rgba(255,255,255,.4);
            font-size: .48rem;
        }

    .hero-orbit {
        position: absolute;
        border: 1px solid rgba(225,191,74,.06);
        border-radius: 50%;
    }

    .orbit-one {
        width: 270px;
        height: 270px;
        right: -130px;
        top: -180px;
    }

    .orbit-two {
        width: 180px;
        height: 180px;
        right: 90px;
        bottom: -145px;
    }


    /* =====================================================
           CUSTOMER INFO CARD
           ===================================================== */

    .customer-info-card {
        margin-bottom: 20px;
        padding: 27px;
        border: 1px solid #e1d9ca;
        border-radius: 19px;
        background: #fffdf8;
    }

    .card-heading {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 22px;
    }

    .heading-icon {
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 50%;
        background: #e1bf4a;
        color: #181710;
        font-size: .7rem;
    }

    .dark-heading-icon {
        background: #181710;
        color: #e1bf4a;
    }

    .card-heading span,
    .booking-heading-main span {
        display: block;
        margin-bottom: 2px;
        color: #987918;
        font-size: .49rem;
        font-weight: 800;
        letter-spacing: .12em;
    }

    .card-heading h2,
    .booking-heading-main h2 {
        margin-bottom: 2px;
        color: #29251f;
        font-family: 'DM Serif Display', serif;
        font-size: 1.45rem;
        font-weight: 400;
    }

    .card-heading p,
    .booking-heading-main p {
        margin: 0;
        color: #958d80;
        font-size: .6rem;
    }


    /* =====================================================
           DETAIL ITEM
           ===================================================== */

    .detail-item {
        height: 100%;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 13px;
        border: 1px solid #e8e0d4;
        border-radius: 11px;
        background: #faf7ef;
        transition: all .2s ease;
    }

        .detail-item:hover {
            transform: translateY(-2px);
            border-color: #cfb95f;
            background: #fffdf8;
        }

    .detail-icon {
        width: 35px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 50%;
        background: #181710;
        color: #e1bf4a;
        font-size: .58rem;
    }

        .detail-icon.gold-icon {
            background: #fff0ad;
            color: #6e5911;
        }

    .detail-item span,
    .detail-item strong {
        display: block;
    }

    .detail-item span {
        margin-bottom: 2px;
        color: #999184;
        font-size: .44rem;
        font-weight: 800;
        letter-spacing: .06em;
    }

    .detail-item strong {
        color: #39342c;
        font-size: .64rem;
        overflow-wrap: anywhere;
    }


    /* =====================================================
           BOOKING HISTORY
           ===================================================== */

    .booking-history-card {
        overflow: hidden;
        border: 1px solid #e1d9ca;
        border-radius: 19px;
        background: #fffdf8;
    }

    .booking-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
        padding: 26px 27px 21px;
    }

    .booking-heading-main {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .booking-count {
        flex-shrink: 0;
        text-align: center;
    }

        .booking-count strong,
        .booking-count span {
            display: block;
        }

        .booking-count strong {
            color: #181710;
            font-family: 'DM Serif Display', serif;
            font-size: 1.65rem;
            font-weight: 400;
            line-height: 1;
        }

        .booking-count span {
            margin-top: 2px;
            color: #958d80;
            font-size: .48rem;
            font-weight: 700;
        }


    /* =====================================================
           TABLE
           ===================================================== */

    .booking-table {
        margin: 0;
    }

        .booking-table thead th {
            padding: 12px 15px;
            border-top: 1px solid #e7dfd2;
            border-bottom: 1px solid #ded5c6;
            background: #faf7ef;
            color: #8d8578;
            font-size: .52rem;
            font-weight: 800;
            letter-spacing: .07em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .booking-table tbody td {
            padding: 15px;
            border-bottom: 1px solid #eee7dc;
            color: #554f46;
            font-size: .65rem;
        }

        .booking-table tbody tr:last-child td {
            border-bottom: 0;
        }

        .booking-table tbody tr {
            transition: background .18s ease;
        }

            .booking-table tbody tr:hover {
                background: #fbf8f1;
            }

    .serial-number {
        width: 28px;
        height: 28px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #f0eadf;
