@using AstroConnect.Domain.Enums
@model AstroConnect.Web.ViewModels.Receptionist.ReceptionistBookingsViewModel

@{
    ViewData["Title"] = "Booking Management";

    var totalBookings = Model.Bookings?.Count ?? 0;
    var pendingCount = Model.Bookings?.Count(x => x.Status == BookingStatus.Pending) ?? 0;
    var confirmedCount = Model.Bookings?.Count(x => x.Status == BookingStatus.Confirmed) ?? 0;
    var completedCount = Model.Bookings?.Count(x => x.Status == BookingStatus.Completed) ?? 0;
}

<section class="booking-management-page">

    <div class="container">

        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="page-header">

            <div>

                <span class="section-label">
                    RECEPTION DESK
                </span>

                <h1>
                    Booking Management
                </h1>

                <p>
                    Search, review and manage customer appointments
                    from one place.
                </p>

            </div>


            <div class="header-actions">

                <a asp-controller="Receptionist"
                   asp-action="Index"
                   class="btn dashboard-btn">

                    <i class="fa-solid fa-arrow-left"></i>

                    Dashboard

                </a>


                <a asp-controller="Booking"
                   asp-action="Create"
                   class="btn new-booking-btn">

                    <i class="fa-solid fa-calendar-plus"></i>

                    New Booking

                </a>

            </div>

        </div>


        <!-- =====================================================
             SUMMARY
             ===================================================== -->

        <div class="booking-summary">

            <div class="summary-intro">

                <div class="summary-main-icon">

                    <i class="fa-solid fa-calendar-days"></i>

                </div>

                <div>

                    <span>
                        APPOINTMENT OVERVIEW
                    </span>

                    <h2>
                        Booking activity
                    </h2>

                </div>

            </div>


            <div class="summary-stats">

                <div class="summary-stat">

                    <span>
                        TOTAL
                    </span>

                    <strong>
                        @totalBookings
                    </strong>

                </div>


                <div class="summary-divider"></div>


                <div class="summary-stat">

                    <span>
                        PENDING
                    </span>

                    <strong>
                        @pendingCount
                    </strong>

                </div>


                <div class="summary-divider"></div>


                <div class="summary-stat">

                    <span>
                        CONFIRMED
                    </span>

                    <strong>
                        @confirmedCount
                    </strong>

                </div>


                <div class="summary-divider"></div>


                <div class="summary-stat">

                    <span>
                        COMPLETED
                    </span>

                    <strong>
                        @completedCount
                    </strong>

                </div>

            </div>

        </div>


        <!-- =====================================================
             FILTERS
             ===================================================== -->

        <section class="filter-card">

            <div class="filter-heading">

                <div>

                    <span>
                        FIND APPOINTMENTS
                    </span>

                    <h2>
                        Search & Filter
                    </h2>

                </div>


                <div class="filter-icon">

                    <i class="fa-solid fa-sliders"></i>

                </div>

            </div>


            <div class="row g-3">

                <!-- SEARCH -->

                <div class="col-lg-5">

                    <label class="filter-label"
                           for="bookingSearch">

                        Search

                    </label>


                    <div class="filter-input">

                        <i class="fa-solid fa-magnifying-glass"></i>

                        <input type="text"
                               id="bookingSearch"
                               class="form-control"
                               placeholder="Customer, astrologer or service" />

                    </div>

                </div>


                <!-- STATUS -->

                <div class="col-lg-3 col-md-5">

                    <label class="filter-label"
                           for="statusFilter">

                        Status

                    </label>


                    <div class="filter-input">

                        <i class="fa-solid fa-circle-half-stroke"></i>

                        <select id="statusFilter"
                                class="form-select">

                            <option value="">
                                All Status
                            </option>

                            <option value="Pending">
                                Pending
                            </option>

                            <option value="Confirmed">
                                Confirmed
                            </option>

                            <option value="Completed">
                                Completed
                            </option>

                            <option value="Cancelled">
                                Cancelled
                            </option>

                        </select>

                    </div>

                </div>


                <!-- DATE -->

                <div class="col-lg-2 col-md-4">

                    <label class="filter-label"
                           for="dateFilter">

                        Date

                    </label>


                    <div class="filter-input">

                        <i class="fa-regular fa-calendar"></i>

                        <input type="date"
                               id="dateFilter"
                               class="form-control" />

                    </div>

                </div>


                <!-- CLEAR -->

                <div class="col-lg-2 col-md-3 d-flex align-items-end">

                    <button type="button"
                            id="clearFilters"
                            class="clear-filter-btn">

                        <i class="fa-solid fa-filter-circle-xmark"></i>

                        Clear

                    </button>

                </div>

            </div>

        </section>


        <!-- =====================================================
             BOOKINGS
             ===================================================== -->

        <section class="bookings-card">

            <div class="bookings-card-header">

                <div class="bookings-title">

                    <div class="bookings-icon">

                        <i class="fa-solid fa-calendar-check"></i>

                    </div>

                    <div>

                        <span>
                            APPOINTMENT RECORDS
                        </span>

                        <h2>
                            All Bookings
                        </h2>

                        <p>
                            Manage appointment status and view booking information.
                        </p>

                    </div>

                </div>


                <div class="record-count">

                    <strong id="visibleBookingCount">
                        @totalBookings
                    </strong>

                    <span>
                        bookings
                    </span>

                </div>

            </div>


            @if (Model.Bookings != null && Model.Bookings.Any())
            {
                <!-- =================================================
                     DESKTOP TABLE
                     ================================================= -->

                <div class="desktop-bookings">

                    <div class="table-responsive">

                        <table class="table booking-table align-middle"
                               id="bookingTable">

                            <thead>

                                <tr>

                                    <th>
                                        #
                                    </th>

                                    <th>
                                        Customer
                                    </th>

                                    <th>
                                        Astrologer
                                    </th>

                                    <th>
                                        Service
                                    </th>

                                    <th>
                                        Date
                                    </th>

                                    <th>
                                        Time
                                    </th>

                                    <th>
                                        Status
                                    </th>

                                    <th class="text-end">
                                        Actions
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @{
                                    int slNo = 1;
                                }

                                @foreach (var booking in Model.Bookings)
                                {
                                    <tr data-status="@booking.Status"
                                        data-date="@booking.BookingDate.ToString("yyyy-MM-dd")">

                                        <!-- NUMBER -->

                                        <td>

                                            <span class="serial-number">
                                                @slNo
                                            </span>

                                        </td>


                                        <!-- CUSTOMER -->

                                        <td>

                                            <div class="person-cell">

                                                <div class="person-icon">

                                                    <i class="fa-solid fa-user"></i>

                                                </div>

                                                <div>

                                                    <span>
                                                        CUSTOMER
                                                    </span>

                                                    <strong>
                                                        @(booking.Customer?.FullName ?? "N/A")
                                                    </strong>

                                                </div>

                                            </div>

                                        </td>


                                        <!-- ASTROLOGER -->

                                        <td>

                                            <div class="person-cell">

                                                <div class="person-icon astrologer-icon">

                                                    <i class="fa-solid fa-star"></i>

                                                </div>

                                                <div>

                                                    <span>
                                                        ASTROLOGER
                                                    </span>

                                                    <strong>
                                                        @(booking.Astrologer?.FullName ?? "N/A")
                                                    </strong>

                                                </div>

                                            </div>

                                        </td>


                                        <!-- SERVICE -->

                                        <td>

                                            <div class="service-cell">

                                                <i class="fa-solid fa-moon"></i>

                                                <span>
                                                    @(booking.Service?.Name ?? "N/A")
                                                </span>

                                            </div>

                                        </td>


                                        <!-- DATE -->

                                        <td>

                                            <div class="date-cell">

                                                <i class="fa-regular fa-calendar"></i>

                                                <span>
                                                    @booking.BookingDate.ToString("dd MMM yyyy")
                                                </span>

                                            </div>

                                        </td>


                                        <!-- TIME -->

                                        <td>

                                            <div class="time-cell">

                                                <i class="fa-regular fa-clock"></i>

                                                <div>

                                                    <strong>
                                                        @booking.StartTime.ToString("hh\\:mm")
                                                    </strong>

                                                    <span>
                                                        to @booking.EndTime.ToString("hh\\:mm")
                                                    </span>

                                                </div>

                                            </div>

                                        </td>


                                        <!-- STATUS -->

                                        <td>

                                            @switch (booking.Status)
                                            {
                                                case BookingStatus.Pending:

                                                    <span class="status-badge status-pending">

                                                        <span class="status-dot"></span>

                                                        Pending

                                                    </span>

                                                    break;


                                                case BookingStatus.Confirmed:

                                                    <span class="status-badge status-confirmed">

                                                        <span class="status-dot"></span>

                                                        Confirmed

                                                    </span>

                                                    break;


                                                case BookingStatus.Completed:

                                                    <span class="status-badge status-completed">

                                                        <span class="status-dot"></span>

                                                        Completed

                                                    </span>

                                                    break;


                                                case BookingStatus.Cancelled:

                                                    <span class="status-badge status-cancelled">

                                                        <span class="status-dot"></span>

                                                        Cancelled

                                                    </span>

                                                    break;


                                                default:

                                                    <span class="status-badge status-default">

                                                        <span class="status-dot"></span>

                                                        @booking.Status

                                                    </span>

                                                    break;
                                            }

                                        </td>


                                        <!-- ACTIONS -->

                                        <td class="text-end">

                                            <div class="booking-actions">


                                                <!-- DETAILS -->

                                                <a asp-controller="Receptionist"
                                                   asp-action="BookingDetails"
                                                   asp-route-id="@booking.Id"
                                                   class="table-action-btn details-btn"
                                                   title="View Booking Details">

                                                    <i class="fa-solid fa-eye"></i>

                                                </a>


                                                <!-- PENDING -->
                                                @if (booking.Status == BookingStatus.Pending)
                                                {
                                                    <form asp-controller="Receptionist"
                                                          asp-action="ConfirmBooking"
                                                          method="post">

                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden"
                                                               name="id"
                                                               value="@booking.Id" />


                                                        <button type="submit"
                                                                class="table-action-btn confirm-btn"
                                                                title="Confirm Booking">

                                                            <i class="fa-solid fa-check"></i>

                                                        </button>

                                                    </form>


                                                    <form asp-controller="Receptionist"
                                                          asp-action="CancelBooking"
                                                          method="post"
                                                          onsubmit="return confirm('Are you sure you want to cancel this booking?');">

                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden"
                                                               name="id"
                                                               value="@booking.Id" />


                                                        <button type="submit"
                                                                class="table-action-btn cancel-btn"
                                                                title="Cancel Booking">

                                                            <i class="fa-solid fa-xmark"></i>

                                                        </button>

                                                    </form>
                                                }


                                                <!-- CONFIRMED -->
                                                @if (booking.Status == BookingStatus.Confirmed)
                                                {
                                                    <form asp-controller="Receptionist"
                                                          asp-action="CompleteBooking"
                                                          method="post">

                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden"
                                                               name="id"
                                                               value="@booking.Id" />


                                                        <button type="submit"
                                                                class="table-action-btn complete-btn"
                                                                title="Complete Booking">

                                                            <i class="fa-solid fa-check-double"></i>

                                                        </button>

                                                    </form>


                                                    <form asp-controller="Receptionist"
                                                          asp-action="CancelBooking"
                                                          method="post"
                                                          onsubmit="return confirm('Are you sure you want to cancel this confirmed booking?');">

                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden"
                                                               name="id"
                                                               value="@booking.Id" />


                                                        <button type="submit"
                                                                class="table-action-btn cancel-btn"
                                                                title="Cancel Booking">

                                                            <i class="fa-solid fa-xmark"></i>

                                                        </button>

                                                    </form>
                                                }


                                                <!-- COMPLETED -->
                                                @if (booking.Status == BookingStatus.Completed)
                                                {
                                                    <span class="action-finished action-completed">

                                                        <i class="fa-solid fa-circle-check"></i>

                                                        Done

                                                    </span>
                                                }


                                                <!-- CANCELLED -->
                                                @if (booking.Status == BookingStatus.Cancelled)
                                                {
                                                    <span class="action-finished action-cancelled">

                                                        <i class="fa-solid fa-circle-xmark"></i>

                                                        Closed

                                                    </span>
                                                }

                                            </div>

                                        </td>

                                    </tr>

                                    slNo++;
                                }

                            </tbody>

                        </table>

                    </div>

                </div>


                <!-- =================================================
                     MOBILE CARDS
                     ================================================= -->

                <div class="mobile-bookings"
                     id="mobileBookingList">

                    @foreach (var booking in Model.Bookings)
                    {
                        <article class="mobile-booking-card"
                                 data-status="@booking.Status"
                                 data-date="@booking.BookingDate.ToString("yyyy-MM-dd")">

                            <div class="mobile-booking-top">

                                <div>

                                    <span class="mobile-label">
                                        CONSULTATION
                                    </span>

                                    <h3>
                                        @(booking.Service?.Name ?? "N/A")
                                    </h3>

                                </div>


                                @switch (booking.Status)
                                {
                                    case BookingStatus.Pending:

                                        <span class="status-badge status-pending">

                                            <span class="status-dot"></span>

                                            Pending

                                        </span>

                                        break;


                                    case BookingStatus.Confirmed:

                                        <span class="status-badge status-confirmed">

                                            <span class="status-dot"></span>

                                            Confirmed

                                        </span>

                                        break;


                                    case BookingStatus.Completed:

                                        <span class="status-badge status-completed">

                                            <span class="status-dot"></span>

                                            Completed

                                        </span>

                                        break;


                                    case BookingStatus.Cancelled:

                                        <span class="status-badge status-cancelled">

                                            <span class="status-dot"></span>

                                            Cancelled

                                        </span>

                                        break;
                                }

                            </div>


                            <div class="mobile-details-grid">

                                <div>

                                    <i class="fa-solid fa-user"></i>

                                    <div>

                                        <span>
                                            Customer
                                        </span>

                                        <strong>
                                            @(booking.Customer?.FullName ?? "N/A")
                                        </strong>

                                    </div>

                                </div>


                                <div>

                                    <i class="fa-solid fa-star"></i>

                                    <div>

                                        <span>
                                            Astrologer
                                        </span>

                                        <strong>
                                            @(booking.Astrologer?.FullName ?? "N/A")
                                        </strong>

                                    </div>

                                </div>


                                <div>

                                    <i class="fa-regular fa-calendar"></i>

                                    <div>

                                        <span>
                                            Date
                                        </span>

                                        <strong>
                                            @booking.BookingDate.ToString("dd MMM yyyy")
                                        </strong>

                                    </div>

                                </div>


                                <div>

                                    <i class="fa-regular fa-clock"></i>

                                    <div>

                                        <span>
                                            Time
                                        </span>

                                        <strong>
                                            @booking.StartTime.ToString("hh\\:mm")
                                            -
                                            @booking.EndTime.ToString("hh\\:mm")
                                        </strong>

                                    </div>

                                </div>

                            </div>


                            <div class="mobile-actions">

                                <a asp-controller="Receptionist"
                                   asp-action="BookingDetails"
                                   asp-route-id="@booking.Id"
                                   class="mobile-details-btn">

                                    <i class="fa-solid fa-eye"></i>

                                    View Details

                                </a>


                                @if (booking.Status == BookingStatus.Pending)
                                {
                                    <form asp-controller="Receptionist"
                                          asp-action="ConfirmBooking"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@booking.Id" />


                                        <button type="submit"
                                                class="mobile-status-btn mobile-confirm-btn">

                                            <i class="fa-solid fa-check"></i>

                                            Confirm

                                        </button>

                                    </form>


                                    <form asp-controller="Receptionist"
                                          asp-action="CancelBooking"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to cancel this booking?');">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@booking.Id" />


                                        <button type="submit"
                                                class="mobile-status-btn mobile-cancel-btn">

                                            <i class="fa-solid fa-xmark"></i>

                                            Cancel

                                        </button>

                                    </form>
                                }


                                @if (booking.Status == BookingStatus.Confirmed)
                                {
                                    <form asp-controller="Receptionist"
                                          asp-action="CompleteBooking"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@booking.Id" />


                                        <button type="submit"
                                                class="mobile-status-btn mobile-complete-btn">

                                            <i class="fa-solid fa-check-double"></i>

                                            Complete

                                        </button>

                                    </form>


                                    <form asp-controller="Receptionist"
                                          asp-action="CancelBooking"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to cancel this confirmed booking?');">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@booking.Id" />


                                        <button type="submit"
                                                class="mobile-status-btn mobile-cancel-btn">

                                            <i class="fa-solid fa-xmark"></i>

                                            Cancel

                                        </button>

                                    </form>
                                }

                            </div>

                        </article>
                    }

                </div>


                <!-- FILTER EMPTY STATE -->

                <div id="filterEmptyState"
                     class="filter-empty-state"
                     style="display:none;">

                    <div class="empty-icon">

                        <i class="fa-solid fa-magnifying-glass"></i>

                    </div>

                    <span>
                        NO MATCHES
                    </span>

                    <h3>
                        No matching bookings.
                    </h3>

                    <p>
                        Try changing your search, status or date filter.
                    </p>


                    <button type="button"
                            id="emptyClearFilters"
                            class="empty-clear-btn">

                        Clear Filters

                    </button>

                </div>
            }
            else
            {
                <!-- =================================================
                     DATABASE EMPTY STATE
                     ================================================= -->

                <div class="empty-state">

                    <div class="empty-icon">

                        <i class="fa-solid fa-calendar-xmark"></i>

                    </div>

                    <span>
                        APPOINTMENT RECORDS
                    </span>

                    <h3>
                        No bookings found.
                    </h3>

                    <p>
                        There are currently no customer appointments
                        available.
                    </p>


                    <a asp-controller="Booking"
                       asp-action="Create"
                       class="btn empty-booking-btn">

                        <i class="fa-solid fa-calendar-plus"></i>

                        Create First Booking

                    </a>

                </div>
            }

        </section>


        <!-- =====================================================
             FOOTER
             ===================================================== -->
        @if (Model.Bookings != null && Model.Bookings.Any())
        {
            <div class="booking-footer">

                <div>

                    <div class="footer-icon">

                        <i class="fa-solid fa-headset"></i>

                    </div>

                    <div>

                        <span>
                            RECEPTION WORKFLOW
                        </span>

                        <h3>
                            Keep the appointment schedule organised.
                        </h3>

                        <p>
                            Review pending bookings and keep consultation
                            statuses up to date.
                        </p>

                    </div>

                </div>


                <a asp-controller="Receptionist"
                   asp-action="Calendar"
                   class="calendar-btn">

                    <i class="fa-regular fa-calendar"></i>

                    Booking Calendar

                </a>

            </div>
        }

    </div>

</section>


<style>

    /* =====================================================
           PAGE
           ===================================================== */

    .booking-management-page {
        min-height: 100vh;
        padding: 45px 0 80px;
        background: #f8f5ec;
    }


    /* =====================================================
           HEADER
           ===================================================== */

    .page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 30px;
        margin-bottom: 28px;
    }

    .section-label {
        display: block;
        margin-bottom: 8px;
        color: #987918;
        font-size: .63rem;
        font-weight: 800;
        letter-spacing: .17em;
    }

    .page-header h1 {
        margin-bottom: 8px;
        color: #181710;
        font-family: 'DM Serif Display', serif;
        font-size: clamp(2.5rem, 4vw, 3.8rem);
        font-weight: 400;
        line-height: 1;
    }

    .page-header p {
        max-width: 620px;
        margin: 0;
        color: #817b70;
        font-size: .8rem;
        line-height: 1.7;
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 9px;
        flex-shrink: 0;
    }

    .dashboard-btn,
    .new-booking-btn {
        min-height: 43px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 9px 16px;
        font-size: .68rem;
        font-weight: 700;
    }

    .dashboard-btn {
        border: 1px solid #ccc2af;
        background: transparent;
        color: #181710;
    }

        .dashboard-btn:hover {
            border-color: #181710;
            background: #181710;
            color: white;
        }

    .new-booking-btn {
        border: 1px solid #181710;
        background: #181710;
        color: white;
    }

        .new-booking-btn:hover {
            border-color: #e1bf4a;
            background: #e1bf4a;
            color: #181710;
        }


    /* =====================================================
           SUMMARY
           ===================================================== */

    .booking-summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
        margin-bottom: 18px;
        padding: 23px 27px;
        border-radius: 18px;
        background: #181710;
        color: white;
    }

    .summary-intro {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .summary-main-icon {
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 50%;
        background: #e1bf4a;
        color: #181710;
        font-size: .75rem;
    }

    .summary-intro span {
        display: block;
        margin-bottom: 2px;
        color: #e1bf4a;
        font-size: .5rem;
        font-weight: 800;
        letter-spacing: .13em;
    }

    .summary-intro h2 {
        margin: 0;
        font-family: 'DM Serif Display', serif;
        font-size: 1.5rem;
        font-weight: 400;
    }

    .summary-stats {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .summary-stat {
        min-width: 58px;
        text-align: center;
    }

        .summary-stat span,
        .summary-stat strong {
            display: block;
        }

        .summary-stat span {
            margin-bottom: 2px;
            color: rgba(255,255,255,.37);
            font-size: .47rem;
            font-weight: 800;
            letter-spacing: .08em;
        }

        .summary-stat strong {
            color: #e1bf4a;
            font-family: 'DM Serif Display', serif;
            font-size: 1.55rem;
            font-weight: 400;
            line-height: 1;
        }

    .summary-divider {
        width: 1px;
        height: 31px;
        background: rgba(255,255,255,.12);
    }


