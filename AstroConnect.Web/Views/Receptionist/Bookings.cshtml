@section Scripts
{
    <script>

        $(document).ready(function () {

            // =================================================
            // FILTER BOOKINGS
            // =================================================

            function filterBookings() {

                let search =
                    $("#bookingSearch")
                        .val()
                        .toLowerCase()
                        .trim();


                let status =
                    $("#statusFilter")
                        .val();


                let date =
                    $("#dateFilter")
                        .val();


                let visibleCount = 0;


                // =================================================
                // DESKTOP ROWS
                // =================================================

                $("#bookingTable tbody tr").each(function () {

                    let row = $(this);

                    let text =
                        row.text()
                           .toLowerCase();

                    let rowStatus =
                        row.attr("data-status");

                    let rowDate =
                        row.attr("data-date");

                    let show = true;


                    if (search !== "" &&
                        !text.includes(search)) {

                        show = false;

                    }


                    if (status !== "" &&
                        rowStatus !== status) {

                        show = false;

                    }


                    if (date !== "" &&
                        rowDate !== date) {

                        show = false;

                    }


                    if (show) {

                        row.show();

                        visibleCount++;

                    }
                    else {

                        row.hide();

                    }

                });


                // =================================================
                // MOBILE CARDS
                // =================================================

                $("#mobileBookingList .mobile-booking-card").each(function () {

                    let card = $(this);

                    let text =
                        card.text()
                            .toLowerCase();

                    let cardStatus =
                        card.attr("data-status");

                    let cardDate =
                        card.attr("data-date");

                    let show = true;


                    if (search !== "" &&
                        !text.includes(search)) {

                        show = false;

                    }


                    if (status !== "" &&
                        cardStatus !== status) {

                        show = false;

                    }


                    if (date !== "" &&
                        cardDate !== date) {

                        show = false;

                    }


                    if (show) {

                        card.show();

                    }
                    else {

                        card.hide();

                    }

                });


                // =================================================
                // COUNT / EMPTY STATE
                // =================================================

                $("#visibleBookingCount").text(visibleCount);


                if (visibleCount === 0) {

                    $(".desktop-bookings").hide();

                    $(".mobile-bookings").hide();

                    $("#filterEmptyState").show();

                }
                else {

                    $("#filterEmptyState").hide();


                    if ($(window).width() <= 991) {

                        $(".mobile-bookings").show();
                        $(".desktop-bookings").hide();

                    }
                    else {

                        $(".desktop-bookings").show();
                        $(".mobile-bookings").hide();

                    }

                }

            }


            // =================================================
            // SEARCH
            // =================================================

            $("#bookingSearch").on("keyup", function () {

                filterBookings();

            });


            // =================================================
            // STATUS
            // =================================================

            $("#statusFilter").on("change", function () {

                filterBookings();

            });


            // =================================================
            // DATE
            // =================================================

            $("#dateFilter").on("change", function () {

                filterBookings();

            });


            // =================================================
            // CLEAR
            // =================================================

            function clearFilters() {

                $("#bookingSearch").val("");

                $("#statusFilter").val("");

                $("#dateFilter").val("");

                filterBookings();

            }


            $("#clearFilters").on("click", function () {

                clearFilters();

            });


            $("#emptyClearFilters").on("click", function () {

                clearFilters();

            });


            // =================================================
            // WINDOW RESIZE
            // =================================================

            $(window).on("resize", function () {

                filterBookings();

            });

        });

    </script>
