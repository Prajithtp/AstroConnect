@model AstroConnect.Web.ViewModels.Receptionist.ReceptionistDashboardViewModel

@{
    ViewData["Title"] = "Receptionist Dashboard";
}

<section class="receptionist-dashboard">

    <div class="container">

        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="dashboard-header">

            <div>

                <span class="section-label">
                    RECEPTION DESK
                </span>

                <h1>
                    Receptionist Dashboard
                </h1>

                <p>
                    Manage today's appointments, customer bookings
                    and daily consultation activity.
                </p>

            </div>

            <div class="role-badge">

                <div class="role-icon">
                    <i class="fa-solid fa-headset"></i>
                </div>

                <div>
                    <span>LOGGED IN AS</span>
                    <strong>Receptionist</strong>
                </div>

            </div>

        </div>


        <!-- =====================================================
             STATISTICS
             ===================================================== -->

        <div class="row g-3 mb-4">

            <!-- TODAY -->

            <div class="col-md-6 col-xl-3">

                <div class="stat-card">

                    <div class="stat-top">

                        <div class="stat-icon">
                            <i class="fa-solid fa-calendar-day"></i>
                        </div>

                        <span class="stat-label">
                            TODAY
                        </span>

                    </div>

                    <h2>
                        @Model.TodayBookings
                    </h2>

                    <h3>
                        Today's Appointments
                    </h3>

                    <p>
                        Consultations scheduled for today.
                    </p>

                </div>

            </div>


            <!-- PENDING -->

            <div class="col-md-6 col-xl-3">

                <div class="stat-card">

                    <div class="stat-top">

                        <div class="stat-icon stat-icon-gold">
                            <i class="fa-regular fa-clock"></i>
                        </div>

                        <span class="stat-label">
                            PENDING
                        </span>

                    </div>

                    <h2>
                        @Model.PendingBookings
                    </h2>

                    <h3>
                        Awaiting Review
                    </h3>

                    <p>
                        Bookings waiting for confirmation.
                    </p>

                </div>

            </div>


            <!-- CONFIRMED -->

            <div class="col-md-6 col-xl-3">

                <div class="stat-card">

                    <div class="stat-top">

                        <div class="stat-icon stat-icon-green">
                            <i class="fa-solid fa-circle-check"></i>
                        </div>

                        <span class="stat-label">
                            CONFIRMED
                        </span>

                    </div>

                    <h2>
                        @Model.ConfirmedBookings
                    </h2>

                    <h3>
                        Confirmed Bookings
                    </h3>

                    <p>
                        Appointments ready for consultation.
                    </p>

                </div>

            </div>


            <!-- COMPLETED -->

            <div class="col-md-6 col-xl-3">

                <div class="stat-card">

                    <div class="stat-top">

                        <div class="stat-icon stat-icon-dark">
                            <i class="fa-solid fa-check-double"></i>
                        </div>

                        <span class="stat-label">
                            COMPLETED
                        </span>

                    </div>

                    <h2>
                        @Model.CompletedBookings
                    </h2>

                    <h3>
                        Completed
                    </h3>

                    <p>
                        Successfully completed consultations.
                    </p>

                </div>

            </div>

        </div>


        <!-- =====================================================
             QUICK ACTIONS
             ===================================================== -->

        <div class="section-heading">

            <div>

                <span class="section-label">
                    QUICK ACTIONS
                </span>

                <h2>
                    What would you like to do?
                </h2>

            </div>

        </div>


        <div class="row g-3 mb-4">

            <!-- BOOKINGS -->

            <div class="col-md-4">

                <a asp-controller="Receptionist"
                   asp-action="Bookings"
                   class="action-card">

                    <div class="action-icon">
                        <i class="fa-solid fa-calendar-days"></i>
                    </div>

                    <div class="action-content">

                        <span>
                            APPOINTMENTS
                        </span>

                        <h3>
                            Manage Bookings
                        </h3>

                        <p>
                            View, filter and manage all customer appointments.
                        </p>

                    </div>

                    <div class="action-arrow">
                        <i class="fa-solid fa-arrow-right"></i>
                    </div>

                </a>

            </div>


            <!-- NEW BOOKING -->

            <div class="col-md-4">

                <a asp-controller="Booking"
                   asp-action="Create"
                   class="action-card action-card-dark">

                    <div class="action-icon">
                        <i class="fa-solid fa-calendar-plus"></i>
                    </div>

                    <div class="action-content">

                        <span>
                            CREATE
                        </span>

                        <h3>
                            New Booking
                        </h3>

                        <p>
                            Schedule a new consultation for a customer.
                        </p>

                    </div>

                    <div class="action-arrow">
                        <i class="fa-solid fa-arrow-right"></i>
                    </div>

                </a>

            </div>


            <!-- CUSTOMERS -->

            <div class="col-md-4">

                <a asp-controller="Customer"
                   asp-action="Index"
                   class="action-card">

                    <div class="action-icon">
                        <i class="fa-solid fa-users"></i>
                    </div>

                    <div class="action-content">

                        <span>
                            CUSTOMERS
                        </span>

                        <h3>
                            Customer Records
                        </h3>

                        <p>
                            View and manage registered customer information.
                        </p>

                    </div>

                    <div class="action-arrow">
                        <i class="fa-solid fa-arrow-right"></i>
                    </div>

                </a>

            </div>

        </div>


        <!-- =====================================================
             TODAY'S APPOINTMENTS
             ===================================================== -->

        <section class="appointments-card">

            <div class="appointments-header">

                <div class="appointments-heading">

                    <div class="heading-icon">
                        <i class="fa-solid fa-calendar-day"></i>
                    </div>

                    <div>

                        <span>
                            TODAY'S SCHEDULE
                        </span>

                        <h2>
                            Today's Appointments
                        </h2>

                        <p>
                            Review and manage consultations scheduled for today.
                        </p>

                    </div>

                </div>


                <div class="appointment-count">

                    <strong>
                        @Model.TodayBookings
                    </strong>

                    <span>
                        @(Model.TodayBookings == 1 ? "appointment" : "appointments")
                    </span>

                </div>

            </div>


            @if (Model.TodayAppointmentList != null &&
                        Model.TodayAppointmentList.Any())
            {
                <div class="table-responsive">

                    <table class="table appointment-table align-middle">

                        <thead>

                            <tr>
                                <th>Customer</th>
                                <th>Astrologer</th>
                                <th>Service</th>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Status</th>

                                <th class="text-end">
                                    Action
                                </th>
                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var booking in Model.TodayAppointmentList)
                            {
                                <tr>

                                    <!-- CUSTOMER -->

                                    <td>

                                        <div class="customer-cell">

                                            <div class="customer-avatar">
                                                <i class="fa-solid fa-user"></i>
                                            </div>

                                            <div>

                                                <span>
                                                    CUSTOMER
                                                </span>

                                                <strong>
                                                    @(booking.Customer?.FullName ?? "Customer")
                                                </strong>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- ASTROLOGER -->

                                    <td>

                                        <div class="simple-cell">

                                            <i class="fa-solid fa-star"></i>

                                            <span>
                                                @(booking.Astrologer?.FullName ?? "Astrologer")
                                            </span>

                                        </div>

                                    </td>


                                    <!-- SERVICE -->

                                    <td>

                                        <div class="simple-cell">

                                            <i class="fa-solid fa-moon"></i>

                                            <span>
                                                @(booking.Service?.Name ?? "Consultation")
                                            </span>

                                        </div>

                                    </td>


                                    <!-- DATE -->

                                    <td>

                                        <div class="date-cell">

                                            <i class="fa-regular fa-calendar"></i>

                                            @booking.BookingDate.ToString("dd MMM yyyy")

                                        </div>

                                    </td>


                                    <!-- TIME -->

                                    <td>

                                        <div class="time-cell">

                                            <i class="fa-regular fa-clock"></i>

                                            <div>

                                                <strong>
                                                    @booking.StartTime.ToString("hh:mm tt")
                                                </strong>

                                                <span>
                                                    @booking.EndTime.ToString("hh:mm tt")
                                                </span>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        @if (booking.Status ==
                                                                        AstroConnect.Domain.Enums.BookingStatus.Pending)
                                        {
                                            <span class="status-badge status-pending">

                                                <span class="status-dot"></span>

                                                Pending

                                            </span>
                                        }
                                        else if (booking.Status ==
                                        AstroConnect.Domain.Enums.BookingStatus.Confirmed)
                                        {
                                            <span class="status-badge status-confirmed">

                                                <span class="status-dot"></span>

                                                Confirmed

                                            </span>
                                        }
                                        else if (booking.Status ==
                                        AstroConnect.Domain.Enums.BookingStatus.Completed)
                                        {
                                            <span class="status-badge status-completed">

                                                <span class="status-dot"></span>

                                                Completed

                                            </span>
                                        }
                                        else if (booking.Status ==
                                        AstroConnect.Domain.Enums.BookingStatus.Cancelled)
                                        {
                                            <span class="status-badge status-cancelled">

                                                <span class="status-dot"></span>

                                                Cancelled

                                            </span>
                                        }

                                    </td>


                                    <!-- ACTIONS -->

                                    <td class="text-end">

                                        <div class="booking-actions">


                                            <!-- CONFIRM -->
                                            @if (booking.Status ==
                                                                                AstroConnect.Domain.Enums.BookingStatus.Pending)
                                            {
                                                <form asp-controller="Receptionist"
                                                      asp-action="ConfirmBooking"
                                                      asp-route-id="@booking.Id"
                                                      method="post">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="table-action-btn confirm-btn"
                                                            title="Confirm Booking">

                                                        <i class="fa-solid fa-check"></i>

                                                    </button>

                                                </form>
                                            }


                                            <!-- COMPLETE -->
                                            @if (booking.Status ==
                                                                                AstroConnect.Domain.Enums.BookingStatus.Confirmed)
                                            {
                                                <form asp-controller="Receptionist"
                                                      asp-action="CompleteBooking"
                                                      asp-route-id="@booking.Id"
                                                      method="post">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="table-action-btn complete-btn"
                                                            title="Complete Booking">

                                                        <i class="fa-solid fa-check-double"></i>

                                                    </button>

                                                </form>
                                            }


                                            <!-- CANCEL -->
                                            @if (booking.Status ==
                                                                                AstroConnect.Domain.Enums.BookingStatus.Pending ||
                                                                                booking.Status ==
                                                                                AstroConnect.Domain.Enums.BookingStatus.Confirmed)
                                            {
                                                <form asp-controller="Receptionist"
                                                      asp-action="CancelBooking"
                                                      asp-route-id="@booking.Id"
                                                      method="post"
                                                      onsubmit="return confirm('Are you sure you want to cancel this booking?');">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="table-action-btn cancel-btn"
                                                            title="Cancel Booking">

                                                        <i class="fa-solid fa-xmark"></i>

                                                    </button>

                                                </form>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="empty-state">

                    <div class="empty-icon">
                        <i class="fa-regular fa-calendar-check"></i>
                    </div>

                    <span>
                        TODAY'S SCHEDULE
                    </span>

                    <h3>
                        No appointments today.
                    </h3>

                    <p>
                        There are currently no consultations scheduled
                        for today.
                    </p>

                    <a asp-controller="Booking"
                       asp-action="Create"
                       class="btn empty-booking-btn">

                        <i class="fa-solid fa-calendar-plus"></i>

                        Create Booking

                    </a>

                </div>
            }

        </section>


        <!-- =====================================================
             BOTTOM SECTION
             ===================================================== -->

        <div class="row g-4 mt-1">


            <!-- RECEPTIONIST TASKS -->

            <div class="col-lg-8">

                <section class="tasks-card h-100">

                    <div class="card-title-area">

                        <div class="title-icon">
                            <i class="fa-solid fa-headset"></i>
                        </div>

                        <div>

                            <span>
                                DAILY WORKFLOW
                            </span>

                            <h2>
                                Receptionist Tasks
                            </h2>

                            <p>
                                Keep appointments organised and customers informed.
                            </p>

                        </div>

                    </div>


                    <div class="task-grid">

                        <a asp-controller="Receptionist"
                           asp-action="Bookings"
                           class="task-item">

                            <div class="task-number">
                                01
                            </div>

                            <div>

                                <span>
                                    SCHEDULE
                                </span>

                                <strong>
                                    Check today's appointments
                                </strong>

                            </div>

                            <i class="fa-solid fa-arrow-right"></i>

                        </a>


                        <a asp-controller="Receptionist"
                           asp-action="Bookings"
                           class="task-item">

                            <div class="task-number">
                                02
                            </div>

                            <div>

                                <span>
                                    REVIEW
                                </span>

                                <strong>
                                    Review pending bookings
                                </strong>

                            </div>

                            <i class="fa-solid fa-arrow-right"></i>

                        </a>


                        <a asp-controller="Receptionist"
                           asp-action="Bookings"
                           class="task-item">

                            <div class="task-number">
                                03
                            </div>

                            <div>

                                <span>
                                    CONFIRM
                                </span>

                                <strong>
                                    Confirm customer bookings
                                </strong>

                            </div>

                            <i class="fa-solid fa-arrow-right"></i>

                        </a>


                        <a asp-controller="Receptionist"
                           asp-action="Bookings"
                           class="task-item">

                            <div class="task-number">
                                04
                            </div>

                            <div>

                                <span>
                                    COMPLETE
                                </span>

                                <strong>
                                    Mark appointments completed
                                </strong>

                            </div>

                            <i class="fa-solid fa-arrow-right"></i>

                        </a>

                    </div>

                </section>

            </div>


            <!-- QUICK LINKS -->

            <div class="col-lg-4">

                <section class="links-card h-100">

                    <div class="links-header">

                        <span>
                            NAVIGATION
                        </span>

                        <h2>
                            Quick Links
                        </h2>

                    </div>


                    <div class="quick-link-list">

                        <a asp-controller="Receptionist"
                           asp-action="Bookings"
                           class="quick-link">

                            <div>

                                <span class="link-icon">
                                    <i class="fa-solid fa-calendar-days"></i>
                                </span>

                                <span>
                                    All Bookings
                                </span>

                            </div>

                            <i class="fa-solid fa-arrow-right"></i>

                        </a>


                        <a asp-controller="Receptionist"
                           asp-action="Calendar"
                           class="quick-link">

                            <div>

                                <span class="link-icon">
                                    <i class="fa-regular fa-calendar"></i>
                                </span>

                                <span>
                                    Booking Calendar
                                </span>

                            </div>

                            <i class="fa-solid fa-arrow-right"></i>

                        </a>


                        <a asp-controller="Booking"
                           asp-action="Create"
                           class="quick-link">

                            <div>

                                <span class="link-icon">
                                    <i class="fa-solid fa-calendar-plus"></i>
                                </span>

                                <span>
                                    New Booking
                                </span>

                            </div>

                            <i class="fa-solid fa-arrow-right"></i>

                        </a>


                        <a asp-controller="Customer"
                           asp-action="Index"
                           class="quick-link">

                            <div>

                                <span class="link-icon">
                                    <i class="fa-solid fa-users"></i>
                                </span>

                                <span>
                                    Customers
                                </span>

                            </div>

                            <i class="fa-solid fa-arrow-right"></i>

                        </a>


                        <a asp-controller="Astrologer"
                           asp-action="Index"
                           class="quick-link">

                            <div>

                                <span class="link-icon">
                                    <i class="fa-solid fa-star"></i>
                                </span>

                                <span>
                                    Astrologers
                                </span>

                            </div>

                            <i class="fa-solid fa-arrow-right"></i>

                        </a>


                        <a asp-controller="Service"
                           asp-action="Index"
                           class="quick-link">

                            <div>

                                <span class="link-icon">
                                    <i class="fa-solid fa-list-check"></i>
                                </span>

                                <span>
                                    Services
                                </span>

                            </div>

                            <i class="fa-solid fa-arrow-right"></i>

                        </a>

                    </div>

                </section>

            </div>

        </div>

    </div>

</section>


<style>

    /* =====================================================
           PAGE
           ===================================================== */

    .receptionist-dashboard {
        min-height: 100vh;
        padding: 45px 0 80px;
        background: #f8f5ec;
    }


    /* =====================================================
           HEADER
           ===================================================== */

    .dashboard-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 30px;
        margin-bottom: 32px;
    }

    .section-label {
        display: block;
        margin-bottom: 8px;
        color: #987918;
        font-size: .63rem;
        font-weight: 800;
        letter-spacing: .17em;
    }

    .dashboard-header h1 {
        margin-bottom: 9px;
        color: #181710;
        font-family: 'DM Serif Display', serif;
        font-size: clamp(2.5rem, 4vw, 3.8rem);
        font-weight: 400;
        line-height: 1;
    }

    .dashboard-header p {
        max-width: 640px;
        margin: 0;
        color: #817b70;
        font-size: .8rem;
        line-height: 1.7;
    }

    .role-badge {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 175px;
        padding: 11px 14px;
        border: 1px solid #ddd3c0;
        border-radius: 13px;
        background: #fffdf8;
    }

    .role-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 50%;
        background: #181710;
        color: #e1bf4a;
        font-size: .72rem;
    }

    .role-badge span,
    .role-badge strong {
        display: block;
    }

    .role-badge span {
        margin-bottom: 1px;
        color: #9b9386;
        font-size: .48rem;
        font-weight: 800;
        letter-spacing: .09em;
    }

    .role-badge strong {
        color: #302c25;
        font-size: .7rem;
    }


    /* =====================================================
           STATISTICS
           ===================================================== */

    .stat-card {
        height: 100%;
        padding: 22px;
        border: 1px solid #e2dacb;
        border-radius: 17px;
        background: #fffdf8;
        transition: all .22s ease;
    }

        .stat-card:hover {
            transform: translateY(-3px);
            border-color: #d4bd67;
            box-shadow: 0 12px 28px rgba(40, 34, 22, .05);
        }

    .stat-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
    }

    .stat-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #181710;
        color: #e1bf4a;
        font-size: .72rem;
    }

    .stat-icon-gold {
        background: #fff0ad;
        color: #725c12;
    }

    .stat-icon-green {
        background: #e0ecdf;
        color: #53745a;
    }

    .stat-icon-dark {
        background: #e7e3db;
        color: #4f4940;
    }

    .stat-label {
        color: #aaa294;
        font-size: .51rem;
        font-weight: 800;
        letter-spacing: .12em;
    }

    .stat-card h2 {
        margin-bottom: 3px;
        color: #181710;
        font-family: 'DM Serif Display', serif;
        font-size: 2.35rem;
        font-weight: 400;
        line-height: 1;
    }

    .stat-card h3 {
        margin-bottom: 6px;
        color: #403b32;
        font-size: .72rem;
        font-weight: 800;
    }

    .stat-card p {
        margin: 0;
        color: #928a7e;
        font-size: .62rem;
        line-height: 1.5;
    }


    /* =====================================================
           SECTION HEADING
           ===================================================== */

    .section-heading {
        margin: 32px 0 16px;
    }

        .section-heading h2 {
            margin: 0;
            color: #181710;
            font-family: 'DM Serif Display', serif;
            font-size: 1.8rem;
            font-weight: 400;
        }


    /* =====================================================
           QUICK ACTIONS
           ===================================================== */

    .action-card {
        position: relative;
        height: 100%;
        display: flex;
        align-items: center;
        gap: 14px;
        overflow: hidden;
        padding: 22px;
        border: 1px solid #e1d9ca;
        border-radius: 17px;
        background: #fffdf8;
        color: #29261f;
        text-decoration: none;
        transition: all .22s ease;
    }

        .action-card:hover {
            transform: translateY(-3px);
            border-color: #caae4b;
            color: #29261f;
            box-shadow: 0 12px 28px rgba(40,34,22,.055);
        }

    .action-card-dark {
        border-color: #181710;
        background: #181710;
        color: white;
    }

        .action-card-dark:hover {
            border-color: #181710;
            color: white;
        }

    .action-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 50%;
        background: #fff0ad;
        color: #6b5611;
        font-size: .8rem;
    }

    .action-card-dark .action-icon {
        background: #e1bf4a;
        color: #181710;
    }

    .action-content {
        flex: 1;
    }

        .action-content > span {
            display: block;
            margin-bottom: 3px;
            color: #a08f50;
            font-size: .49rem;
            font-weight: 800;
            letter-spacing: .12em;
        }

    .action-card-dark .action-content > span {
        color: #e1bf4a;
    }

    .action-content h3 {
        margin-bottom: 5px;
        font-family: 'DM Serif Display', serif;
        font-size: 1.25rem;
        font-weight: 400;
    }

    .action-content p {
        margin: 0;
        color: #8d867a;
        font-size: .62rem;
        line-height: 1.55;
    }

    .action-card-dark .action-content p {
        color: rgba(255,255,255,.45);
    }

    .action-arrow {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border: 1px solid #ded5c5;
        border-radius: 50%;
        color: #7c7467;
        font-size: .57rem;
        transition: all .2s ease;
    }

