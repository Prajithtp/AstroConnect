@model AstroConnect.Domain.Entities.Booking
@using AstroConnect.Domain.Enums

@{
    ViewData["Title"] = "Booking Details";
}

<section class="booking-details-page">

    <div class="container">

        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="page-header">

            <div>

                <span class="section-label">
                    RECEPTION DESK
                </span>

                <h1>
                    Booking Details
                </h1>

                <p>
                    Review complete appointment, customer and
                    consultation information.
                </p>

            </div>

            <a asp-controller="Receptionist"
               asp-action="Bookings"
               class="back-btn">

                <i class="fa-solid fa-arrow-left"></i>

                Back to Bookings

            </a>

        </div>


        <!-- =====================================================
             BOOKING HERO
             ===================================================== -->

        <section class="booking-hero">

            <div class="hero-decoration hero-decoration-one"></div>
            <div class="hero-decoration hero-decoration-two"></div>

            <div class="hero-content">

                <div class="hero-icon">

                    <i class="fa-solid fa-calendar-check"></i>

                </div>

                <div>

                    <span class="hero-label">
                        APPOINTMENT RECORD
                    </span>

                    <h2>
                        Booking #@Model.Id
                    </h2>

                    <p>
                        @(Model.Service?.Name ?? "Consultation")
                        with
                        @(Model.Astrologer?.FullName ?? "Astrologer")
                    </p>

                </div>

            </div>


            <div class="hero-status">

                <span class="status-caption">
                    CURRENT STATUS
                </span>

                @switch (Model.Status)
                {
                    case BookingStatus.Pending:

                        <span class="status-badge status-pending">

                            <span class="status-dot"></span>

                            Pending

                        </span>

                        break;


                    case BookingStatus.Confirmed:

                        <span class="status-badge status-confirmed">

                            <span class="status-dot"></span>

                            Confirmed

                        </span>

                        break;


                    case BookingStatus.Completed:

                        <span class="status-badge status-completed">

                            <span class="status-dot"></span>

                            Completed

                        </span>

                        break;


                    case BookingStatus.Cancelled:

                        <span class="status-badge status-cancelled">

                            <span class="status-dot"></span>

                            Cancelled

                        </span>

                        break;


                    default:

                        <span class="status-badge status-default">

                            <span class="status-dot"></span>

                            @Model.Status

                        </span>

                        break;
                }

            </div>

        </section>


        <!-- =====================================================
             QUICK APPOINTMENT STRIP
             ===================================================== -->

        <div class="appointment-strip">

            <div class="strip-item">

                <div class="strip-icon">
                    <i class="fa-regular fa-calendar"></i>
                </div>

                <div>

                    <span>
                        APPOINTMENT DATE
                    </span>

                    <strong>
                        @Model.BookingDate.ToString("dd MMM yyyy")
                    </strong>

                </div>

            </div>


            <div class="strip-divider"></div>


            <div class="strip-item">

                <div class="strip-icon">
                    <i class="fa-regular fa-clock"></i>
                </div>

                <div>

                    <span>
                        START TIME
                    </span>

                    <strong>
                        @Model.StartTime.ToString("hh:mm tt")
                    </strong>

                </div>

            </div>


            <div class="strip-divider"></div>


            <div class="strip-item">

                <div class="strip-icon">
                    <i class="fa-solid fa-hourglass-half"></i>
                </div>

                <div>

                    <span>
                        END TIME
                    </span>

                    <strong>
                        @Model.EndTime.ToString("hh:mm tt")
                    </strong>

                </div>

            </div>


            <div class="strip-divider"></div>


            <div class="strip-item">

                <div class="strip-icon">
                    <i class="fa-solid fa-moon"></i>
                </div>

                <div>

                    <span>
                        SERVICE
                    </span>

                    <strong>
                        @(Model.Service?.Name ?? "N/A")
                    </strong>

                </div>

            </div>

        </div>


        <!-- =====================================================
             INFORMATION GRID
             ===================================================== -->

        <div class="row g-4">


            <!-- =================================================
                 CUSTOMER
                 ================================================= -->

            <div class="col-lg-6">

                <section class="detail-card h-100">

                    <div class="card-heading">

                        <div class="card-icon">

                            <i class="fa-solid fa-user"></i>

                        </div>

                        <div>

                            <span>
                                CUSTOMER
                            </span>

                            <h2>
                                Customer Information
                            </h2>

                            <p>
                                Contact and personal details.
                            </p>

                        </div>

                    </div>


                    <div class="detail-list">

                        <div class="detail-item">

                            <div class="detail-item-icon">
                                <i class="fa-solid fa-user"></i>
                            </div>

                            <div>

                                <span>
                                    FULL NAME
                                </span>

                                <strong>
                                    @(Model.Customer?.FullName ?? "N/A")
                                </strong>

                            </div>

                        </div>


                        <div class="detail-item">

                            <div class="detail-item-icon">
                                <i class="fa-regular fa-envelope"></i>
                            </div>

                            <div>

                                <span>
                                    EMAIL ADDRESS
                                </span>

                                <strong>
                                    @(Model.Customer?.Email ?? "N/A")
                                </strong>

                            </div>

                        </div>


                        <div class="detail-item">

                            <div class="detail-item-icon">
                                <i class="fa-solid fa-phone"></i>
                            </div>

                            <div>

                                <span>
                                    PHONE NUMBER
                                </span>

                                <strong>
                                    @(Model.Customer?.PhoneNumber ?? "N/A")
                                </strong>

                            </div>

                        </div>


                        <div class="detail-item">

                            <div class="detail-item-icon whatsapp-icon">
                                <i class="fa-brands fa-whatsapp"></i>
                            </div>

                            <div>

                                <span>
                                    WHATSAPP
                                </span>

                                <strong>
                                    @(string.IsNullOrWhiteSpace(Model.WhatsAppNumber)
                                                                        ? "N/A"
                                                                        : Model.WhatsAppNumber)
                                </strong>

                            </div>

                        </div>


                        <div class="detail-item">

                            <div class="detail-item-icon">
                                <i class="fa-solid fa-venus-mars"></i>
                            </div>

                            <div>

                                <span>
                                    GENDER
                                </span>

                                <strong>
                                    @(string.IsNullOrWhiteSpace(Model.Gender)
                                                                        ? "N/A"
                                                                        : Model.Gender)
                                </strong>

                            </div>

                        </div>

                    </div>

                </section>

            </div>


            <!-- =================================================
                 APPOINTMENT
                 ================================================= -->

            <div class="col-lg-6">

                <section class="detail-card h-100">

                    <div class="card-heading">

                        <div class="card-icon gold-icon">

                            <i class="fa-solid fa-calendar-day"></i>

                        </div>

                        <div>

                            <span>
                                CONSULTATION
                            </span>

                            <h2>
                                Appointment Information
                            </h2>

                            <p>
                                Consultation schedule and assignment.
                            </p>

                        </div>

                    </div>


                    <div class="detail-list">

                        <div class="detail-item">

                            <div class="detail-item-icon">
                                <i class="fa-solid fa-moon"></i>
                            </div>

                            <div>

                                <span>
                                    SERVICE
                                </span>

                                <strong>
                                    @(Model.Service?.Name ?? "N/A")
                                </strong>

                            </div>

                        </div>


                        <div class="detail-item">

                            <div class="detail-item-icon">
                                <i class="fa-solid fa-star"></i>
                            </div>

                            <div>

                                <span>
                                    ASTROLOGER
                                </span>

                                <strong>
                                    @(Model.Astrologer?.FullName ?? "N/A")
                                </strong>

                            </div>

                        </div>


                        <div class="detail-item">

                            <div class="detail-item-icon">
                                <i class="fa-regular fa-calendar"></i>
                            </div>

                            <div>

                                <span>
                                    BOOKING DATE
                                </span>

                                <strong>
                                    @Model.BookingDate.ToString("dd MMM yyyy")
                                </strong>

                            </div>

                        </div>


                        <div class="detail-item">

                            <div class="detail-item-icon">
                                <i class="fa-solid fa-play"></i>
                            </div>

                            <div>

                                <span>
                                    START TIME
                                </span>

                                <strong>
                                    @Model.StartTime.ToString("hh:mm tt")
                                </strong>

                            </div>

                        </div>


                        <div class="detail-item">

                            <div class="detail-item-icon">
                                <i class="fa-solid fa-stop"></i>
                            </div>

                            <div>

                                <span>
                                    END TIME
                                </span>

                                <strong>
                                    @Model.EndTime.ToString("hh:mm tt")
                                </strong>

                            </div>

                        </div>

                    </div>

                </section>

            </div>


            <!-- =================================================
                 BIRTH INFORMATION
                 ================================================= -->

            <div class="col-lg-6">

                <section class="detail-card h-100">

                    <div class="card-heading">

                        <div class="card-icon gold-icon">

                            <i class="fa-solid fa-star"></i>

                        </div>

                        <div>

                            <span>
                                BIRTH DETAILS
                            </span>

                            <h2>
                                Birth Information
                            </h2>

                            <p>
                                Details provided for the consultation.
                            </p>

                        </div>

                    </div>


                    <div class="birth-grid">

                        <div class="birth-item">

                            <div class="birth-icon">
                                <i class="fa-solid fa-cake-candles"></i>
                            </div>

                            <span>
                                BIRTH DATE
                            </span>

                            <strong>
                                @Model.BirthDate.ToString("dd MMM yyyy")
                            </strong>

                        </div>


                        <div class="birth-item">

                            <div class="birth-icon">
                                <i class="fa-regular fa-clock"></i>
                            </div>

                            <span>
                                BIRTH TIME
                            </span>

                            <strong>
                                @Model.BirthTime.ToString("hh:mm tt")
                            </strong>

                        </div>


                        <div class="birth-item birth-place-item">

                            <div class="birth-icon">
                                <i class="fa-solid fa-location-dot"></i>
                            </div>

                            <span>
                                BIRTH PLACE
                            </span>

                            <strong>
                                @(string.IsNullOrWhiteSpace(Model.BirthPlace)
                                                                ? "N/A"
                                                                : Model.BirthPlace)
                            </strong>

                        </div>

                    </div>

                </section>

            </div>


            <!-- =================================================
                 CUSTOMER QUESTION
                 ================================================= -->

            <div class="col-lg-6">

                <section class="detail-card question-card h-100">

                    <div class="card-heading">

                        <div class="card-icon">

                            <i class="fa-regular fa-comment-dots"></i>

                        </div>

                        <div>

                            <span>
                                CONSULTATION NOTE
                            </span>

                            <h2>
                                Customer Question
                            </h2>

                            <p>
                                Question submitted with the booking.
                            </p>

                        </div>

                    </div>


                    @if (string.IsNullOrWhiteSpace(Model.Question))
                    {
                        <div class="no-question">

                            <div class="no-question-icon">

                                <i class="fa-regular fa-message"></i>

                            </div>

                            <div>

                                <span>
                                    NO QUESTION
                                </span>

                                <strong>
                                    No question was provided.
                                </strong>

                                <p>
                                    The customer did not include an additional
                                    consultation question.
                                </p>

                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="question-box">

                            <div class="quote-icon">

                                <i class="fa-solid fa-quote-left"></i>

                            </div>

                            <p>
                                @Model.Question
                            </p>

                        </div>
                    }

                </section>

            </div>

        </div>


        <!-- =====================================================
             ACTIONS
             ===================================================== -->

        <section class="actions-card">

            <div class="actions-heading">

                <div>

                    <span>
                        RECEPTION WORKFLOW
                    </span>

                    <h2>
                        Booking Actions
                    </h2>

                    <p>
                        Update this appointment based on its current status.
                    </p>

                </div>


                <div class="actions-heading-icon">

                    <i class="fa-solid fa-bolt"></i>

                </div>

            </div>


            <div class="actions-content">

                <div class="action-status-info">

                    @if (Model.Status == BookingStatus.Pending)
                    {
                        <div class="workflow-message workflow-pending">

                            <i class="fa-regular fa-clock"></i>

                            <div>

                                <span>
                                    PENDING BOOKING
                                </span>

                                <strong>
                                    This appointment is waiting for confirmation.
                                </strong>

                            </div>

                        </div>
                    }
                    else if (Model.Status == BookingStatus.Confirmed)
                    {
                        <div class="workflow-message workflow-confirmed">

                            <i class="fa-solid fa-circle-check"></i>

                            <div>

                                <span>
                                    CONFIRMED BOOKING
                                </span>

                                <strong>
                                    This appointment is ready for consultation.
                                </strong>

                            </div>

                        </div>
                    }
                    else if (Model.Status == BookingStatus.Completed)
                    {
                        <div class="workflow-message workflow-completed">

                            <i class="fa-solid fa-check-double"></i>

                            <div>

                                <span>
                                    COMPLETED
                                </span>

                                <strong>
                                    This consultation has been completed.
                                </strong>

                            </div>

                        </div>
                    }
                    else if (Model.Status == BookingStatus.Cancelled)
                    {
                        <div class="workflow-message workflow-cancelled">

                            <i class="fa-solid fa-circle-xmark"></i>

                            <div>

                                <span>
                                    CANCELLED
                                </span>

                                <strong>
                                    This booking has been cancelled.
                                </strong>

                            </div>

                        </div>
                    }

                </div>


                <div class="action-buttons">

                    @if (Model.Status == BookingStatus.Pending)
                    {
                        <form asp-controller="Receptionist"
                              asp-action="ConfirmBooking"
                              asp-route-id="@Model.Id"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="action-btn confirm-action-btn">

                                <i class="fa-solid fa-check"></i>

                                Confirm Booking

                            </button>

                        </form>
                    }


                    @if (Model.Status == BookingStatus.Confirmed)
                    {
                        <form asp-controller="Receptionist"
                              asp-action="CompleteBooking"
                              asp-route-id="@Model.Id"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="action-btn complete-action-btn">

                                <i class="fa-solid fa-check-double"></i>

                                Complete Booking

                            </button>

                        </form>
                    }


                    @if (Model.Status == BookingStatus.Pending ||
                                        Model.Status == BookingStatus.Confirmed)
                    {
                        <form asp-controller="Receptionist"
                              asp-action="CancelBooking"
                              asp-route-id="@Model.Id"
                              method="post"
                              onsubmit="return confirm('Are you sure you want to cancel this booking?');">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="action-btn cancel-action-btn">

                                <i class="fa-solid fa-xmark"></i>

                                Cancel Booking

                            </button>

                        </form>
                    }


                    <a asp-controller="Receptionist"
                       asp-action="Bookings"
                       class="action-btn back-action-btn">

                        <i class="fa-solid fa-arrow-left"></i>

                        Back to Bookings

                    </a>

                </div>

            </div>

        </section>

    </div>

</section>


<style>

    /* =====================================================
           PAGE
           ===================================================== */

    .booking-details-page {
        min-height: 100vh;
        padding: 45px 0 80px;
        background: #f8f5ec;
    }


    /* =====================================================
           HEADER
           ===================================================== */

    .page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 30px;
        margin-bottom: 28px;
    }

    .section-label {
        display: block;
        margin-bottom: 8px;
        color: #987918;
        font-size: .63rem;
        font-weight: 800;
        letter-spacing: .17em;
    }

    .page-header h1 {
        margin-bottom: 8px;
        color: #181710;
        font-family: 'DM Serif Display', serif;
        font-size: clamp(2.5rem, 4vw, 3.8rem);
        font-weight: 400;
        line-height: 1;
    }

    .page-header p {
        max-width: 620px;
        margin: 0;
        color: #817b70;
        font-size: .8rem;
        line-height: 1.7;
    }

    .back-btn {
        min-height: 43px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        flex-shrink: 0;
        padding: 9px 16px;
        border: 1px solid #ccc2af;
        border-radius: 8px;
        background: transparent;
        color: #181710;
        font-size: .67rem;
        font-weight: 700;
        text-decoration: none;
        transition: all .2s ease;
    }

        .back-btn:hover {
            border-color: #181710;
            background: #181710;
            color: white;
        }


    /* =====================================================
           HERO
           ===================================================== */

    .booking-hero {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
        overflow: hidden;
        margin-bottom: 16px;
        padding: 29px 31px;
        border-radius: 20px;
        background: #181710;
        color: white;
    }

    .hero-content {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .hero-icon {
        width: 53px;
        height: 53px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 50%;
        background: #e1bf4a;
        color: #181710;
        font-size: .9rem;
    }

    .hero-label {
        display: block;
        margin-bottom: 3px;
        color: #e1bf4a;
        font-size: .52rem;
        font-weight: 800;
        letter-spacing: .15em;
    }

    .hero-content h2 {
        margin-bottom: 4px;
        font-family: 'DM Serif Display', serif;
        font-size: 1.8rem;
        font-weight: 400;
    }

    .hero-content p {
        margin: 0;
        color: rgba(255,255,255,.46);
        font-size: .65rem;
    }

    .hero-status {
        position: relative;
        z-index: 2;
        flex-shrink: 0;
        text-align: right;
    }

    .status-caption {
        display: block;
        margin-bottom: 7px;
        color: rgba(255,255,255,.35);
        font-size: .48rem;
        font-weight: 800;
        letter-spacing: .1em;
    }

    .hero-decoration {
        position: absolute;
        border: 1px solid rgba(225,191,74,.06);
        border-radius: 50%;
    }

    .hero-decoration-one {
        width: 260px;
        height: 260px;
        right: -120px;
        top: -170px;
    }

    .hero-decoration-two {
        width: 180px;
        height: 180px;
        right: 70px;
        bottom: -145px;
    }


    /* =====================================================
           STATUS
           ===================================================== */

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 11px;
        border-radius: 999px;
        font-size: .56rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .status-dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
    }

    .status-pending {
        background: #fff1c8;
        color: #745d12;
    }

        .status-pending .status-dot {
            background: #c49a1b;
        }

    .status-confirmed {
        background: #dfeddf;
        color: #45694b;
    }

        .status-confirmed .status-dot {
            background: #5a9765;
        }

    .status-completed {
        background: #e1e9ed;
        color: #4c6671;
    }

        .status-completed .status-dot {
            background: #688996;
        }

    .status-cancelled {
        background: #f3dddd;
        color: #8d4d47;
    }

        .status-cancelled .status-dot {
            background: #b76159;
        }

    .status-default {
        background: #ece8e0;
        color: #655f55;
    }

        .status-default .status-dot {
            background: #827a6d;
        }


    /* =====================================================
           APPOINTMENT STRIP
           ===================================================== */

    .appointment-strip {
        display: grid;
        grid-template-columns: repeat(7, auto);
        align-items: center;
        margin-bottom: 24px;
        padding: 17px 22px;
        border: 1px solid #e1d9ca;
        border-radius: 15px;
        background: #fffdf8;
    }

    .strip-item {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .strip-icon {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 50%;
        background: #f1eadc;
        color: #8b7425;
        font-size: .57rem;
    }

    .strip-item span,
    .strip-item strong {
        display: block;
    }

    .strip-item span {
        margin-bottom: 1px;
        color: #9b9386;
        font-size: .44rem;
        font-weight: 800;
        letter-spacing: .06em;
    }

    .strip-item strong {
        color: #38332b;
        font-size: .64rem;
    }

    .strip-divider {
        width: 1px;
        height: 30px;
        margin: 0 20px;
        background: #e5ddd0;
    }


    /* =====================================================
           DETAIL CARDS
           ===================================================== */

    .detail-card {
        padding: 26px;
        border: 1px solid #e1d9ca;
        border-radius: 18px;
        background: #fffdf8;
    }

    .card-heading {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 21px;
    }

    .card-icon {
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 50%;
        background: #181710;
        color: #e1bf4a;
        font-size: .7rem;
    }

    .gold-icon {
        background: #e1bf4a;
        color: #181710;
    }

    .card-heading span {
        display: block;
        margin-bottom: 2px;
        color: #987918;
        font-size: .49rem;
        font-weight: 800;
        letter-spacing: .12em;
    }

    .card-heading h2 {
        margin-bottom: 2px;
        color: #29251f;
        font-family: 'DM Serif Display', serif;
        font-size: 1.4rem;
        font-weight: 400;
    }

    .card-heading p {
        margin: 0;
        color: #958d80;
        font-size: .6rem;
    }


    /* =====================================================
           DETAIL LIST
           ===================================================== */

    .detail-list {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .detail-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 11px 12px;
        border: 1px solid #e8e0d4;
        border-radius: 10px;
