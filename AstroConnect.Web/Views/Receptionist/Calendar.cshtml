@using AstroConnect.Domain.Enums
@model AstroConnect.Web.ViewModels.Receptionist.ReceptionistBookingCalendarViewModel

@{
    ViewData["Title"] = "Booking Calendar";
}

<section class="calendar-page">

    <div class="container">

        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="page-header">

            <div>

                <span class="section-label">
                    RECEPTION DESK
                </span>

                <h1>
                    Booking Calendar
                </h1>

                <p>
                    View the daily consultation schedule and quickly
                    open appointment details.
                </p>

            </div>


            <div class="header-actions">

                <a asp-controller="Receptionist"
                   asp-action="Index"
                   class="btn dashboard-btn">

                    <i class="fa-solid fa-arrow-left"></i>

                    Dashboard

                </a>


                <a asp-controller="Receptionist"
                   asp-action="Bookings"
                   class="btn bookings-btn">

                    <i class="fa-solid fa-list"></i>

                    All Bookings

                </a>

            </div>

        </div>


        <!-- =====================================================
             CALENDAR CONTROL
             ===================================================== -->

        <section class="calendar-control">

            <div class="control-heading">

                <div class="control-icon">

                    <i class="fa-regular fa-calendar"></i>

                </div>

                <div>

                    <span>
                        SELECT SCHEDULE
                    </span>

                    <h2>
                        Choose a date
                    </h2>

                    <p>
                        View appointments scheduled for a specific day.
                    </p>

                </div>

            </div>


            <form asp-controller="Receptionist"
                  asp-action="Calendar"
                  method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-lg-6">

                        <label class="calendar-label">
                            Appointment Date
                        </label>

                        <div class="date-input-wrapper">

                            <i class="fa-regular fa-calendar"></i>

                            <input type="date"
                                   name="date"
                                   value="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                                   class="form-control" />

                        </div>

                    </div>


                    <div class="col-lg-3 col-md-6">

                        <button type="submit"
                                class="view-schedule-btn">

                            <i class="fa-solid fa-magnifying-glass"></i>

                            View Schedule

                        </button>

                    </div>


                    <div class="col-lg-3 col-md-6">

                        <a asp-controller="Receptionist"
                           asp-action="Calendar"
                           class="today-btn">

                            <i class="fa-solid fa-calendar-day"></i>

                            Today

                        </a>

                    </div>

                </div>

            </form>

        </section>


        <!-- =====================================================
             SELECTED DATE SUMMARY
             ===================================================== -->

        <section class="selected-date-panel">

            <div class="selected-date-main">

                <div class="selected-date-icon">

                    <i class="fa-solid fa-calendar-check"></i>

                </div>

                <div>

                    <span>
                        APPOINTMENT SCHEDULE
                    </span>

                    <h2>
                        @Model.SelectedDate.ToString("dddd, dd MMMM yyyy")
                    </h2>

                </div>

            </div>


            <div class="selected-date-count">

                <strong>
                    @Model.Bookings.Count
                </strong>

                <span>
                    @(Model.Bookings.Count == 1 ? "appointment" : "appointments")
                </span>

            </div>

        </section>


        <!-- =====================================================
             BOOKINGS
             ===================================================== -->
        @if (Model.Bookings.Any())
        {
            <div class="schedule-list">

                @foreach (var booking in Model.Bookings)
                {
                    <article class="schedule-card">

                        <!-- TIME -->

                        <div class="time-block">

                            <span>
                                TIME
                            </span>

                            <strong>
                                @booking.StartTime.ToString("hh:mm tt")
                            </strong>

                            <div class="time-line">

                                <span></span>

                                <small>
                                    to
                                </small>

                                <span></span>

                            </div>

                            <em>
                                @booking.EndTime.ToString("hh:mm tt")
                            </em>

                        </div>


                        <!-- CONTENT -->

                        <div class="schedule-content">

                            <div class="schedule-info-grid">


                                <!-- CUSTOMER -->

                                <div class="schedule-info">

                                    <div class="schedule-info-icon">

                                        <i class="fa-solid fa-user"></i>

                                    </div>

                                    <div>

                                        <span>
                                            CUSTOMER
                                        </span>

                                        <strong>
                                            @booking.CustomerName
                                        </strong>

                                    </div>

                                </div>


                                <!-- ASTROLOGER -->

                                <div class="schedule-info">

                                    <div class="schedule-info-icon gold-icon">

                                        <i class="fa-solid fa-star"></i>

                                    </div>

                                    <div>

                                        <span>
                                            ASTROLOGER
                                        </span>

                                        <strong>
                                            @booking.AstrologerName
                                        </strong>

                                    </div>

                                </div>


                                <!-- SERVICE -->

                                <div class="schedule-info">

                                    <div class="schedule-info-icon">

                                        <i class="fa-solid fa-moon"></i>

                                    </div>

                                    <div>

                                        <span>
                                            SERVICE
                                        </span>

                                        <strong>
                                            @booking.ServiceName
                                        </strong>

                                    </div>

                                </div>

                            </div>


                            <div class="schedule-bottom">

                                <div>

                                    @if (booking.Status == BookingStatus.Pending.ToString())
                                    {
                                        <span class="status-badge status-pending">

                                            <span class="status-dot"></span>

                                            Pending

                                        </span>
                                    }
                                    else if (booking.Status == BookingStatus.Confirmed.ToString())
                                    {
                                        <span class="status-badge status-confirmed">

                                            <span class="status-dot"></span>

                                            Confirmed

                                        </span>
                                    }
                                    else if (booking.Status == BookingStatus.Completed.ToString())
                                    {
                                        <span class="status-badge status-completed">

                                            <span class="status-dot"></span>

                                            Completed

                                        </span>
                                    }
                                    else if (booking.Status == BookingStatus.Cancelled.ToString())
                                    {
                                        <span class="status-badge status-cancelled">

                                            <span class="status-dot"></span>

                                            Cancelled

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-default">

                                            <span class="status-dot"></span>

                                            @booking.Status

                                        </span>
                                    }

                                </div>


                                <a asp-controller="Receptionist"
                                   asp-action="BookingDetails"
                                   asp-route-id="@booking.Id"
                                   class="details-btn">

                                    <i class="fa-solid fa-eye"></i>

                                    View Details

                                </a>

                            </div>

                        </div>

                    </article>
                }

            </div>
        }
        else
        {
            <!-- =================================================
                 EMPTY STATE
                 ================================================= -->

            <section class="empty-calendar">

                <div class="empty-decoration empty-decoration-one"></div>
                <div class="empty-decoration empty-decoration-two"></div>


                <div class="empty-content">

                    <div class="empty-icon">

                        <i class="fa-solid fa-calendar-xmark"></i>

                    </div>

                    <span>
                        NO APPOINTMENTS
                    </span>

                    <h2>
                        The schedule is clear.
                    </h2>

                    <p>
                        There are no appointments scheduled for
                        @Model.SelectedDate.ToString("dd MMMM yyyy").
                    </p>


                    <a asp-controller="Booking"
                       asp-action="Create"
                       class="empty-booking-btn">

                        <i class="fa-solid fa-calendar-plus"></i>

                        Create New Booking

                    </a>

                </div>

            </section>
        }


        <!-- =====================================================
             FOOTER CTA
             ===================================================== -->

        <section class="calendar-footer">

            <div>

                <div class="footer-icon">

                    <i class="fa-solid fa-headset"></i>

                </div>

                <div>

                    <span>
                        RECEPTION WORKFLOW
                    </span>

                    <h3>
                        Need to manage the full appointment list?
                    </h3>

                    <p>
                        Use Booking Management to confirm, complete or
                        cancel customer appointments.
                    </p>

                </div>

            </div>


            <a asp-controller="Receptionist"
               asp-action="Bookings"
               class="footer-btn">

                Manage Bookings

                <i class="fa-solid fa-arrow-right"></i>

            </a>

        </section>

    </div>

</section>


<style>

    /* =====================================================
           PAGE
           ===================================================== */

    .calendar-page {
        min-height: 100vh;
        padding: 45px 0 80px;
        background: #f8f5ec;
    }


    /* =====================================================
           HEADER
           ===================================================== */

    .page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 30px;
        margin-bottom: 28px;
    }

    .section-label {
        display: block;
        margin-bottom: 8px;
        color: #987918;
        font-size: .63rem;
        font-weight: 800;
        letter-spacing: .17em;
    }

    .page-header h1 {
        margin-bottom: 8px;
        color: #181710;
        font-family: 'DM Serif Display', serif;
        font-size: clamp(2.5rem, 4vw, 3.8rem);
        font-weight: 400;
        line-height: 1;
    }

    .page-header p {
        max-width: 620px;
        margin: 0;
        color: #817b70;
        font-size: .8rem;
        line-height: 1.7;
    }

    .header-actions {
        display: flex;
        gap: 9px;
        flex-shrink: 0;
    }

    .dashboard-btn,
    .bookings-btn {
        min-height: 43px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 9px 16px;
        font-size: .67rem;
        font-weight: 700;
    }

    .dashboard-btn {
        border: 1px solid #ccc2af;
        background: transparent;
        color: #181710;
    }

        .dashboard-btn:hover {
            border-color: #181710;
            background: #181710;
            color: white;
        }

    .bookings-btn {
        border: 1px solid #181710;
        background: #181710;
        color: white;
    }

        .bookings-btn:hover {
            border-color: #e1bf4a;
            background: #e1bf4a;
            color: #181710;
        }


    /* =====================================================
           CALENDAR CONTROL
           ===================================================== */

    .calendar-control {
        margin-bottom: 18px;
        padding: 24px 26px;
        border: 1px solid #e1d9ca;
        border-radius: 18px;
        background: #fffdf8;
    }

    .control-heading {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
    }

    .control-icon {
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 50%;
        background: #181710;
        color: #e1bf4a;
        font-size: .7rem;
    }

    .control-heading span {
        display: block;
        margin-bottom: 2px;
        color: #987918;
        font-size: .49rem;
        font-weight: 800;
        letter-spacing: .12em;
    }

    .control-heading h2 {
        margin-bottom: 2px;
        color: #29251f;
        font-family: 'DM Serif Display', serif;
        font-size: 1.4rem;
        font-weight: 400;
    }

    .control-heading p {
        margin: 0;
        color: #958d80;
        font-size: .6rem;
    }

    .calendar-label {
        display: block;
        margin-bottom: 6px;
        color: #514b41;
        font-size: .61rem;
        font-weight: 800;
    }

    .date-input-wrapper {
        position: relative;
    }

        .date-input-wrapper > i {
            position: absolute;
            left: 14px;
            top: 50%;
            z-index: 2;
            transform: translateY(-50%);
            color: #9c9487;
            font-size: .61rem;
            pointer-events: none;
        }

        .date-input-wrapper .form-control {
            min-height: 43px;
            padding-left: 39px;
            border: 1px solid #ddd5c6;
            border-radius: 10px;
            background: #faf7ef;
            color: #39342c;
            font-size: .69rem;
        }

            .date-input-wrapper .form-control:focus {
                border-color: #c5a943;
                background: white;
                box-shadow: 0 0 0 .18rem rgba(225,191,74,.11);
            }

    .view-schedule-btn,
    .today-btn {
        width: 100%;
        min-height: 43px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        border-radius: 10px;
        font-size: .64rem;
        font-weight: 700;
        text-decoration: none;
        transition: all .2s ease;
    }

    .view-schedule-btn {
        border: 1px solid #181710;
        background: #181710;
        color: white;
    }

        .view-schedule-btn:hover {
            border-color: #e1bf4a;
            background: #e1bf4a;
            color: #181710;
        }

    .today-btn {
        border: 1px solid #ccc2af;
        background: transparent;
        color: #181710;
    }

        .today-btn:hover {
            border-color: #181710;
            background: #181710;
            color: white;
        }


    /* =====================================================
           SELECTED DATE
           ===================================================== */

    .selected-date-panel {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
        margin-bottom: 18px;
        padding: 22px 26px;
        border-radius: 17px;
        background: #181710;
        color: white;
    }

    .selected-date-main {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .selected-date-icon {
        width: 46px;
        height: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 50%;
        background: #e1bf4a;
        color: #181710;
        font-size: .75rem;
    }

    .selected-date-main span {
        display: block;
        margin-bottom: 2px;
        color: #e1bf4a;
        font-size: .49rem;
        font-weight: 800;
        letter-spacing: .13em;
    }

    .selected-date-main h2 {
        margin: 0;
        font-family: 'DM Serif Display', serif;
        font-size: 1.5rem;
        font-weight: 400;
    }

    .selected-date-count {
        flex-shrink: 0;
        text-align: center;
    }

        .selected-date-count strong,
        .selected-date-count span {
            display: block;
        }

        .selected-date-count strong {
            color: #e1bf4a;
            font-family: 'DM Serif Display', serif;
            font-size: 1.7rem;
            font-weight: 400;
            line-height: 1;
        }

        .selected-date-count span {
            margin-top: 3px;
            color: rgba(255,255,255,.38);
            font-size: .49rem;
            font-weight: 700;
        }


    /* =====================================================
           SCHEDULE LIST
           ===================================================== */

    .schedule-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .schedule-card {
        display: grid;
        grid-template-columns: 160px 1fr;
        overflow: hidden;
        border: 1px solid #e1d9ca;
        border-radius: 17px;
        background: #fffdf8;
        transition: all .22s ease;
    }

        .schedule-card:hover {
            transform: translateY(-2px);
            border-color: #d0ba62;
            box-shadow: 0 12px 28px rgba(40,34,22,.05);
        }


    /* TIME */

    .time-block {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 170px;
        padding: 20px;
        background: #24221c;
        color: white;
        text-align: center;
    }

        .time-block > span {
            margin-bottom: 7px;
            color: #e1bf4a;
            font-size: .46rem;
            font-weight: 800;
            letter-spacing: .12em;
        }

        .time-block strong {
            font-family: 'DM Serif Display', serif;
            font-size: 1.45rem;
            font-weight: 400;
        }

        .time-block em {
            color: rgba(255,255,255,.58);
            font-size: .66rem;
            font-style: normal;
            font-weight: 700;
        }

    .time-line {
        width: 75px;
        display: flex;
        align-items: center;
        gap: 5px;
        margin: 5px 0;
    }

        .time-line span {
            flex: 1;
            height: 1px;
            background: rgba(255,255,255,.12);
        }

        .time-line small {
            color: rgba(255,255,255,.32);
            font-size: .45rem;
        }


    /* =====================================================
           SCHEDULE CONTENT
           ===================================================== */

    .schedule-content {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 22px 24px;
    }

    .schedule-info-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
    }

    .schedule-info {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 11px;
        border: 1px solid #e8e0d4;
        border-radius: 10px;
        background: #faf7ef;
    }

    .schedule-info-icon {
        width: 33px;
        height: 33px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 50%;
        background: #181710;
        color: #e1bf4a;
        font-size: .56rem;
    }

        .schedule-info-icon.gold-icon {
            background: #fff0ad;
            color: #6d5811;
        }

    .schedule-info span,
    .schedule-info strong {
        display: block;
    }

    .schedule-info span {
        margin-bottom: 1px;
        color: #999184;
        font-size: .43rem;
        font-weight: 800;
        letter-spacing: .06em;
    }

    .schedule-info strong {
        color: #39342c;
        font-size: .63rem;
        overflow-wrap: anywhere;
    }


    /* BOTTOM */

    .schedule-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-top: 14px;
        padding-top: 14px;
        border-top: 1px solid #e8e0d4;
    }

    .details-btn {
        min-height: 35px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 7px 11px;
        border: 1px solid #181710;
        border-radius: 8px;
        background: #181710;
        color: white;
        font-size: .58rem;
        font-weight: 800;
        text-decoration: none;
        transition: all .2s ease;
    }

        .details-btn:hover {
            border-color: #e1bf4a;
            background: #e1bf4a;
            color: #181710;
        }


    /* =====================================================
           STATUS
           ===================================================== */

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 9px;
        border-radius: 999px;
        font-size: .53rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .status-dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
    }

    .status-pending {
        background: #fff1c8;
        color: #745d12;
    }

        .status-pending .status-dot {
            background: #c49a1b;
        }

    .status-confirmed {
        background: #dfeddf;
        color: #45694b;
    }

        .status-confirmed .status-dot {
            background: #5a9765;
        }

    .status-completed {
        background: #e1e9ed;
        color: #4c6671;
    }

        .status-completed .status-dot {
            background: #688996;
        }

    .status-cancelled {
        background: #f3dddd;
        color: #8d4d47;
    }

        .status-cancelled .status-dot {
            background: #b76159;
        }

    .status-default {
        background: #ece8e0;
        color: #655f55;
    }

        .status-default .status-dot {
            background: #827a6d;
        }


    /* =====================================================
           EMPTY
           ===================================================== */

    .empty-calendar {
        position: relative;
        overflow: hidden;
        padding: 65px 25px;
        border-radius: 20px;
        background: #181710;
        color: white;
        text-align: center;
    }

    .empty-content {
        position: relative;
        z-index: 2;
        max-width: 560px;
        margin: auto;
    }

    .empty-icon {
        width: 62px;
        height: 62px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 18px;
        border-radius: 50%;
        background: #e1bf4a;
        color: #181710;
        font-size: 1rem;
    }

    .empty-content > span {
        display: block;
        margin-bottom: 6px;
        color: #e1bf4a;
        font-size: .53rem;
        font-weight: 800;
        letter-spacing: .14em;
    }

    .empty-content h2 {
        margin-bottom: 10px;
        font-family: 'DM Serif Display', serif;
        font-size: 2rem;
        font-weight: 400;
    }

    .empty-content p {
        margin-bottom: 20px;
        color: rgba(255,255,255,.45);
        font-size: .68rem;
        line-height: 1.7;
    }

    .empty-booking-btn {
        min-height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 8px 13px;
        border: 1px solid #e1bf4a;
        border-radius: 9px;
        background: #e1bf4a;
        color: #181710;
        font-size: .61rem;
        font-weight: 700;
        text-decoration: none;
    }

        .empty-booking-btn:hover {
            background: #d4af34;
            border-color: #d4af34;
            color: #181710;
        }

    .empty-decoration {
        position: absolute;
        border: 1px solid rgba(225,191,74,.06);
        border-radius: 50%;
    }

    .empty-decoration-one {
        width: 320px;
        height: 320px;
        right: -180px;
        top: -190px;
    }

    .empty-decoration-two {
        width: 220px;
        height: 220px;
        left: -130px;
        bottom: -150px;
    }


    /* =====================================================
           FOOTER
           ===================================================== */

    .calendar-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
        margin-top: 18px;
        padding: 24px 27px;
        border-radius: 17px;
        background: #24221c;
        color: white;
    }

        .calendar-footer > div {
            display: flex;
            align-items: center;
            gap: 12px;
        }

    .footer-icon {
        width: 41px;
        height: 41px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 50%;
        background: #e1bf4a;
        color: #181710;
        font-size: .7rem;
    }

    .calendar-footer span {
        display: block;
        margin-bottom: 2px;
        color: #e1bf4a;
        font-size: .49rem;
        font-weight: 800;
        letter-spacing: .12em;
    }

    .calendar-footer h3 {
        margin-bottom: 2px;
        font-family: 'DM Serif Display', serif;
        font-size: 1.15rem;
        font-weight: 400;
    }

    .calendar-footer p {
        margin: 0;
        color: rgba(255,255,255,.42);
        font-size: .59rem;
    }

    .footer-btn {
        min-height: 40px;
