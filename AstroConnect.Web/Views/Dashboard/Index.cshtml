@model AstroConnect.Web.ViewModels.Dashboard.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid py-4">

    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="fa-solid fa-gauge-high text-primary me-2"></i>
                Admin Dashboard
            </h2>

            <p class="text-muted mb-0">
                Overview of your AstroConnect booking system
            </p>
        </div>

        <div>
            <span class="badge bg-primary fs-6 px-3 py-2">
                <i class="fa-solid fa-user-shield me-1"></i>
                Administrator
            </span>
        </div>

    </div>


    <!-- ===================================================== -->
    <!-- MAIN STATISTICS -->
    <!-- ===================================================== -->

    <div class="row g-4 mb-4">

        <!-- Customers -->

        <div class="col-md-6 col-xl-3">

            <div class="card dashboard-card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Total Customers
                            </p>

                            <h2 class="fw-bold mb-0">
                                @Model.TotalCustomers
                            </h2>

                        </div>

                        <div class="dashboard-icon bg-primary">
                            <i class="fa-solid fa-users"></i>
                        </div>

                    </div>

                    <div class="mt-3">

                        <a asp-controller="Customer"
                           asp-action="Index"
                           class="text-decoration-none">

                            Manage Customers
                            <i class="fa-solid fa-arrow-right ms-1"></i>

                        </a>

                    </div>

                </div>

            </div>

        </div>


        <!-- Astrologers -->

        <div class="col-md-6 col-xl-3">

            <div class="card dashboard-card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Total Astrologers
                            </p>

                            <h2 class="fw-bold mb-0">
                                @Model.TotalAstrologers
                            </h2>

                        </div>

                        <div class="dashboard-icon bg-success">
                            <i class="fa-solid fa-star"></i>
                        </div>

                    </div>

                    <div class="mt-3">

                        <a asp-controller="Astrologer"
                           asp-action="Index"
                           class="text-decoration-none text-success">

                            Manage Astrologers
                            <i class="fa-solid fa-arrow-right ms-1"></i>

                        </a>

                    </div>

                </div>

            </div>

        </div>


        <!-- Services -->

        <div class="col-md-6 col-xl-3">

            <div class="card dashboard-card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Active Services
                            </p>

                            <h2 class="fw-bold mb-0">
                                @Model.TotalServices
                            </h2>

                        </div>

                        <div class="dashboard-icon bg-warning text-dark">
                            <i class="fa-solid fa-list-check"></i>
                        </div>

                    </div>

                    <div class="mt-3">

                        <a asp-controller="Service"
                           asp-action="Index"
                           class="text-decoration-none text-warning">

                            Manage Services
                            <i class="fa-solid fa-arrow-right ms-1"></i>

                        </a>

                    </div>

                </div>

            </div>

        </div>


        <!-- Bookings -->

        <div class="col-md-6 col-xl-3">

            <div class="card dashboard-card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Total Bookings
                            </p>

                            <h2 class="fw-bold mb-0">
                                @Model.TotalBookings
                            </h2>

                        </div>

                        <div class="dashboard-icon bg-info">
                            <i class="fa-solid fa-calendar-days"></i>
                        </div>

                    </div>

                    <div class="mt-3">

                        <a asp-controller="Booking"
                           asp-action="Index"
                           class="text-decoration-none text-info">

                            Manage Bookings
                            <i class="fa-solid fa-arrow-right ms-1"></i>

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- BOOKING STATUS -->
    <!-- ===================================================== -->

    <div class="row g-4 mb-4">

        <!-- Pending -->

        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm status-card">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <p class="text-muted mb-1">
                                Pending
                            </p>

                            <h3 class="fw-bold">
                                @Model.PendingBookings
                            </h3>

                        </div>

                        <i class="fa-solid fa-clock status-icon text-warning"></i>

                    </div>

                </div>

            </div>

        </div>


        <!-- Confirmed -->

        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm status-card">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <p class="text-muted mb-1">
                                Confirmed
                            </p>

                            <h3 class="fw-bold">
                                @Model.ConfirmedBookings
                            </h3>

                        </div>

                        <i class="fa-solid fa-circle-check status-icon text-success"></i>

                    </div>

                </div>

            </div>

        </div>


        <!-- Completed -->

        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm status-card">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <p class="text-muted mb-1">
                                Completed
                            </p>

                            <h3 class="fw-bold">
                                @Model.CompletedBookings
                            </h3>

                        </div>

                        <i class="fa-solid fa-calendar-check status-icon text-primary"></i>

                    </div>

                </div>

            </div>

        </div>


        <!-- Cancelled -->

        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm status-card">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <p class="text-muted mb-1">
                                Cancelled
                            </p>

                            <h3 class="fw-bold">
                                @Model.CancelledBookings
                            </h3>

                        </div>

                        <i class="fa-solid fa-circle-xmark status-icon text-danger"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- TODAY'S APPOINTMENTS + RECENT BOOKINGS -->
    <!-- ===================================================== -->

    <div class="row g-4 mb-4">


        <!-- ================================================= -->
        <!-- TODAY'S APPOINTMENTS -->
        <!-- ================================================= -->

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white py-3">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <h5 class="fw-bold mb-1">

                                <i class="fa-solid fa-calendar-day text-primary me-2"></i>

                                Today's Appointments

                            </h5>

                            <small class="text-muted">
                                Scheduled appointments for today
                            </small>

                        </div>

                        <span class="badge bg-primary">
                            @Model.TodayAppointments.Count
                        </span>

                    </div>

                </div>


                <div class="card-body p-0">

                    @if (!Model.TodayAppointments.Any())
                    {
                        <div class="text-center py-5">

                            <i class="fa-solid fa-calendar-xmark
                                          text-muted fs-1 mb-3">
                            </i>

                            <h6 class="text-muted">
                                No appointments today
                            </h6>

                            <p class="text-muted small mb-0">
                                There are no scheduled appointments for today.
                            </p>

                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">

                            <table class="table table-hover align-middle mb-0">

                                <thead class="table-light">

                                    <tr>

                                        <th>Time</th>

                                        <th>Customer</th>

                                        <th>Astrologer</th>

                                        <th>Service</th>

                                        <th>Status</th>

                                    </tr>

                                </thead>


                                <tbody>

                                    @foreach (var booking in Model.TodayAppointments)
                                    {
                                        <tr>

                                            <td>

                                                <strong>
                                                    @booking.StartTime.ToString("hh\\:mm")
                                                </strong>

                                                -

                                                @booking.EndTime.ToString("hh\\:mm")

                                            </td>


                                            <td>
                                                @booking.CustomerName
                                            </td>


                                            <td>
                                                @booking.AstrologerName
                                            </td>


                                            <td>
                                                @booking.ServiceName
                                            </td>


                                            <td>

                                                @switch (booking.Status)
                                                {
                                                    case "Pending":

                                                        <span class="badge bg-warning text-dark">
                                                            Pending
                                                        </span>

                                                        break;

                                                    case "Confirmed":

                                                        <span class="badge bg-success">
                                                            Confirmed
                                                        </span>

                                                        break;

                                                    case "Completed":

                                                        <span class="badge bg-primary">
                                                            Completed
                                                        </span>

                                                        break;

                                                    case "Cancelled":

                                                        <span class="badge bg-danger">
                                                            Cancelled
                                                        </span>

                                                        break;

                                                    default:

                                                        <span class="badge bg-secondary">
                                                            @booking.Status
                                                        </span>

                                                        break;
                                                }

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- ================================================= -->
        <!-- RECENT BOOKINGS -->
        <!-- ================================================= -->

        <div class="col-lg-5">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white py-3">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <h5 class="fw-bold mb-1">

                                <i class="fa-solid fa-clock-rotate-left
                                          text-success me-2">
                                </i>

                                Recent Bookings

                            </h5>

                            <small class="text-muted">
                                Latest appointment requests
                            </small>

                        </div>

                        <a asp-controller="Booking"
                           asp-action="Index"
                           class="btn btn-sm btn-outline-primary">

                            View All

                        </a>

                    </div>

                </div>


                <div class="card-body p-0">

                    @if (!Model.RecentBookings.Any())
                    {
                        <div class="text-center py-5">

                            <i class="fa-solid fa-calendar-plus
                                          text-muted fs-1 mb-3">
                            </i>

                            <h6 class="text-muted">
                                No bookings yet
                            </h6>

                            <p class="text-muted small mb-0">
                                Recent bookings will appear here.
                            </p>

                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">

                            @foreach (var booking in Model.RecentBookings)
                            {
                                <div class="list-group-item py-3">

                                    <div class="d-flex justify-content-between">

                                        <div>

                                            <div class="fw-bold">

                                                @booking.CustomerName

                                            </div>

                                            <small class="text-muted">

                                                @booking.ServiceName

                                                <span class="mx-1">
                                                    •
                                                </span>

                                                @booking.AstrologerName

                                            </small>

                                        </div>


                                        <div class="text-end">

                                            <div class="small fw-semibold">

                                                @booking.BookingDate
                                                .ToString("dd-MMM-yyyy")

                                            </div>

                                            <div class="mt-1">

                                                @switch (booking.Status)
                                                {
                                                    case "Pending":

                                                        <span class="badge bg-warning text-dark">
                                                            Pending
                                                        </span>

                                                        break;

                                                    case "Confirmed":

                                                        <span class="badge bg-success">
                                                            Confirmed
                                                        </span>

                                                        break;

                                                    case "Completed":

                                                        <span class="badge bg-primary">
                                                            Completed
                                                        </span>

                                                        break;

                                                    case "Cancelled":

                                                        <span class="badge bg-danger">
                                                            Cancelled
                                                        </span>

                                                        break;

                                                    default:

                                                        <span class="badge bg-secondary">
                                                            @booking.Status
                                                        </span>

                                                        break;
                                                }

                                            </div>

                                        </div>

                                    </div>


                                    <div class="mt-2">

                                        <a asp-controller="Booking"
                                           asp-action="Details"
                                           asp-route-id="@booking.Id"
                                           class="btn btn-sm btn-outline-info">

                                            <i class="fa-solid fa-eye me-1"></i>

                                            View Details

                                        </a>

                                    </div>

                                </div>
                            }

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- MANAGEMENT SECTION -->
    <!-- ===================================================== -->

    <div class="card border-0 shadow-sm mt-4">

        <div class="card-header bg-white py-3">

            <h5 class="fw-bold mb-0">

                <i class="fa-solid fa-gear text-primary me-2"></i>

                Management

            </h5>

        </div>


        <div class="card-body">

            <div class="row g-3">

                <!-- Users -->

                <div class="col-md-6 col-lg-3">

                    <a asp-controller="User"
                       asp-action="Index"
                       class="management-link">

                        <i class="fa-solid fa-user-gear"></i>

                        <span>
                            User Management
                        </span>

                    </a>

                </div>


                <!-- Customers -->

                <div class="col-md-6 col-lg-3">

                    <a asp-controller="Customer"
                       asp-action="Index"
                       class="management-link">

                        <i class="fa-solid fa-users"></i>

                        <span>
                            Customers
                        </span>

                    </a>

                </div>


                <!-- Astrologers -->

                <div class="col-md-6 col-lg-3">

                    <a asp-controller="Astrologer"
                       asp-action="Index"
                       class="management-link">

                        <i class="fa-solid fa-star"></i>

                        <span>
                            Astrologers
                        </span>

                    </a>

                </div>


                <!-- Services -->

                <div class="col-md-6 col-lg-3">

                    <a asp-controller="Service"
                       asp-action="Index"
                       class="management-link">

                        <i class="fa-solid fa-list"></i>

                        <span>
                            Services
                        </span>

                    </a>

                </div>


                <!-- Bookings -->

                <div class="col-md-6 col-lg-3">

                    <a asp-controller="Booking"
                       asp-action="Index"
                       class="management-link">

                        <i class="fa-solid fa-calendar-days"></i>

                        <span>
                            Bookings
                        </span>

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- DASHBOARD STYLES -->
<!-- ========================================================= -->

<style>

    .dashboard-card {
        transition: all .25s ease;
        border-radius: 15px;
    }


        .dashboard-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,.12) !important;
        }


    .dashboard-icon {
        width: 55px;
        height: 55px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 22px;
    }


    .status-card {
        border-radius: 15px;
    }


    .status-icon {
        font-size: 28px;
    }


    .management-link {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 15px;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        text-decoration: none;
        color: #333;
        transition: .2s;
    }


        .management-link:hover {
            background: #f8f9fa;
            transform: translateY(-2px);
            color: #0d6efd;
        }


        .management-link i {
            font-size: 20px;
            color: #0d6efd;
        }

</style>