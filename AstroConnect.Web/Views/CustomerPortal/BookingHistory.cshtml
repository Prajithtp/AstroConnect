@model List<AstroConnect.Domain.Entities.Booking>

@{
    ViewData["Title"] = "My Booking History";
}

<section class="booking-history-page">

    <div class="container">

        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="history-header">

            <div>

                <span class="section-label">
                    YOUR APPOINTMENTS
                </span>

                <h1>
                    Booking History
                </h1>

                <p>
                    Review your astrology consultations, appointment
                    schedules and current booking status.
                </p>

            </div>


            <div class="header-actions">

                <a asp-controller="CustomerPortal"
                   asp-action="Index"
                   class="btn dashboard-btn">

                    <i class="fa-solid fa-arrow-left"></i>

                    Dashboard

                </a>


                <a asp-controller="Booking"
                   asp-action="Create"
                   class="btn book-btn">

                    <i class="fa-solid fa-calendar-plus"></i>

                    Book Appointment

                </a>

            </div>

        </div>


        <!-- =====================================================
             SUCCESS MESSAGE
             ===================================================== -->
        @if (TempData["Success"] != null)
        {
            <div class="success-message">

                <div class="success-icon">
                    <i class="fa-solid fa-circle-check"></i>
                </div>

                <span>
                    @TempData["Success"]
                </span>

            </div>
        }


        <!-- =====================================================
             EMPTY STATE
             ===================================================== -->
        @if (Model == null || !Model.Any())
        {
            <div class="empty-booking-card">

                <div class="empty-decoration empty-decoration-one"></div>
                <div class="empty-decoration empty-decoration-two"></div>


                <div class="empty-content">

                    <div class="empty-icon">
                        <i class="fa-solid fa-calendar-days"></i>
                    </div>

                    <span class="empty-label">
                        NO APPOINTMENTS YET
                    </span>

                    <h2>
                        Your consultation journey
                        <span>can begin here.</span>
                    </h2>

                    <p>
                        You haven't booked an astrology consultation yet.
                        Choose a service, astrologer and convenient time
                        to schedule your first appointment.
                    </p>


                    <a asp-controller="Booking"
                       asp-action="Create"
                       class="btn empty-book-btn">

                        Book Your First Appointment

                        <i class="fa-solid fa-arrow-right"></i>

                    </a>

                </div>

            </div>
        }
        else
        {
            <!-- =================================================
                 SUMMARY
                 ================================================= -->

            <div class="history-summary">

                <div>

                    <div class="summary-icon">
                        <i class="fa-solid fa-calendar-check"></i>
                    </div>

                    <div>
                        <span>
                            TOTAL APPOINTMENTS
                        </span>

                        <strong>
                            @Model.Count
                        </strong>
                    </div>

                </div>


                <p>
                    Your complete AstroConnect consultation history.
                    Select an appointment below to view its full details.
                </p>

            </div>


            <!-- =================================================
                 DESKTOP TABLE
                 ================================================= -->

            <div class="history-card desktop-history">

                <div class="history-card-header">

                    <div>

                        <span class="card-label">
                            APPOINTMENT RECORDS
                        </span>

                        <h2>
                            Your Consultations
                        </h2>

                    </div>


                    <div class="record-count">

                        <i class="fa-solid fa-layer-group"></i>

                        @Model.Count
                        @(Model.Count == 1 ? "record" : "records")

                    </div>

                </div>


                <div class="table-responsive">

                    <table class="table booking-table align-middle">

                        <thead>

                            <tr>

                                <th>
                                    Consultation
                                </th>

                                <th>
                                    Astrologer
                                </th>

                                <th>
                                    Schedule
                                </th>

                                <th>
                                    WhatsApp
                                </th>

                                <th>
                                    Status
                                </th>

                                <th class="text-end">
                                    Details
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var booking in Model)
                            {
                                <tr>

                                    <!-- SERVICE -->

                                    <td>

                                        <div class="service-cell">

                                            <div class="table-icon">

                                                <i class="fa-solid fa-moon"></i>

                                            </div>

                                            <div>

                                                <span>
                                                    SERVICE
                                                </span>

                                                <strong>
                                                    @(booking.Service?.Name ?? "N/A")
                                                </strong>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- ASTROLOGER -->

                                    <td>

                                        <div class="astrologer-cell">

                                            <div class="astrologer-avatar">

                                                <i class="fa-solid fa-star"></i>

                                            </div>

                                            <div>

                                                <span>
                                                    ASTROLOGER
                                                </span>

                                                <strong>
                                                    @(booking.Astrologer?.FullName ?? "N/A")
                                                </strong>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- DATE / TIME -->

                                    <td>

                                        <div class="schedule-cell">

                                            <div>

                                                <i class="fa-regular fa-calendar"></i>

                                                @booking.BookingDate.ToString("dd MMM yyyy")

                                            </div>

                                            <div>

                                                <i class="fa-regular fa-clock"></i>

                                                @booking.StartTime.ToString("hh:mm tt")
                                                -
                                                @booking.EndTime.ToString("hh:mm tt")

                                            </div>

                                        </div>

                                    </td>


                                    <!-- WHATSAPP -->

                                    <td>

                                        <div class="whatsapp-cell">

                                            <i class="fa-brands fa-whatsapp"></i>

                                            <span>
                                                @(string.IsNullOrWhiteSpace(booking.WhatsAppNumber)
                                                                                        ? "Not provided"
                                                                                        : booking.WhatsAppNumber)
                                    </span>

                                        </div>

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                @switch (booking.Status)
                                        {
                                            case AstroConnect.Domain.Enums.BookingStatus.Pending:

                                                <span class="status-badge status-pending">

                                                    <span class="status-dot"></span>

                                                    Pending

                                                </span>

                                                break;


                                            case AstroConnect.Domain.Enums.BookingStatus.Confirmed:

                                                <span class="status-badge status-confirmed">

                                                    <span class="status-dot"></span>

                                                    Confirmed

                                                </span>

                                                break;


                                            case AstroConnect.Domain.Enums.BookingStatus.Completed:

                                                <span class="status-badge status-completed">

                                                    <span class="status-dot"></span>

                                                    Completed

                                                </span>

                                                break;


                                            case AstroConnect.Domain.Enums.BookingStatus.Cancelled:

                                                <span class="status-badge status-cancelled">

                                                    <span class="status-dot"></span>

                                                    Cancelled

                                                </span>

                                                break;


                                            default:

                                                <span class="status-badge status-default">

                                                    <span class="status-dot"></span>

                                                    @booking.Status

                                                </span>

                                                break;
                                        }

                                    </td>


                                    <!-- ACTION -->

                                    <td class="text-end">

                                        <a asp-controller="CustomerPortal"
                                           asp-action="BookingDetails"
                                           asp-route-id="@booking.Id"
                                           class="view-btn"
                                           title="View appointment details">

                                            View

                                            <i class="fa-solid fa-arrow-right"></i>

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>


            <!-- =================================================
                 MOBILE CARDS
                 ================================================= -->

            <div class="mobile-history">

                @foreach (var booking in Model)
                {
                    <div class="mobile-booking-card">

                        <div class="mobile-card-top">

                            <div>

                                <span class="mobile-label">
                                    CONSULTATION
                                </span>

                                <h3>
                                    @(booking.Service?.Name ?? "N/A")
                                </h3>

                            </div>


                            @switch (booking.Status)
                            {
                                case AstroConnect.Domain.Enums.BookingStatus.Pending:

                                    <span class="status-badge status-pending">

                                        <span class="status-dot"></span>

                                        Pending

                                    </span>

                                    break;


                                case AstroConnect.Domain.Enums.BookingStatus.Confirmed:

                                    <span class="status-badge status-confirmed">

                                        <span class="status-dot"></span>

                                        Confirmed

                                    </span>

                                    break;


                                case AstroConnect.Domain.Enums.BookingStatus.Completed:

                                    <span class="status-badge status-completed">

                                        <span class="status-dot"></span>

                                        Completed

                                    </span>

                                    break;


                                case AstroConnect.Domain.Enums.BookingStatus.Cancelled:

                                    <span class="status-badge status-cancelled">

                                        <span class="status-dot"></span>

                                        Cancelled

                                    </span>

                                    break;


                                default:

                                    <span class="status-badge status-default">

                                        <span class="status-dot"></span>

                                        @booking.Status

                                    </span>

                                    break;
                            }

                    </div>


                    <div class="mobile-info-list">

                        <div>

                            <i class="fa-solid fa-star"></i>

                            <div>

                                <span>
                                    Astrologer
                                </span>

                                <strong>
                                    @(booking.Astrologer?.FullName ?? "N/A")
                                </strong>

                            </div>

                        </div>


                        <div>

                            <i class="fa-regular fa-calendar"></i>

                            <div>

                                <span>
                                    Date
                                </span>

                                <strong>
                                    @booking.BookingDate.ToString("dd MMM yyyy")
                                </strong>

                            </div>

                        </div>


                        <div>

                            <i class="fa-regular fa-clock"></i>

                            <div>

                                <span>
                                    Time
                                </span>

                                <strong>
                                    @booking.StartTime.ToString("hh:mm tt")
                                    -
                                    @booking.EndTime.ToString("hh:mm tt")
                                </strong>

                            </div>

                        </div>


                        <div>

                            <i class="fa-brands fa-whatsapp"></i>

                            <div>

                                <span>
                                    WhatsApp
                                </span>

                                <strong>
                                    @(string.IsNullOrWhiteSpace(booking.WhatsAppNumber)
                                                                    ? "Not provided"
                                                                    : booking.WhatsAppNumber)
                            </strong>

                                </div>

                            </div>

                        </div>


                        <a asp-controller="CustomerPortal"
                           asp-action="BookingDetails"
                           asp-route-id="@booking.Id"
                           class="mobile-view-btn">

                            View Appointment

                            <i class="fa-solid fa-arrow-right"></i>

                        </a>

                    </div>
                        }

            </div>
        }


        <!-- =====================================================
             FOOTER CTA
             ===================================================== -->
        @if (Model != null && Model.Any())
        {
            <div class="booking-footer">

                <div>

                    <div class="footer-icon">
                        <i class="fa-solid fa-moon"></i>
                    </div>

                    <div>

                        <span>
                            READY FOR ANOTHER CONSULTATION?
                        </span>

                        <h3>
                            Schedule your next appointment.
                        </h3>

                    </div>

                </div>


                <a asp-controller="Booking"
                   asp-action="Create"
                   class="btn footer-book-btn">

                    Book Appointment

                    <i class="fa-solid fa-arrow-right"></i>

                </a>

            </div>
        }

    </div>

</section>


<style>

    /* =====================================================
           PAGE
           ===================================================== */

    .booking-history-page {
        min-height: 100vh;
        padding: 45px 0 80px;
        background: #f8f5ec;
    }


    /* =====================================================
           HEADER
           ===================================================== */

    .history-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 30px;
        margin-bottom: 32px;
    }

    .section-label {
        display: block;
        margin-bottom: 8px;
        color: #987918;
        font-size: .64rem;
        font-weight: 800;
        letter-spacing: .17em;
    }

    .history-header h1 {
        margin-bottom: 9px;
        color: #181710;
        font-family: 'DM Serif Display', serif;
        font-size: clamp(2.5rem, 4vw, 3.8rem);
        font-weight: 400;
        line-height: 1;
    }

    .history-header p {
        max-width: 650px;
        margin: 0;
        color: #817b70;
        font-size: .8rem;
        line-height: 1.7;
    }

    .header-actions {
        display: flex;
        gap: 9px;
        flex-shrink: 0;
    }

    .dashboard-btn,
    .book-btn {
        min-height: 43px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 9px 16px;
        font-size: .69rem;
    }

    .dashboard-btn {
        border: 1px solid #cfc5b2;
        background: transparent;
        color: #181710;
    }

        .dashboard-btn:hover {
            border-color: #181710;
            background: #181710;
            color: white;
        }

    .book-btn {
        border: 1px solid #181710;
        background: #181710;
        color: white;
    }

        .book-btn:hover {
            border-color: #e1bf4a;
            background: #e1bf4a;
            color: #181710;
        }


    /* =====================================================
           SUCCESS
           ===================================================== */

    .success-message {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 24px;
        padding: 13px 15px;
        border: 1px solid #cedfce;
        border-radius: 12px;
        background: #edf5ed;
        color: #49644d;
        font-size: .72rem;
        font-weight: 700;
    }

    .success-icon {
        color: #5b8561;
    }


    /* =====================================================
           SUMMARY
           ===================================================== */

    .history-summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
        margin-bottom: 18px;
        padding: 18px 22px;
        border: 1px solid #e1d9ca;
        border-radius: 15px;
        background: #fffdf8;
    }

        .history-summary > div {
            display: flex;
            align-items: center;
            gap: 11px;
        }

    .summary-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #181710;
        color: #e1bf4a;
        font-size: .75rem;
    }

    .history-summary span,
    .history-summary strong {
        display: block;
    }

    .history-summary span {
        margin-bottom: 1px;
        color: #928a7c;
        font-size: .55rem;
        font-weight: 800;
        letter-spacing: .09em;
    }

    .history-summary strong {
        color: #181710;
        font-family: 'DM Serif Display', serif;
        font-size: 1.5rem;
        font-weight: 400;
        line-height: 1;
    }

    .history-summary p {
        max-width: 480px;
        margin: 0;
        color: #898276;
        font-size: .68rem;
        line-height: 1.6;
    }


    /* =====================================================
           HISTORY CARD
           ===================================================== */

    .history-card {
        overflow: hidden;
        border: 1px solid #e1d9ca;
        border-radius: 20px;
        background: #fffdf8;
    }

    .history-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 26px 28px 20px;
    }

    .card-label {
        display: block;
        margin-bottom: 5px;
        color: #987918;
        font-size: .58rem;
        font-weight: 800;
        letter-spacing: .14em;
    }

    .history-card-header h2 {
        margin: 0;
        color: #181710;
        font-family: 'DM Serif Display', serif;
        font-size: 1.7rem;
        font-weight: 400;
    }

    .record-count {
        padding: 7px 11px;
        border: 1px solid #ddd4c3;
        border-radius: 999px;
        color: #766e60;
        font-size: .62rem;
        font-weight: 700;
    }

        .record-count i {
            margin-right: 4px;
            color: #987918;
        }


    /* =====================================================
           TABLE
           ===================================================== */

    .booking-table {
        margin: 0;
    }

        .booking-table thead th {
            padding: 13px 18px;
            border-top: 1px solid #e6dfd3;
            border-bottom: 1px solid #ded6c8;
            background: #faf7ef;
            color: #8a8377;
            font-size: .58rem;
            font-weight: 800;
            letter-spacing: .07em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .booking-table tbody td {
            padding: 17px 18px;
            border-bottom: 1px solid #eee7dc;
            color: #554f46;
            font-size: .71rem;
            vertical-align: middle;
        }

        .booking-table tbody tr:last-child td {
            border-bottom: none;
        }

        .booking-table tbody tr {
            transition: background .2s ease;
        }

            .booking-table tbody tr:hover {
                background: #fbf8f1;
            }


    /* SERVICE */

    .service-cell,
    .astrologer-cell {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .table-icon,
    .astrologer-avatar {
        width: 37px;
        height: 37px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-size: .66rem;
    }

    .table-icon {
        background: #181710;
        color: #e1bf4a;
    }

    .astrologer-avatar {
        background: #fff0ad;
        color: #6d5811;
    }

    .service-cell span,
    .service-cell strong,
    .astrologer-cell span,
    .astrologer-cell strong {
        display: block;
    }

    .service-cell span,
    .astrologer-cell span {
        margin-bottom: 2px;
        color: #a0988a;
        font-size: .5rem;
        font-weight: 800;
        letter-spacing: .07em;
    }

    .service-cell strong,
    .astrologer-cell strong {
        color: #302c25;
        font-size: .7rem;
        font-weight: 800;
        white-space: nowrap;
    }


    /* SCHEDULE */

    .schedule-cell {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

        .schedule-cell > div {
            display: flex;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
        }

        .schedule-cell i {
            width: 14px;
            color: #987918;
            text-align: center;
        }


    /* WHATSAPP */

    .whatsapp-cell {
        display: flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
    }

        .whatsapp-cell i {
            color: #628368;
            font-size: .85rem;
        }


    /* =====================================================
           STATUS
           ===================================================== */

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: .58rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
    }

    .status-pending {
        background: #fff1c8;
        color: #745d12;
    }

        .status-pending .status-dot {
            background: #c49a1b;
        }

    .status-confirmed {
        background: #dfeddf;
        color: #45694b;
    }

        .status-confirmed .status-dot {
            background: #5a9765;
        }

    .status-completed {
        background: #e1e9ed;
        color: #4c6671;
    }

        .status-completed .status-dot {
            background: #688996;
        }

    .status-cancelled {
        background: #f3dddd;
        color: #8d4d47;
    }

        .status-cancelled .status-dot {
            background: #b76159;
        }

    .status-default {
        background: #ece8e0;
        color: #655f55;
    }

        .status-default .status-dot {
            background: #827a6d;
        }


    /* =====================================================
           VIEW BUTTON
           ===================================================== */

    .view-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 8px 11px;
        border: 1px solid #d4cbb9;
        border-radius: 9px;
        color: #39352e;
        font-size: .62rem;
        font-weight: 800;
        text-decoration: none;
        transition: all .2s ease;
    }

        .view-btn i {
            font-size: .52rem;
        }

        .view-btn:hover {
            border-color: #181710;
            background: #181710;
            color: #e1bf4a;
        }


    /* =====================================================
           MOBILE HISTORY
           ===================================================== */

    .mobile-history {
        display: none;
    }

    .mobile-booking-card {
        margin-bottom: 15px;
        padding: 22px;
        border: 1px solid #e1d9ca;
        border-radius: 17px;
        background: #fffdf8;
    }

    .mobile-card-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 20px;
    }

    .mobile-label {
        display: block;
        margin-bottom: 4px;
        color: #987918;
        font-size: .53rem;
        font-weight: 800;
        letter-spacing: .1em;
    }

    .mobile-card-top h3 {
        margin: 0;
        color: #181710;
        font-family: 'DM Serif Display', serif;
        font-size: 1.35rem;
        font-weight: 400;
    }

    .mobile-info-list {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-bottom: 18px;
    }

        .mobile-info-list > div {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 11px;
            border: 1px solid #e9e2d6;
            border-radius: 10px;
            background: #faf7ef;
        }

            .mobile-info-list > div > i {
                width: 18px;
                color: #987918;
                text-align: center;
            }

        .mobile-info-list span,
        .mobile-info-list strong {
            display: block;
        }

        .mobile-info-list span {
            margin-bottom: 2px;
            color: #958e82;
            font-size: .52rem;
            text-transform: uppercase;
        }

        .mobile-info-list strong {
            color: #373229;
            font-size: .66rem;
        }

    .mobile-view-btn {
        min-height: 41px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        border-radius: 10px;
        background: #181710;
        color: white;
        font-size: .66rem;
        font-weight: 700;
        text-decoration: none;
    }

        .mobile-view-btn:hover {
            background: #e1bf4a;
            color: #181710;
        }


    /* =====================================================
           EMPTY STATE
           ===================================================== */

    .empty-booking-card {
        position: relative;
        overflow: hidden;
        padding: 70px 25px;
        border-radius: 22px;
        background: #181710;
        text-align: center;
        color: white;
    }

    .empty-content {
        position: relative;
        z-index: 2;
        max-width: 600px;
        margin: auto;
    }

    .empty-icon {
        width: 65px;
        height: 65px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 22px;
        border-radius: 50%;
        background: #e1bf4a;
        color: #181710;
        font-size: 1.15rem;
    }

    .empty-label {
        display: block;
        margin-bottom: 9px;
