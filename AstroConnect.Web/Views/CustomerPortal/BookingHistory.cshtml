@model List<AstroConnect.Domain.Entities.Booking>

@{
    ViewData["Title"] = "My Booking History";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                📜 My Booking History
            </h2>

            <p class="text-muted mb-0">
                View all your astrology appointments.
            </p>
        </div>

        <a asp-controller="Booking"
           asp-action="Create"
           class="btn btn-primary">

            📅 Book New Appointment

        </a>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }


    @if (Model == null || !Model.Any())
    {
        <div class="card shadow-sm border-0">

            <div class="card-body text-center py-5">

                <div style="font-size:50px;">
                    📅
                </div>

                <h4 class="mt-3">
                    No appointments yet
                </h4>

                <p class="text-muted">
                    You haven't booked any astrology consultation yet.
                </p>

                <a asp-controller="Booking"
                   asp-action="Create"
                   class="btn btn-primary">

                    Book Your First Appointment

                </a>

            </div>

        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-primary">

                            <tr>

                                <th>
                                    Service
                                </th>

                                <th>
                                    Astrologer
                                </th>

                                <th>
                                    Date
                                </th>

                                <th>
                                    Time
                                </th>

                                <th>
                                    WhatsApp
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Action
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var booking in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @(booking.Service?.Name ?? "N/A")
                                        </strong>
                                    </td>

                                    <td>
                                        @(booking.Astrologer?.FullName ?? "N/A")
                                    </td>

                                    <td>
                                        @booking.BookingDate.ToString("dd-MM-yyyy")
                                    </td>

                                    <td>
                                        @booking.StartTime.ToString("hh:mm tt")
                                        -
                                        @booking.EndTime.ToString("hh:mm tt")
                                    </td>

                                    <td>
                                        @booking.WhatsAppNumber
                                    </td>

                                    <td>
                                        @switch (booking.Status)
                                        {
                                            case AstroConnect.Domain.Enums.BookingStatus.Pending:

                                                <span class="badge bg-warning text-dark">
                                                    Pending
                                                </span>

                                                break;

                                            case AstroConnect.Domain.Enums.BookingStatus.Confirmed:

                                                <span class="badge bg-success">
                                                    Confirmed
                                                </span>

                                                break;

                                            case AstroConnect.Domain.Enums.BookingStatus.Completed:

                                                <span class="badge bg-primary">
                                                    Completed
                                                </span>

                                                break;

                                            case AstroConnect.Domain.Enums.BookingStatus.Cancelled:

                                                <span class="badge bg-danger">
                                                    Cancelled
                                                </span>

                                                break;

                                            default:

                                                <span class="badge bg-secondary">
                                                    @booking.Status
                                                </span>

                                                break;
                                        }
                                    </td>

                                    <td>

                                        <a asp-controller="CustomerPortal"
                                           asp-action="BookingDetails"
                                           asp-route-id="@booking.Id"
                                           class="btn btn-sm btn-outline-primary">

                                            View

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>