@model AstroConnect.Web.ViewModels.CustomerPortal.CustomerDashboardViewModel

@{
    ViewData["Title"] = "Customer Dashboard";
}

<div class="customer-dashboard">

    <div class="container-fluid dashboard-container">


        <!-- =====================================================
             WELCOME HERO
             ===================================================== -->

        <section class="dashboard-hero mb-4">

            <div class="hero-orbit orbit-one"></div>
            <div class="hero-orbit orbit-two"></div>

            <div class="hero-content">

                <div>

                    <span class="hero-label">
                        CUSTOMER PORTAL
                    </span>

                    <h1>
                        Welcome back to
                        <span>AstroConnect.</span>
                    </h1>

                    <p>
                        Manage your appointments, profile and booking updates
                        from one convenient place.
                    </p>

                </div>


                <div class="hero-actions">

                    <a asp-controller="Booking"
                       asp-action="Create"
                       class="btn hero-book-btn">

                        <i class="fa-solid fa-calendar-plus"></i>

                        Book Appointment

                    </a>


                    <a asp-controller="CustomerPortal"
                       asp-action="Profile"
                       class="btn hero-profile-btn">

                        <i class="fa-solid fa-user-pen"></i>

                        My Profile

                    </a>

                </div>

            </div>

        </section>


        <!-- =====================================================
             STATISTICS
             ===================================================== -->

        <div class="row g-4 mb-4">


            <!-- TOTAL -->

            <div class="col-md-6 col-xl-3">

                <div class="dashboard-stat-card">

                    <div class="stat-top">

                        <div class="stat-icon">
                            <i class="fa-solid fa-calendar-days"></i>
                        </div>

                        <span class="stat-number">
                            @Model.TotalBookings
                        </span>

                    </div>

                    <h5>
                        Total Bookings
                    </h5>

                    <p>
                        All your appointments
                    </p>

                    <a asp-controller="CustomerPortal"
                       asp-action="BookingHistory">

                        View appointments

                        <i class="fa-solid fa-arrow-right"></i>

                    </a>

                </div>

            </div>


            <!-- PENDING -->

            <div class="col-md-6 col-xl-3">

                <div class="dashboard-stat-card">

                    <div class="stat-top">

                        <div class="stat-icon pending-icon">
                            <i class="fa-solid fa-clock"></i>
                        </div>

                        <span class="stat-number">
                            @Model.PendingBookings
                        </span>

                    </div>

                    <h5>
                        Pending
                    </h5>

                    <p>
                        Awaiting confirmation
                    </p>

                    <span class="stat-note">
                        Booking requests
                    </span>

                </div>

            </div>


            <!-- CONFIRMED -->

            <div class="col-md-6 col-xl-3">

                <div class="dashboard-stat-card">

                    <div class="stat-top">

                        <div class="stat-icon confirmed-icon">
                            <i class="fa-solid fa-circle-check"></i>
                        </div>

                        <span class="stat-number">
                            @Model.ConfirmedBookings
                        </span>

                    </div>

                    <h5>
                        Confirmed
                    </h5>

                    <p>
                        Ready for consultation
                    </p>

                    <span class="stat-note">
                        Upcoming confirmed
                    </span>

                </div>

            </div>


            <!-- NOTIFICATIONS -->

            <div class="col-md-6 col-xl-3">

                <div class="dashboard-stat-card notification-stat">

                    <div class="stat-top">

                        <div class="stat-icon notification-icon">
                            <i class="fa-solid fa-bell"></i>
                        </div>

                        <span class="stat-number">
                            @Model.UnreadNotificationCount
                        </span>

                    </div>

                    <h5>
                        Notifications
                    </h5>

                    <p>
                        Unread booking updates
                    </p>

                    <a asp-controller="Notification"
                       asp-action="Index">

                        View notifications

                        <i class="fa-solid fa-arrow-right"></i>

                    </a>

                </div>

            </div>

        </div>


        <!-- =====================================================
             UPCOMING APPOINTMENT
             ===================================================== -->

        <section class="dashboard-panel mb-4">

            <div class="panel-header">

                <div>

                    <span class="panel-label">
                        NEXT CONSULTATION
                    </span>

                    <h2>
                        Upcoming Appointment
                    </h2>

                    <p>
                        Your next scheduled astrology consultation.
                    </p>

                </div>


                <a asp-controller="Booking"
                   asp-action="Create"
                   class="btn panel-action-btn">

                    <i class="fa-solid fa-plus"></i>

                    New Appointment

                </a>

            </div>


            @if (Model.UpcomingBooking != null)
            {
                <div class="upcoming-booking">

                    <div class="row g-4 align-items-center">


                        <!-- ASTROLOGER -->

                        <div class="col-md-6 col-xl-3">

                            <div class="booking-info">

                                <div class="booking-info-icon">
                                    <i class="fa-solid fa-star"></i>
                                </div>

                                <div>

                                    <span>
                                        Astrologer
                                    </span>

                                    <strong>
                                        @(Model.UpcomingBooking.Astrologer?.FullName
                                                                            ?? "Astrologer")
                                                                                        </strong>

                                </div>

                            </div>

                        </div>


                        <!-- SERVICE -->

                        <div class="col-md-6 col-xl-3">

                            <div class="booking-info">

                                <div class="booking-info-icon">
                                    <i class="fa-solid fa-list-check"></i>
                                </div>

                                <div>

                                    <span>
                                        Service
                                    </span>

                                    <strong>
                                        @(Model.UpcomingBooking.Service?.Name
                                                                            ?? "Consultation")
                                </strong>

                                </div>

                            </div>

                        </div>


                        <!-- DATE -->

                        <div class="col-md-6 col-xl-3">

                            <div class="booking-info">

                                <div class="booking-info-icon">
                                    <i class="fa-solid fa-calendar"></i>
                                </div>

                                <div>

                                    <span>
                                        Date
                                    </span>

                                    <strong>
                                        @Model.UpcomingBooking.BookingDate.ToString("dd MMM yyyy")
                                    </strong>

                                </div>

                            </div>

                        </div>


                        <!-- TIME -->

                        <div class="col-md-6 col-xl-3">

                            <div class="booking-info">

                                <div class="booking-info-icon">
                                    <i class="fa-solid fa-clock"></i>
                                </div>

                                <div>

                                    <span>
                                        Time
                                    </span>

                                    <strong>
                                        @Model.UpcomingBooking.StartTime.ToString("hh:mm tt")
                                        -
                                        @Model.UpcomingBooking.EndTime.ToString("hh:mm tt")
                                    </strong>

                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="upcoming-footer">

                        <div class="appointment-reminder">

                            <i class="fa-solid fa-circle-info"></i>

                            Keep your birth details ready before your consultation.

                        </div>


                        <a asp-controller="CustomerPortal"
                           asp-action="BookingDetails"
                           asp-route-id="@Model.UpcomingBooking.Id"
                           class="btn view-appointment-btn">

                            View Appointment

                            <i class="fa-solid fa-arrow-right"></i>

                        </a>

                    </div>

                </div>
                        }
            else
            {
                <div class="empty-state">

                    <div class="empty-icon">
                        <i class="fa-solid fa-calendar-xmark"></i>
                    </div>

                    <h4>
                        No Upcoming Appointments
                    </h4>

                    <p>
                        You don't currently have an upcoming astrology consultation.
                    </p>

                    <a asp-controller="Booking"
                       asp-action="Create"
                       class="btn empty-action-btn">

                        <i class="fa-solid fa-calendar-plus"></i>

                        Book Your Appointment

                    </a>

                </div>
            }

        </section>


        <!-- =====================================================
             QUICK ACTIONS
             ===================================================== -->

        <div class="row g-4 mb-4">


            <!-- BOOK -->

            <div class="col-md-6 col-xl-4">

                <a asp-controller="Booking"
                   asp-action="Create"
                   class="action-card">

                    <div class="action-icon">

                        <i class="fa-solid fa-calendar-plus"></i>

                    </div>

                    <div class="action-content">

                        <span>
                            APPOINTMENTS
                        </span>

                        <h3>
                            Book Appointment
                        </h3>

                        <p>
                            Choose a service, astrologer and convenient appointment time.
                        </p>

                    </div>

                    <div class="action-arrow">

                        <i class="fa-solid fa-arrow-right"></i>

                    </div>

                </a>

            </div>


            <!-- HISTORY -->

            <div class="col-md-6 col-xl-4">

                <a asp-controller="CustomerPortal"
                   asp-action="BookingHistory"
                   class="action-card">

                    <div class="action-icon">

                        <i class="fa-solid fa-calendar-days"></i>

                    </div>

                    <div class="action-content">

                        <span>
                            YOUR HISTORY
                        </span>

                        <h3>
                            My Appointments
                        </h3>

                        <p>
                            Review upcoming, completed and previous consultations.
                        </p>

                    </div>

                    <div class="action-arrow">

                        <i class="fa-solid fa-arrow-right"></i>

                    </div>

                </a>

            </div>


            <!-- PROFILE -->

            <div class="col-md-6 col-xl-4">

                <a asp-controller="CustomerPortal"
                   asp-action="Profile"
                   class="action-card">

                    <div class="action-icon">

                        <i class="fa-solid fa-user"></i>

                    </div>

                    <div class="action-content">

                        <span>
                            ACCOUNT
                        </span>

                        <h3>
                            My Profile
                        </h3>

                        <p>
                            Update your contact information and personal birth details.
                        </p>

                    </div>

                    <div class="action-arrow">

                        <i class="fa-solid fa-arrow-right"></i>

                    </div>

                </a>

            </div>

        </div>


        <!-- =====================================================
             RECENT BOOKINGS
             ===================================================== -->

        <section class="dashboard-panel mb-4">

            <div class="panel-header compact-header">

                <div>

                    <span class="panel-label">
                        RECENT ACTIVITY
                    </span>

                    <h2>
                        Recent Bookings
                    </h2>

                    <p>
                        Your latest appointment activity.
                    </p>

                </div>


                <a asp-controller="CustomerPortal"
                   asp-action="BookingHistory"
                   class="text-link">

                    View All

                    <i class="fa-solid fa-arrow-right"></i>

                </a>

            </div>


            @if (Model.RecentBookings != null &&
                        Model.RecentBookings.Any())
            {
                <div class="table-responsive">

                    <table class="table customer-table align-middle">

                        <thead>

                            <tr>

                                <th>Astrologer</th>

                                <th>Service</th>

                                <th>Date</th>

                                <th>Time</th>

                                <th>Status</th>

                                <th class="text-end">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var booking in Model.RecentBookings)
                            {
                                <tr>


                                    <td>

                                        <div class="astrologer-cell">

                                            <div class="table-icon">

                                                <i class="fa-solid fa-star"></i>

                                            </div>

                                            <strong>

                                                @(booking.Astrologer?.FullName
                                                                                        ?? "Astrologer")

                                            </strong>

                                        </div>

                                    </td>


                                    <td>

                                        @(booking.Service?.Name
                                                                        ?? "Consultation")

                            </td>


                                    <td>

                                        @booking.BookingDate.ToString("dd MMM yyyy")

                                    </td>


                                    <td>

                                        @booking.StartTime.ToString("hh:mm tt")
                                        -
                                        @booking.EndTime.ToString("hh:mm tt")

                                    </td>


                                    <td>

                                @if (booking.Status ==
                                                                AstroConnect.Domain.Enums.BookingStatus.Pending)
                                        {
                                            <span class="status-badge status-pending">

                                                <span></span>

                                                Pending

                                            </span>
                                        }
                                        else if (booking.Status ==
                                        AstroConnect.Domain.Enums.BookingStatus.Confirmed)
                                        {
                                            <span class="status-badge status-confirmed">

                                                <span></span>

                                                Confirmed

                                            </span>
                                        }
                                        else if (booking.Status ==
                                        AstroConnect.Domain.Enums.BookingStatus.Completed)
                                        {
                                            <span class="status-badge status-completed">

                                                <span></span>

                                                Completed

                                            </span>
                                        }
                                        else if (booking.Status ==
                                        AstroConnect.Domain.Enums.BookingStatus.Cancelled)
                                        {
                                            <span class="status-badge status-cancelled">

                                                <span></span>

                                                Cancelled

                                            </span>
                                        }

                                    </td>


                                    <td class="text-end">

                                        <a asp-controller="CustomerPortal"
                                           asp-action="BookingDetails"
                                           asp-route-id="@booking.Id"
                                           class="table-action-btn"
                                           title="View Appointment">

                                            <i class="fa-solid fa-arrow-right"></i>

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="empty-state small-empty-state">

                    <div class="empty-icon">

                        <i class="fa-solid fa-calendar-xmark"></i>

                    </div>

                    <h4>
                        No Bookings Yet
                    </h4>

                    <p>
                        Your latest appointments will appear here.
                    </p>

                </div>
            }

        </section>


        <!-- =====================================================
             SERVICES + QUICK LINKS
             ===================================================== -->

        <div class="row g-4">


            <!-- SERVICES -->

            <div class="col-lg-8">

                <section class="dashboard-panel h-100">

                    <div class="panel-header compact-header">

                        <div>

                            <span class="panel-label">
                                EXPLORE
                            </span>

                            <h2>
                                Astrology Services
                            </h2>

                            <p>
                                Guidance for different areas of your life.
                            </p>

                        </div>

                    </div>


                    <div class="row g-3">


                        <div class="col-md-6">

                            <a asp-controller="Public"
                               asp-action="Services"
                               class="service-item">

                                <div class="service-icon">

                                    <i class="fa-solid fa-heart"></i>

                                </div>

                                <span>
                                    Marriage Consultation
                                </span>

                                <i class="fa-solid fa-arrow-right"></i>

                            </a>

                        </div>


                        <div class="col-md-6">

                            <a asp-controller="Public"
                               asp-action="Services"
                               class="service-item">

                                <div class="service-icon">

                                    <i class="fa-solid fa-briefcase"></i>

                                </div>

                                <span>
                                    Career Guidance
                                </span>

                                <i class="fa-solid fa-arrow-right"></i>

                            </a>

                        </div>


                        <div class="col-md-6">

                            <a asp-controller="Public"
                               asp-action="Services"
                               class="service-item">

                                <div class="service-icon">

                                    <i class="fa-solid fa-moon"></i>

                                </div>

                                <span>
                                    Horoscope Reading
                                </span>

                                <i class="fa-solid fa-arrow-right"></i>

                            </a>

                        </div>


                        <div class="col-md-6">

                            <a asp-controller="Public"
                               asp-action="Services"
                               class="service-item">

                                <div class="service-icon">

                                    <i class="fa-solid fa-calendar-check"></i>

                                </div>

                                <span>
                                    Muhurtham
                                </span>

                                <i class="fa-solid fa-arrow-right"></i>

                            </a>

                        </div>


                        <div class="col-md-6">

                            <a asp-controller="Public"
                               asp-action="Services"
                               class="service-item">

                                <div class="service-icon">

                                    <i class="fa-solid fa-house"></i>

                                </div>

                                <span>
                                    Vasthu Consultation
                                </span>

                                <i class="fa-solid fa-arrow-right"></i>

                            </a>

                        </div>

                    </div>

                </section>

            </div>


            <!-- QUICK LINKS -->

            <div class="col-lg-4">

                <section class="dashboard-panel h-100">

                    <div class="panel-header compact-header">

                        <div>

                            <span class="panel-label">
                                NAVIGATION
                            </span>

                            <h2>
                                Quick Links
                            </h2>

                        </div>

                    </div>


                    <div class="quick-link-list">


                        <a asp-controller="Booking"
                           asp-action="Create"
                           class="quick-link">

                            <div>

                                <i class="fa-solid fa-calendar-plus"></i>

                                <span>
                                    Book Appointment
                                </span>

                            </div>

                            <i class="fa-solid fa-chevron-right"></i>

                        </a>


                        <a asp-controller="CustomerPortal"
                           asp-action="BookingHistory"
                           class="quick-link">

                            <div>

                                <i class="fa-solid fa-clock-rotate-left"></i>

                                <span>
                                    Booking History
                                </span>

                            </div>

                            <i class="fa-solid fa-chevron-right"></i>

                        </a>


                        <a asp-controller="CustomerPortal"
                           asp-action="Profile"
                           class="quick-link">

                            <div>

                                <i class="fa-solid fa-user-pen"></i>

                                <span>
                                    My Profile
                                </span>

                            </div>

                            <i class="fa-solid fa-chevron-right"></i>

                        </a>


                        <a asp-controller="Notification"
                           asp-action="Index"
                           class="quick-link">

                            <div>

                                <i class="fa-solid fa-bell"></i>

                                <span>
                                    Notifications
                                </span>

                                @if (Model.UnreadNotificationCount > 0)
                                {
                                    <span class="notification-count">
                                        @Model.UnreadNotificationCount
                                    </span>
                                }

                            </div>

                            <i class="fa-solid fa-chevron-right"></i>

                        </a>


                        <a asp-controller="Public"
                           asp-action="Services"
                           class="quick-link">

                            <div>

                                <i class="fa-solid fa-list-check"></i>

                                <span>
                                    View Services
                                </span>

                            </div>

                            <i class="fa-solid fa-chevron-right"></i>

                        </a>


                        <a asp-controller="Public"
                           asp-action="Astrologers"
                           class="quick-link">

                            <div>

                                <i class="fa-solid fa-star"></i>

                                <span>
                                    View Astrologers
                                </span>

                            </div>

                            <i class="fa-solid fa-chevron-right"></i>

                        </a>

                    </div>

                </section>

            </div>

        </div>


        <!-- =====================================================
             HELP CTA
             ===================================================== -->

        <section class="help-panel">

            <div>

                <div class="help-icon">

                    <i class="fa-solid fa-moon"></i>

                </div>

                <div>

                    <span>
                        NEED HELP?
                    </span>

                    <h3>
                        Booking your consultation is simple.
                    </h3>

                    <p>
                        Choose a service, select an astrologer and pick
                        an available appointment time.
                    </p>

                </div>

            </div>


            <a asp-controller="Booking"
               asp-action="Create"
               class="btn help-btn">

                Start Booking

                <i class="fa-solid fa-arrow-right"></i>

            </a>

        </section>

    </div>

</div>


<style>

    /* =====================================================
           PAGE
           ===================================================== */

    .customer-dashboard {
        min-height: 100vh;
        padding: 35px 0 70px;
        background: #f8f5ec;
    }

    .dashboard-container {
        max-width: 1450px;
        padding-left: 28px;
        padding-right: 28px;
    }


    /* =====================================================
           HERO
           ===================================================== */

    .dashboard-hero {
        position: relative;
        overflow: hidden;
        padding: 45px 48px;
        border-radius: 24px;
        background: #181710;
        color: white;
    }

    .hero-content {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
    }

    .hero-label {
        display: block;
        margin-bottom: 10px;
        color: #e1bf4a;
        font-size: .67rem;
        font-weight: 800;
        letter-spacing: .18em;
    }

    .dashboard-hero h1 {
        margin-bottom: 12px;
        font-family: 'DM Serif Display', serif;
        font-size: clamp(2.5rem, 4vw, 3.8rem);
        font-weight: 400;
        line-height: 1;
    }

        .dashboard-hero h1 span {
            color: #e1bf4a;
        }

    .dashboard-hero p {
        max-width: 630px;
        margin: 0;
        color: rgba(255,255,255,.55);
        font-size: .84rem;
        line-height: 1.75;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        flex-shrink: 0;
    }

    .hero-book-btn,
    .hero-profile-btn {
        min-height: 47px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 18px;
        font-size: .75rem;
    }

    .hero-book-btn {
        background: #e1bf4a;
        border: 1px solid #e1bf4a;
        color: #181710;
    }

        .hero-book-btn:hover {
            background: #d3ae32;
            border-color: #d3ae32;
            color: #181710;
        }

    .hero-profile-btn {
        border: 1px solid rgba(255,255,255,.18);
        background: rgba(255,255,255,.04);
        color: white;
    }

        .hero-profile-btn:hover {
            border-color: rgba(255,255,255,.35);
            background: rgba(255,255,255,.09);
            color: white;
        }

    .hero-orbit {
        position: absolute;
        border: 1px solid rgba(225,191,74,.08);
        border-radius: 50%;
    }

    .orbit-one {
        width: 330px;
        height: 330px;
        right: -140px;
        top: -190px;
    }

    .orbit-two {
        width: 230px;
        height: 230px;
        right: 100px;
        bottom: -180px;
    }


    /* =====================================================
           STAT CARDS
           ===================================================== */

    .dashboard-stat-card {
        height: 100%;
        padding: 24px;
        border: 1px solid #e3dccd;
        border-radius: 18px;
        background: #fffdf8;
        transition: all .25s ease;
    }

        .dashboard-stat-card:hover {
            transform: translateY(-4px);
            border-color: #d0ba62;
            box-shadow: 0 16px 35px rgba(39,33,21,.07);
        }

    .stat-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 19px;
    }

    .stat-icon {
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #181710;
        color: #e1bf4a;
        font-size: .9rem;
    }

    .pending-icon {
        background: #fff0ad;
        color: #6a5512;
    }

    .confirmed-icon {
        background: #dceadc;
        color: #426649;
    }

    .notification-icon {
        background: #f2dfdc;
        color: #915048;
    }

    .stat-number {
        color: #181710;
        font-family: 'DM Serif Display', serif;
        font-size: 2.3rem;
        line-height: 1;
    }

    .dashboard-stat-card h5 {
        margin-bottom: 5px;
        color: #26231d;
        font-size: .86rem;
        font-weight: 800;
    }

    .dashboard-stat-card p {
        margin-bottom: 12px;
        color: #8a8479;
        font-size: .7rem;
    }

    .dashboard-stat-card a,
    .stat-note {
        color: #8a6c0c;
        font-size: .67rem;
        font-weight: 800;
        text-decoration: none;
    }

        .dashboard-stat-card a i {
            margin-left: 3px;
            font-size: .55rem;
        }

