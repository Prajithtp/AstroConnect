@section Scripts
{
    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const searchInput =
                document.getElementById("serviceSearch");

            const desktopRows =
                document.querySelectorAll("#serviceTable tbody tr");

            const mobileCards =
                document.querySelectorAll("#mobileServiceList .mobile-service-card");

            const visibleCount =
                document.getElementById("visibleServiceCount");

            const filterEmpty =
                document.getElementById("serviceFilterEmpty");


            function filterServices() {

                const search =
                    searchInput.value
                        .toLowerCase()
                        .trim();

                let count = 0;


                desktopRows.forEach(function (row) {

                    const match =
                        row.innerText
                           .toLowerCase()
                           .includes(search);

                    row.style.display =
                        match ? "" : "none";

                    if (match) {
                        count++;
                    }

                });


                mobileCards.forEach(function (card) {

                    const match =
                        card.innerText
                            .toLowerCase()
                            .includes(search);

                    card.style.display =
                        match ? "" : "none";

                });


                if (visibleCount) {
                    visibleCount.textContent = count;
                }


                if (filterEmpty) {

                    filterEmpty.style.display =
                        count === 0
                            ? "block"
                            : "none";

                }

            }


            if (searchInput) {

                searchInput.addEventListener(
                    "keyup",
                    filterServices
                );

            }

        });

    </script>
}