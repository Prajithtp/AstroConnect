@model List<AstroConnect.Domain.Entities.Service>

@{
    ViewData["Title"] = "Services";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="fw-bold">
            <i class="fa-solid fa-briefcase text-primary"></i>
            Services
        </h2>

        <p class="text-muted mb-0">
            Manage astrology consultation services
        </p>

    </div>

    <a asp-action="Create" class="btn btn-primary">

        <i class="fa-solid fa-plus"></i>

        Add Service

    </a>

</div>

<div class="card shadow-sm border-0 mb-4">

    <div class="card-body">

        <input type="text"
               id="serviceSearch"
               class="form-control"
               placeholder="🔍 Search by service name or description">

    </div>

</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No services found.
    </div>
}
else
{
    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle" id="serviceTable">

                    <thead class="table-dark">

                        <tr>
                            <th>Service</th>
                            <th>Description</th>
                            <th>Price</th>
                            <th>Duration</th>
                            <th class="text-center">Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var service in Model)
                        {
                            <tr>

                                <td>

                                    <strong>@service.Name</strong>

                                </td>

                                <td>

                                    @service.Description

                                </td>

                                <td>

                                    <span class="badge bg-success fs-6">

                                        ₹ @service.Price.ToString("N2")

                                    </span>

                                </td>

                                <td>

                                    <span class="badge bg-info text-dark">

                                        @service.DurationInMinutes Minutes

                                    </span>

                                </td>

                                <td class="text-center">

                                    <a asp-action="Edit"
                                       asp-route-id="@service.Id"
                                       class="btn btn-warning btn-sm action-btn me-1"
                                       title="Edit Service">

                                        <i class="fa-solid fa-pen"></i>

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@service.Id"
                                       class="btn btn-danger btn-sm action-btn"
                                       title="Delete Service">

                                        <i class="fa-solid fa-trash"></i>

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
}

@section Scripts {

    <script>

        document.getElementById("serviceSearch")
        .addEventListener("keyup", function () {

            let value = this.value.toLowerCase();

            let rows = document.querySelectorAll("#serviceTable tbody tr");

            rows.forEach(function (row) {

                row.style.display =
                    row.innerText.toLowerCase().includes(value)
                    ? ""
                    : "none";

            });

        });

    </script>

}