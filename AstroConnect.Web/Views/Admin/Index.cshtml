@{
    ViewData["Title"] = "Admin Dashboard";
}

<section class="admin-dashboard-page">

    <div class="container-fluid admin-dashboard-container">

        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="dashboard-header">

            <div>

                <span class="section-label">
                    ADMIN CONTROL CENTER
                </span>

                <h1>
                    Admin Dashboard
                </h1>

                <p>
                    Monitor AstroConnect activity, appointments,
                    users and system resources from one place.
                </p>

            </div>


            <div class="admin-role">

                <div class="admin-role-icon">
                    <i class="fa-solid fa-user-shield"></i>
                </div>

                <div>
                    <span>LOGGED IN AS</span>
                    <strong>Administrator</strong>
                </div>

            </div>

        </div>


        <!-- =====================================================
             MAIN STATISTICS
             ===================================================== -->

        <div class="row g-3 mb-4">

            <!-- CUSTOMERS -->

            <div class="col-md-6 col-xl-3">

                <div class="stat-card">

                    <div class="stat-top">

                        <div class="stat-icon">
                            <i class="fa-solid fa-users"></i>
                        </div>

                        <span class="stat-label">
                            CUSTOMERS
                        </span>

                    </div>

                    <h2>
                        @ViewBag.TotalCustomers
                    </h2>

                    <h3>
                        Registered Customers
                    </h3>

                    <p>
                        Customer accounts available in the system.
                    </p>

                    <a asp-controller="Customer"
                       asp-action="Index">

                        View Customers

                        <i class="fa-solid fa-arrow-right"></i>

                    </a>

                </div>

            </div>


            <!-- ASTROLOGERS -->

            <div class="col-md-6 col-xl-3">

                <div class="stat-card">

                    <div class="stat-top">

                        <div class="stat-icon stat-icon-gold">
                            <i class="fa-solid fa-star"></i>
                        </div>

                        <span class="stat-label">
                            ASTROLOGERS
                        </span>

                    </div>

                    <h2>
                        @ViewBag.TotalAstrologers
                    </h2>

                    <h3>
                        Astrologers
                    </h3>

                    <p>
                        Astrologer profiles registered in AstroConnect.
                    </p>

                    <a asp-controller="Astrologer"
                       asp-action="Index">

                        View Astrologers

                        <i class="fa-solid fa-arrow-right"></i>

                    </a>

                </div>

            </div>


            <!-- SERVICES -->

            <div class="col-md-6 col-xl-3">

                <div class="stat-card">

                    <div class="stat-top">

                        <div class="stat-icon stat-icon-soft">
                            <i class="fa-solid fa-list-check"></i>
                        </div>

                        <span class="stat-label">
                            SERVICES
                        </span>

                    </div>

                    <h2>
                        @ViewBag.TotalServices
                    </h2>

                    <h3>
                        Consultation Services
                    </h3>

                    <p>
                        Astrology consultation services currently available.
                    </p>

                    <a asp-controller="Service"
                       asp-action="Index">

                        View Services

                        <i class="fa-solid fa-arrow-right"></i>

                    </a>

                </div>

            </div>


            <!-- BOOKINGS -->

            <div class="col-md-6 col-xl-3">

                <div class="stat-card">

                    <div class="stat-top">

                        <div class="stat-icon stat-icon-green">
                            <i class="fa-solid fa-calendar-days"></i>
                        </div>

                        <span class="stat-label">
                            BOOKINGS
                        </span>

                    </div>

                    <h2>
                        @ViewBag.TotalBookings
                    </h2>

                    <h3>
                        Total Bookings
                    </h3>

                    <p>
                        All appointment records created in the system.
                    </p>

                    <a asp-controller="Booking"
                       asp-action="Index">

                        View Bookings

                        <i class="fa-solid fa-arrow-right"></i>

                    </a>

                </div>

            </div>

        </div>


        <!-- =====================================================
             QUICK ACTIONS
             ===================================================== -->

        <div class="section-heading">

            <div>

                <span class="section-label">
                    QUICK ACTIONS
                </span>

                <h2>
                    System Management
                </h2>

            </div>

        </div>


        <div class="row g-3 mb-4">

            <!-- USERS -->

            <div class="col-md-6 col-xl-3">

                <a asp-controller="User"
                   asp-action="Index"
                   class="quick-action-card">

                    <div class="quick-action-icon">

                        <i class="fa-solid fa-users-gear"></i>

                    </div>

                    <div class="quick-action-content">

                        <span>
                            ACCOUNTS
                        </span>

                        <h3>
                            User Management
                        </h3>

                        <p>
                            Manage user accounts and application roles.
                        </p>

                    </div>

                    <div class="quick-arrow">

                        <i class="fa-solid fa-arrow-right"></i>

                    </div>

                </a>

            </div>


            <!-- NEW BOOKING -->

            <div class="col-md-6 col-xl-3">

                <a asp-controller="Booking"
                   asp-action="Create"
                   class="quick-action-card quick-action-dark">

                    <div class="quick-action-icon">

                        <i class="fa-solid fa-calendar-plus"></i>

                    </div>

                    <div class="quick-action-content">

                        <span>
                            CREATE
                        </span>

                        <h3>
                            New Booking
                        </h3>

                        <p>
                            Schedule a new customer consultation.
                        </p>

                    </div>

                    <div class="quick-arrow">

                        <i class="fa-solid fa-arrow-right"></i>

                    </div>

                </a>

            </div>


            <!-- CUSTOMERS -->

            <div class="col-md-6 col-xl-3">

                <a asp-controller="Customer"
                   asp-action="Index"
                   class="quick-action-card">

                    <div class="quick-action-icon">

                        <i class="fa-solid fa-users"></i>

                    </div>

                    <div class="quick-action-content">

                        <span>
                            CUSTOMERS
                        </span>

                        <h3>
                            Customer Records
                        </h3>

                        <p>
                            Review and manage registered customers.
                        </p>

                    </div>

                    <div class="quick-arrow">

                        <i class="fa-solid fa-arrow-right"></i>

                    </div>

                </a>

            </div>


            <!-- BOOKINGS -->

            <div class="col-md-6 col-xl-3">

                <a asp-controller="Booking"
                   asp-action="Index"
                   class="quick-action-card">

                    <div class="quick-action-icon">

                        <i class="fa-solid fa-calendar-days"></i>

                    </div>

                    <div class="quick-action-content">

                        <span>
                            APPOINTMENTS
                        </span>

                        <h3>
                            Booking Management
                        </h3>

                        <p>
                            Review all appointments and booking statuses.
                        </p>

                    </div>

                    <div class="quick-arrow">

                        <i class="fa-solid fa-arrow-right"></i>

                    </div>

                </a>

            </div>

        </div>


        <!-- =====================================================
             TODAY'S APPOINTMENTS
             ===================================================== -->

        <section class="dashboard-panel mb-4">

            <div class="panel-header">

                <div class="panel-heading-main">

                    <div class="panel-icon">

                        <i class="fa-solid fa-calendar-day"></i>

                    </div>

                    <div>

                        <span>
                            TODAY'S SCHEDULE
                        </span>

                        <h2>
                            Today's Appointments
                        </h2>

                        <p>
                            Consultations scheduled for today.
                        </p>

                    </div>

                </div>


                <div class="panel-count">

                    <strong>
                        @ViewBag.TodayBookings
                    </strong>

                    <span>
                        Today
                    </span>

                </div>

            </div>


            @if (ViewBag.TodayAppointmentList != null &&
                        ViewBag.TodayAppointmentList.Count > 0)
            {
                <div class="table-responsive">

                    <table class="table admin-table align-middle">

                        <thead>

                            <tr>

                                <th>Time</th>

                                <th>Customer</th>

                                <th>Astrologer</th>

                                <th>Service</th>

                                <th>Status</th>

                                <th class="text-end">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var booking in ViewBag.TodayAppointmentList)
                            {
                                <tr>

                                    <!-- TIME -->

                                    <td>

                                        <div class="time-cell">

                                            <i class="fa-regular fa-clock"></i>

                                            <div>

                                                <strong>
                                                    @booking.StartTime.ToString("hh:mm tt")
                                                </strong>

                                                <span>
                                                    @booking.EndTime.ToString("hh:mm tt")
                                                </span>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- CUSTOMER -->

                                    <td>

                                        <div class="person-cell">

                                            <div class="person-avatar">

                                                <i class="fa-solid fa-user"></i>

                                            </div>

                                            <strong>
                                                @(booking.Customer?.FullName ?? "Unknown")
                                            </strong>

                                        </div>

                                    </td>


                                    <!-- ASTROLOGER -->

                                    <td>

                                        <div class="simple-cell">

                                            <i class="fa-solid fa-star"></i>

                                            <span>
                                                @(booking.Astrologer?.FullName ?? "Unknown")
                                            </span>

                                        </div>

                                    </td>


                                    <!-- SERVICE -->

                                    <td>

                                        <div class="simple-cell">

                                            <i class="fa-solid fa-moon"></i>

                                            <span>
                                                @(booking.Service?.Name ?? "Unknown")
                                            </span>

                                        </div>

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        @if (booking.Status.ToString() == "Pending")
                                        {
                                            <span class="status-badge status-pending">

                                                <span class="status-dot"></span>

                                                Pending

                                            </span>
                                        }
                                        else if (booking.Status.ToString() == "Confirmed")
                                        {
                                            <span class="status-badge status-confirmed">

                                                <span class="status-dot"></span>

                                                Confirmed

                                            </span>
                                        }
                                        else if (booking.Status.ToString() == "Completed")
                                        {
                                            <span class="status-badge status-completed">

                                                <span class="status-dot"></span>

                                                Completed

                                            </span>
                                        }
                                        else if (booking.Status.ToString() == "Cancelled")
                                        {
                                            <span class="status-badge status-cancelled">

                                                <span class="status-dot"></span>

                                                Cancelled

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-default">

                                                <span class="status-dot"></span>

                                                @booking.Status

                                            </span>
                                        }

                                    </td>


                                    <!-- ACTION -->

                                    <td class="text-end">

                                        <a asp-controller="Booking"
                                           asp-action="Details"
                                           asp-route-id="@booking.Id"
                                           class="details-btn"
                                           title="View Booking Details">

                                            <i class="fa-solid fa-eye"></i>

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="empty-state">

                    <div class="empty-icon">

                        <i class="fa-solid fa-calendar-xmark"></i>

                    </div>

                    <span>
                        TODAY'S SCHEDULE
                    </span>

                    <h3>
                        No appointments today.
                    </h3>

                    <p>
                        There are currently no consultations scheduled for today.
                    </p>

                </div>
            }

        </section>


        <!-- =====================================================
             UPCOMING + RECENT
             ===================================================== -->

        <div class="row g-4 mb-4">


            <!-- UPCOMING -->

            <div class="col-lg-6">

                <section class="dashboard-panel h-100">

                    <div class="small-panel-header">

                        <div class="small-panel-icon">

                            <i class="fa-solid fa-calendar-plus"></i>

                        </div>

                        <div>

                            <span>
                                NEXT SCHEDULE
                            </span>

                            <h2>
                                Upcoming Appointments
                            </h2>

                            <p>
                                Next scheduled consultations.
                            </p>

                        </div>

                    </div>


                    @if (ViewBag.UpcomingBookings != null &&
                                        ViewBag.UpcomingBookings.Count > 0)
                    {
                        <div class="booking-list">

                            @foreach (var booking in ViewBag.UpcomingBookings)
                            {
                                <div class="booking-list-item">

                                    <div class="booking-main">

                                        <div class="booking-date-box">

                                            <span>
                                                @booking.BookingDate.ToString("dd")
                                            </span>

                                            <strong>
                                                @booking.BookingDate.ToString("MMM")
                                            </strong>

                                        </div>


                                        <div>

                                            <h4>
                                                @(booking.Customer?.FullName ?? "Unknown")
                                            </h4>

                                            <p>

                                                <i class="fa-regular fa-clock"></i>

                                                @booking.StartTime.ToString("hh:mm tt")
                                                -
                                                @booking.EndTime.ToString("hh:mm tt")

                                            </p>

                                            @if (booking.Service != null)
                                            {
                                                <span class="service-pill">

                                                    <i class="fa-solid fa-moon"></i>

                                                    @booking.Service.Name

                                                </span>
                                            }

                                        </div>

                                    </div>


                                    <div class="booking-side">

                                        <span class="astrologer-name">

                                            <i class="fa-solid fa-star"></i>

                                            @(booking.Astrologer?.FullName ?? "Unknown")

                                        </span>


                                        @if (booking.Status.ToString() == "Pending")
                                        {
                                            <span class="status-badge status-pending">

                                                <span class="status-dot"></span>

                                                Pending

                                            </span>
                                        }
                                        else if (booking.Status.ToString() == "Confirmed")
                                        {
                                            <span class="status-badge status-confirmed">

                                                <span class="status-dot"></span>

                                                Confirmed

                                            </span>
                                        }


                                        <a asp-controller="Booking"
                                           asp-action="Details"
                                           asp-route-id="@booking.Id"
                                           class="small-details-btn">

                                            Details

                                            <i class="fa-solid fa-arrow-right"></i>

                                        </a>

                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="small-empty-state">

                            <div class="empty-icon">

                                <i class="fa-solid fa-calendar-check"></i>

                            </div>

                            <h3>
                                No upcoming appointments
                            </h3>

                            <p>
                                There are currently no upcoming consultations.
                            </p>

                        </div>
                    }

                </section>

            </div>


            <!-- RECENT -->

            <div class="col-lg-6">

                <section class="dashboard-panel h-100">

                    <div class="small-panel-header">

                        <div class="small-panel-icon">

                            <i class="fa-solid fa-clock-rotate-left"></i>

                        </div>

                        <div>

                            <span>
                                RECENT ACTIVITY
                            </span>

                            <h2>
                                Recent Bookings
                            </h2>

                            <p>
                                Latest appointment activity in AstroConnect.
                            </p>

                        </div>

                    </div>


                    @if (ViewBag.RecentBookings != null &&
                                        ViewBag.RecentBookings.Count > 0)
                    {
                        <div class="booking-list">

                            @foreach (var booking in ViewBag.RecentBookings)
                            {
                                <div class="booking-list-item">

                                    <div class="booking-main">

                                        <div class="recent-icon">

                                            <i class="fa-solid fa-calendar-check"></i>

                                        </div>

                                        <div>

                                            <h4>
                                                @(booking.Customer?.FullName ?? "Unknown")
                                            </h4>

                                            <p>

                                                @(booking.Service?.Name ?? "Unknown")

                                                <span class="bullet">
                                                    •
                                                </span>

                                                @booking.BookingDate.ToString("dd MMM yyyy")

                                            </p>

                                        </div>

                                    </div>


                                    <div class="booking-side">

                                        @if (booking.Status.ToString() == "Pending")
                                        {
                                            <span class="status-badge status-pending">

                                                <span class="status-dot"></span>

                                                Pending

                                            </span>
                                        }
                                        else if (booking.Status.ToString() == "Confirmed")
                                        {
                                            <span class="status-badge status-confirmed">

                                                <span class="status-dot"></span>

                                                Confirmed

                                            </span>
                                        }
                                        else if (booking.Status.ToString() == "Completed")
                                        {
                                            <span class="status-badge status-completed">

                                                <span class="status-dot"></span>

                                                Completed

                                            </span>
                                        }
                                        else if (booking.Status.ToString() == "Cancelled")
                                        {
                                            <span class="status-badge status-cancelled">

                                                <span class="status-dot"></span>

                                                Cancelled

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-default">

                                                <span class="status-dot"></span>

                                                @booking.Status

                                            </span>
                                        }


                                        <a asp-controller="Booking"
                                           asp-action="Details"
                                           asp-route-id="@booking.Id"
                                           class="small-details-btn">

                                            Details

                                            <i class="fa-solid fa-arrow-right"></i>

                                        </a>

                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="small-empty-state">

                            <div class="empty-icon">

                                <i class="fa-solid fa-calendar-xmark"></i>

                            </div>

                            <h3>
                                No recent bookings
                            </h3>

                            <p>
                                No appointments have been created yet.
                            </p>

                        </div>
                    }

                </section>

            </div>

        </div>


        <!-- =====================================================
             BOOKING OVERVIEW
             ===================================================== -->

        <section class="overview-panel">

            <div class="overview-heading">

                <div>

                    <span>
                        BOOKING STATUS
                    </span>

                    <h2>
                        Booking Overview
                    </h2>

                    <p>
                        Current appointment distribution across the system.
                    </p>

                </div>


                <div class="overview-heading-icon">

                    <i class="fa-solid fa-chart-pie"></i>

                </div>

            </div>


            <div class="row g-3">

                <!-- PENDING -->

                <div class="col-md-6 col-xl-3">

                    <div class="overview-card">

                        <div class="overview-icon pending-overview">

                            <i class="fa-solid fa-clock"></i>

                        </div>

                        <div>

                            <span>
                                PENDING
                            </span>

                            <strong>
                                @ViewBag.PendingBookings
                            </strong>

                            <p>
                                Awaiting confirmation
                            </p>

                        </div>

                    </div>

                </div>


                <!-- CONFIRMED -->

                <div class="col-md-6 col-xl-3">

                    <div class="overview-card">

                        <div class="overview-icon confirmed-overview">

                            <i class="fa-solid fa-circle-check"></i>

                        </div>

                        <div>

                            <span>
                                CONFIRMED
                            </span>

                            <strong>
                                @ViewBag.ConfirmedBookings
                            </strong>

                            <p>
                                Ready for consultation
                            </p>

                        </div>

                    </div>

                </div>


                <!-- COMPLETED -->

                <div class="col-md-6 col-xl-3">

                    <div class="overview-card">

                        <div class="overview-icon completed-overview">

                            <i class="fa-solid fa-check-double"></i>

                        </div>

                        <div>

                            <span>
                                COMPLETED
                            </span>

                            <strong>
                                @ViewBag.CompletedBookings
                            </strong>

                            <p>
                                Finished consultations
                            </p>

                        </div>

                    </div>

                </div>


                <!-- CANCELLED -->

                <div class="col-md-6 col-xl-3">

                    <div class="overview-card">

                        <div class="overview-icon cancelled-overview">

                            <i class="fa-solid fa-circle-xmark"></i>

                        </div>

                        <div>

                            <span>
                                CANCELLED
                            </span>

                            <strong>
                                @ViewBag.CancelledBookings
                            </strong>

                            <p>
                                Cancelled appointments
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- =====================================================
             FOOTER CTA
             ===================================================== -->

        <section class="admin-footer">

            <div>

                <div class="footer-icon">

                    <i class="fa-solid fa-shield-halved"></i>

                </div>

                <div>

                    <span>
                        ADMINISTRATION
                    </span>

                    <h3>
                        Manage your AstroConnect system.
                    </h3>

                    <p>
                        Review users, appointments and master data
                        from the administration tools.
                    </p>

                </div>

            </div>


            <a asp-controller="User"
               asp-action="Index"
               class="footer-btn">

                User Management

                <i class="fa-solid fa-arrow-right"></i>

            </a>

        </section>

    </div>

</section>


<style>

    /* =====================================================
           PAGE
           ===================================================== */

    .admin-dashboard-page {
        min-height: 100vh;
        padding: 45px 0 80px;
        background: #f8f5ec;
    }

    .admin-dashboard-container {
        max-width: 1500px;
        padding-left: 28px;
        padding-right: 28px;
    }


    /* =====================================================
           HEADER
           ===================================================== */

    .dashboard-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 30px;
        margin-bottom: 32px;
    }

    .section-label {
        display: block;
        margin-bottom: 8px;
        color: #987918;
        font-size: .63rem;
        font-weight: 800;
        letter-spacing: .17em;
    }

    .dashboard-header h1 {
        margin-bottom: 8px;
        color: #181710;
        font-family: 'DM Serif Display', serif;
        font-size: clamp(2.5rem, 4vw, 3.8rem);
        font-weight: 400;
        line-height: 1;
    }

    .dashboard-header p {
        max-width: 640px;
        margin: 0;
        color: #817b70;
        font-size: .8rem;
        line-height: 1.7;
    }

    .admin-role {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 180px;
        padding: 11px 14px;
        border: 1px solid #ddd3c0;
        border-radius: 13px;
        background: #fffdf8;
    }

    .admin-role-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 50%;
        background: #181710;
        color: #e1bf4a;
        font-size: .7rem;
    }

    .admin-role span,
    .admin-role strong {
        display: block;
    }

    .admin-role span {
        margin-bottom: 1px;
        color: #9b9386;
        font-size: .47rem;
        font-weight: 800;
        letter-spacing: .09em;
    }

    .admin-role strong {
        color: #302c25;
        font-size: .69rem;
    }


    /* =====================================================
           STAT CARDS
           ===================================================== */

    .stat-card {
        height: 100%;
        padding: 22px;
        border: 1px solid #e2dacb;
        border-radius: 17px;
        background: #fffdf8;
        transition: all .22s ease;
    }

        .stat-card:hover {
            transform: translateY(-3px);
            border-color: #d4bd67;
            box-shadow: 0 12px 28px rgba(40,34,22,.05);
        }

    .stat-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
    }

    .stat-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #181710;
        color: #e1bf4a;
        font-size: .7rem;
    }

    .stat-icon-gold {
        background: #fff0ad;
        color: #725c12;
    }

    .stat-icon-soft {
        background: #ece7de;
        color: #6e675c;
    }

    .stat-icon-green {
        background: #e0ecdf;
