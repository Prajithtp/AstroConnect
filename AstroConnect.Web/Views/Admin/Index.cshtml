@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid py-4">

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="fa-solid fa-gauge-high text-primary me-2"></i>
                Admin Dashboard
            </h2>

            <p class="text-muted mb-0">
                Overview of your AstroConnect system.
            </p>
        </div>

        <span class="badge bg-dark px-3 py-2 mt-3 mt-md-0">
            <i class="fa-solid fa-user-shield me-1"></i>
            Administrator
        </span>

    </div>


    <!-- =====================================================
         MAIN STATISTICS
         ===================================================== -->

    <div class="row g-4 mb-4">

        <!-- CUSTOMERS -->

        <div class="col-md-6 col-xl-3">

            <div class="card dashboard-card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-1">
                                Customers
                            </p>

                            <h2 class="fw-bold mb-0">
                                @ViewBag.TotalCustomers
                            </h2>
                        </div>

                        <div class="icon-box bg-primary-subtle text-primary">
                            <i class="fa-solid fa-users"></i>
                        </div>

                    </div>

                    <a asp-controller="Customer"
                       asp-action="Index"
                       class="small text-decoration-none">

                        View Customers →

                    </a>

                </div>

            </div>

        </div>


        <!-- ASTROLOGERS -->

        <div class="col-md-6 col-xl-3">

            <div class="card dashboard-card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-1">
                                Astrologers
                            </p>

                            <h2 class="fw-bold mb-0">
                                @ViewBag.TotalAstrologers
                            </h2>
                        </div>

                        <div class="icon-box bg-info-subtle text-info">
                            <i class="fa-solid fa-star"></i>
                        </div>

                    </div>

                    <a asp-controller="Astrologer"
                       asp-action="Index"
                       class="small text-decoration-none">

                        View Astrologers →

                    </a>

                </div>

            </div>

        </div>


        <!-- SERVICES -->

        <div class="col-md-6 col-xl-3">

            <div class="card dashboard-card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-1">
                                Services
                            </p>

                            <h2 class="fw-bold mb-0">
                                @ViewBag.TotalServices
                            </h2>
                        </div>

                        <div class="icon-box bg-warning-subtle text-warning">
                            <i class="fa-solid fa-list-check"></i>
                        </div>

                    </div>

                    <a asp-controller="Service"
                       asp-action="Index"
                       class="small text-decoration-none">

                        View Services →

                    </a>

                </div>

            </div>

        </div>


        <!-- BOOKINGS -->

        <div class="col-md-6 col-xl-3">

            <div class="card dashboard-card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-1">
                                Total Bookings
                            </p>

                            <h2 class="fw-bold mb-0">
                                @ViewBag.TotalBookings
                            </h2>
                        </div>

                        <div class="icon-box bg-success-subtle text-success">
                            <i class="fa-solid fa-calendar-days"></i>
                        </div>

                    </div>

                    <a asp-controller="Booking"
                       asp-action="Index"
                       class="small text-decoration-none">

                        View Bookings →

                    </a>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         QUICK ACTIONS
         ===================================================== -->

    <div class="row g-3 mb-4">

        <div class="col-md-6 col-xl-3">

            <a asp-controller="User"
               asp-action="Index"
               class="text-decoration-none">

                <div class="quick-action-card shadow-sm">

                    <div class="quick-action-icon bg-dark">

                        <i class="fa-solid fa-users-gear"></i>

                    </div>

                    <div>

                        <h6 class="fw-bold mb-1">
                            User Management
                        </h6>

                        <small class="text-muted">
                            Manage roles and accounts
                        </small>

                    </div>

                </div>

            </a>

        </div>


        <div class="col-md-6 col-xl-3">

            <a asp-controller="Booking"
               asp-action="Create"
               class="text-decoration-none">

                <div class="quick-action-card shadow-sm">

                    <div class="quick-action-icon bg-success">

                        <i class="fa-solid fa-calendar-plus"></i>

                    </div>

                    <div>

                        <h6 class="fw-bold mb-1">
                            New Booking
                        </h6>

                        <small class="text-muted">
                            Create appointment
                        </small>

                    </div>

                </div>

            </a>

        </div>


        <div class="col-md-6 col-xl-3">

            <a asp-controller="Customer"
               asp-action="Index"
               class="text-decoration-none">

                <div class="quick-action-card shadow-sm">

                    <div class="quick-action-icon bg-primary">

                        <i class="fa-solid fa-users"></i>

                    </div>

                    <div>

                        <h6 class="fw-bold mb-1">
                            Customers
                        </h6>

                        <small class="text-muted">
                            Manage customer records
                        </small>

                    </div>

                </div>

            </a>

        </div>


        <div class="col-md-6 col-xl-3">

            <a asp-controller="Booking"
               asp-action="Index"
               class="text-decoration-none">

                <div class="quick-action-card shadow-sm">

                    <div class="quick-action-icon bg-warning text-dark">

                        <i class="fa-solid fa-calendar-days"></i>

                    </div>

                    <div>

                        <h6 class="fw-bold mb-1">
                            Booking Management
                        </h6>

                        <small class="text-muted">
                            Review all bookings
                        </small>

                    </div>

                </div>

            </a>

        </div>

    </div>


    <!-- =====================================================
         TODAY'S APPOINTMENTS
         ===================================================== -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>

                    <h5 class="fw-bold mb-1">

                        <i class="fa-solid fa-calendar-day text-primary me-1"></i>

                        Today's Appointments

                    </h5>

                    <p class="text-muted mb-0 small">
                        Appointments scheduled for today
                    </p>

                </div>

                <span class="badge bg-primary rounded-pill px-3 py-2">

                    @ViewBag.TodayBookings Today

                </span>

            </div>


            @if (ViewBag.TodayAppointmentList != null &&
                        ViewBag.TodayAppointmentList.Count > 0)
            {

                <div class="table-responsive">

                    <table class="table align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>Time</th>
                                <th>Customer</th>
                                <th>Astrologer</th>
                                <th>Service</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var booking in ViewBag.TodayAppointmentList)
                            {

                                <tr>

                                    <td>

                                        <span class="fw-semibold">

                                            @booking.StartTime.ToString("hh:mm tt")

                                        </span>

                                        <span class="text-muted">

                                            -
                                            @booking.EndTime.ToString("hh:mm tt")

                                        </span>

                                    </td>


                                    <td>

                                        <span class="fw-semibold">

                                            @(booking.Customer?.FullName ?? "Unknown")

                                        </span>

                                    </td>


                                    <td>

                                        @(booking.Astrologer?.FullName ?? "Unknown")

                                    </td>


                                    <td>

                                        @(booking.Service?.Name ?? "Unknown")

                                    </td>


                                    <td>

                                        @if (booking.Status.ToString() == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                        else if (booking.Status.ToString() == "Confirmed")
                                        {
                                            <span class="badge bg-success">
                                                Confirmed
                                            </span>
                                        }
                                        else if (booking.Status.ToString() == "Completed")
                                        {
                                            <span class="badge bg-primary">
                                                Completed
                                            </span>
                                        }
                                        else if (booking.Status.ToString() == "Cancelled")
                                        {
                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @booking.Status
                                            </span>
                                        }

                                    </td>


                                    <td class="text-end">

                                        <a asp-controller="Booking"
                                           asp-action="Details"
                                           asp-route-id="@booking.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="View Booking Details">

                                            <i class="fa-solid fa-eye"></i>

                                        </a>

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            }
            else
            {

                <div class="text-center py-5">

                    <i class="fa-solid fa-calendar-xmark text-muted empty-icon"></i>

                    <h6 class="fw-bold mt-3">
                        No appointments today
                    </h6>

                    <p class="text-muted mb-0">
                        There are no appointments scheduled for today.
                    </p>

                </div>

            }

        </div>

    </div>


    <!-- =====================================================
         UPCOMING + RECENT
         ===================================================== -->

    <div class="row g-4 mb-4">


        <!-- UPCOMING -->

        <div class="col-lg-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div>

                            <h5 class="fw-bold mb-1">

                                <i class="fa-solid fa-calendar-plus text-success me-1"></i>

                                Upcoming Appointments

                            </h5>

                            <p class="text-muted small mb-0">
                                Next scheduled appointments
                            </p>

                        </div>

                    </div>


                    @if (ViewBag.UpcomingBookings != null &&
                                        ViewBag.UpcomingBookings.Count > 0)
                    {

                        <div class="list-group list-group-flush">

                            @foreach (var booking in ViewBag.UpcomingBookings)
                            {

                                <div class="list-group-item px-0 py-3">

                                    <div class="d-flex justify-content-between align-items-start gap-3">

                                        <div>

                                            <div class="fw-bold">

                                                @booking.BookingDate.ToString("dd MMM yyyy")

                                            </div>

                                            <div class="text-muted small">

                                                @booking.StartTime.ToString("hh:mm tt")
                                                -
                                                @booking.EndTime.ToString("hh:mm tt")

                                            </div>

                                            @if (booking.Service != null)
                                            {

                                                <span class="badge bg-light text-dark border mt-2">

                                                    <i class="fa-solid fa-star me-1"></i>

                                                    @booking.Service.Name

                                                </span>

                                            }

                                        </div>


                                        <div class="text-end">

                                            <div class="fw-semibold">

                                                @(booking.Customer?.FullName ?? "Unknown")

                                            </div>

                                            <div class="text-muted small mb-2">

                                                @(booking.Astrologer?.FullName ?? "Unknown")

                                            </div>


                                            @if (booking.Status.ToString() == "Pending")
                                            {

                                                <span class="badge bg-warning text-dark">
                                                    Pending
                                                </span>

                                            }
                                            else if (booking.Status.ToString() == "Confirmed")
                                            {

                                                <span class="badge bg-success">
                                                    Confirmed
                                                </span>

                                            }


                                            <div class="mt-2">

                                                <a asp-controller="Booking"
                                                   asp-action="Details"
                                                   asp-route-id="@booking.Id"
                                                   class="btn btn-sm btn-outline-primary">

                                                    <i class="fa-solid fa-eye me-1"></i>
                                                    Details

                                                </a>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            }

                        </div>

                    }
                    else
                    {

                        <div class="text-center py-5">

                            <i class="fa-solid fa-calendar-check text-muted empty-icon"></i>

                            <h6 class="fw-bold mt-3">
                                No upcoming appointments
                            </h6>

                            <p class="text-muted mb-0">
                                There are no upcoming appointments.
                            </p>

                        </div>

                    }

                </div>

            </div>

        </div>


        <!-- RECENT -->

        <div class="col-lg-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div>

                            <h5 class="fw-bold mb-1">

                                <i class="fa-solid fa-clock-rotate-left text-info me-1"></i>

                                Recent Bookings

                            </h5>

                            <p class="text-muted small mb-0">
                                Latest bookings in the system
                            </p>

                        </div>

                    </div>


                    @if (ViewBag.RecentBookings != null &&
                                        ViewBag.RecentBookings.Count > 0)
                    {

                        <div class="list-group list-group-flush">

                            @foreach (var booking in ViewBag.RecentBookings)
                            {

                                <div class="list-group-item px-0 py-3">

                                    <div class="d-flex justify-content-between align-items-center gap-3">

                                        <div>

                                            <div class="fw-semibold">

                                                @(booking.Customer?.FullName ?? "Unknown")

                                            </div>

                                            <div class="text-muted small">

                                                @(booking.Service?.Name ?? "Unknown")

                                                •

                                                @booking.BookingDate.ToString("dd MMM yyyy")

                                            </div>

                                        </div>


                                        <div class="text-end">

                                            @if (booking.Status.ToString() == "Pending")
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    Pending
                                                </span>
                                            }
                                            else if (booking.Status.ToString() == "Confirmed")
                                            {
                                                <span class="badge bg-success">
                                                    Confirmed
                                                </span>
                                            }
                                            else if (booking.Status.ToString() == "Completed")
                                            {
                                                <span class="badge bg-primary">
                                                    Completed
                                                </span>
                                            }
                                            else if (booking.Status.ToString() == "Cancelled")
                                            {
                                                <span class="badge bg-danger">
                                                    Cancelled
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">
                                                    @booking.Status
                                                </span>
                                            }


                                            <div class="mt-2">

                                                <a asp-controller="Booking"
                                                   asp-action="Details"
                                                   asp-route-id="@booking.Id"
                                                   class="btn btn-sm btn-outline-primary">

                                                    <i class="fa-solid fa-eye me-1"></i>
                                                    Details

                                                </a>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            }

                        </div>

                    }
                    else
                    {

                        <div class="text-center py-5">

                            <i class="fa-solid fa-calendar-xmark text-muted empty-icon"></i>

                            <h6 class="fw-bold mt-3">
                                No recent bookings
                            </h6>

                            <p class="text-muted mb-0">
                                No bookings have been created yet.
                            </p>

                        </div>

                    }

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         BOOKING OVERVIEW
         ===================================================== -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <h5 class="fw-bold mb-4">

                <i class="fa-solid fa-chart-pie text-primary me-1"></i>

                Booking Overview

            </h5>


            <div class="row g-4">


                <div class="col-md-6 col-xl-3">

                    <div class="status-card pending">

                        <div class="status-icon">

                            <i class="fa-solid fa-clock"></i>

                        </div>

                        <div>

                            <h4 class="fw-bold mb-0">
                                @ViewBag.PendingBookings
                            </h4>

                            <span>
                                Pending
                            </span>

                        </div>

                    </div>

                </div>


                <div class="col-md-6 col-xl-3">

                    <div class="status-card confirmed">

                        <div class="status-icon">

                            <i class="fa-solid fa-circle-check"></i>

                        </div>

                        <div>

                            <h4 class="fw-bold mb-0">
                                @ViewBag.ConfirmedBookings
                            </h4>

                            <span>
                                Confirmed
                            </span>

                        </div>

                    </div>

                </div>


                <div class="col-md-6 col-xl-3">

                    <div class="status-card completed">

                        <div class="status-icon">

                            <i class="fa-solid fa-check-double"></i>

                        </div>

                        <div>

                            <h4 class="fw-bold mb-0">
                                @ViewBag.CompletedBookings
                            </h4>

                            <span>
                                Completed
                            </span>

                        </div>

                    </div>

                </div>


                <div class="col-md-6 col-xl-3">

                    <div class="status-card cancelled">

                        <div class="status-icon">

                            <i class="fa-solid fa-circle-xmark"></i>

                        </div>

                        <div>

                            <h4 class="fw-bold mb-0">
                                @ViewBag.CancelledBookings
                            </h4>

                            <span>
                                Cancelled
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<style>

    .dashboard-card {
        border-radius: 16px;
        transition: .25s;
    }

        .dashboard-card:hover {
            transform: translateY(-5px);
        }

    .icon-box {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }


    /* QUICK ACTIONS */

    .quick-action-card {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 18px;
        border-radius: 14px;
        background: white;
        color: #212529;
        transition: .25s;
        height: 100%;
    }

        .quick-action-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(0,0,0,.10) !important;
        }

    .quick-action-icon {
        width: 46px;
        height: 46px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        flex-shrink: 0;
    }


    /* STATUS */

    .status-card {
        padding: 20px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        gap: 15px;
        height: 100%;
    }

    .status-icon {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .pending {
        background: #fff3cd;
    }

        .pending .status-icon {
            background: #ffc107;
            color: white;
        }

    .confirmed {
        background: #d1e7dd;
    }

        .confirmed .status-icon {
            background: #198754;
            color: white;
        }

    .completed {
        background: #cfe2ff;
    }

        .completed .status-icon {
            background: #0d6efd;
            color: white;
        }

    .cancelled {
        background: #f8d7da;
    }

        .cancelled .status-icon {
            background: #dc3545;
            color: white;
        }


    /* GENERAL */

    .empty-icon {
        font-size: 40px;
    }

    .table > :not(caption) > * > * {
        padding: 14px 10px;
    }

    .list-group-item {
        border-color: #f0f0f0;
    }

</style>