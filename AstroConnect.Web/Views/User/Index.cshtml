@section Scripts
{
    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const searchInput =
                document.getElementById("userSearch");

            const desktopRows =
                document.querySelectorAll("#userTable tbody tr");

            const mobileCards =
                document.querySelectorAll("#mobileUserList .mobile-user-card");

            const countElement =
                document.getElementById("visibleUserCount");

            const filterEmpty =
                document.getElementById("userFilterEmpty");


            function filterUsers() {

                const value =
                    searchInput.value
                        .toLowerCase()
                        .trim();

                let visibleCount = 0;


                desktopRows.forEach(function (row) {

                    const matches =
                        row.innerText
                           .toLowerCase()
                           .includes(value);

                    row.style.display =
                        matches ? "" : "none";

                    if (matches) {
                        visibleCount++;
                    }

                });


                mobileCards.forEach(function (card) {

                    const matches =
                        card.innerText
                            .toLowerCase()
                            .includes(value);

                    card.style.display =
                        matches ? "" : "none";

                });


                if (countElement) {
                    countElement.textContent = visibleCount;
                }


                if (filterEmpty) {

                    filterEmpty.style.display =
                        visibleCount === 0
                            ? "block"
                            : "none";

                }

            }


            if (searchInput) {

                searchInput.addEventListener(
                    "keyup",
                    filterUsers
                );

            }

        });

    </script>
}