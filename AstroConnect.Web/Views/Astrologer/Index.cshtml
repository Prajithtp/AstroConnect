@model List<AstroConnect.Domain.Entities.Astrologer>

@{
    ViewData["Title"] = "Astrologers";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="fw-bold">
            <i class="fa-solid fa-user-astronaut text-primary"></i>
            Astrologers
        </h2>

        <p class="text-muted mb-0">
            Manage all registered astrologers
        </p>

    </div>

    <a asp-action="Create" class="btn btn-primary">

        <i class="fa-solid fa-user-plus"></i>

        Add Astrologer

    </a>

</div>

<div class="card shadow-sm border-0 mb-4">

    <div class="card-body">

        <input type="text"
               id="astrologerSearch"
               class="form-control"
               placeholder="🔍 Search by name, specialization, language or email">

    </div>

</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No astrologers found.
    </div>
}
else
{
    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle" id="astrologerTable">

                    <thead class="table-dark">

                        <tr>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Experience</th>
                            <th>Specialization</th>
                            <th>Language</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var astrologer in Model)
                        {
                            <tr>

                                <td>
                                    <strong>@astrologer.FullName</strong>
                                </td>

                                <td>@astrologer.Email</td>

                                <td>@astrologer.PhoneNumber</td>

                                <td>
                                    @(astrologer.Experience + " Years")
                                </td>

                                <td>

                                    <span class="badge bg-primary">
                                        @astrologer.Specialization
                                    </span>

                                </td>

                                <td>@astrologer.Language</td>

                                <td>

                                    @if (astrologer.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Inactive
                                        </span>
                                    }

                                </td>

                                <td class="text-center">

                                    <a asp-action="Edit"
                                       asp-route-id="@astrologer.Id"
                                       class="btn btn-warning btn-sm action-btn me-1"
                                       title="Edit Astrologer">

                                        <i class="fa-solid fa-pen"></i>

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@astrologer.Id"
                                       class="btn btn-danger btn-sm action-btn"
                                       title="Delete Astrologer">

                                        <i class="fa-solid fa-trash"></i>

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
}

@section Scripts {

    <script>

        document.getElementById("astrologerSearch")
        .addEventListener("keyup", function () {

            let value = this.value.toLowerCase();

            let rows = document.querySelectorAll("#astrologerTable tbody tr");

            rows.forEach(function (row) {

                row.style.display =
                    row.innerText.toLowerCase().includes(value)
                    ? ""
                    : "none";

            });

        });

    </script>

}