@section Scripts
{
    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const searchInput =
                document.getElementById("astrologerSearch");

            const desktopRows =
                document.querySelectorAll("#astrologerTable tbody tr");

            const mobileCards =
                document.querySelectorAll("#mobileAstrologerList .mobile-astrologer-card");

            const visibleCount =
                document.getElementById("visibleAstrologerCount");

            const filterEmpty =
                document.getElementById("astrologerFilterEmpty");


            function filterAstrologers() {

                const search =
                    searchInput.value
                        .toLowerCase()
                        .trim();

                let count = 0;


                desktopRows.forEach(function (row) {

                    const match =
                        row.innerText
                           .toLowerCase()
                           .includes(search);

                    row.style.display =
                        match ? "" : "none";

                    if (match) {
                        count++;
                    }

                });


                mobileCards.forEach(function (card) {

                    const match =
                        card.innerText
                            .toLowerCase()
                            .includes(search);

                    card.style.display =
                        match ? "" : "none";

                });


                if (visibleCount) {
                    visibleCount.textContent = count;
                }


                if (filterEmpty) {

                    filterEmpty.style.display =
                        count === 0
                            ? "block"
                            : "none";

                }

            }


            if (searchInput) {

                searchInput.addEventListener(
                    "keyup",
                    filterAstrologers
                );

            }

        });

    </script>
}