@model List<AstroConnect.Domain.Entities.Astrologer>

@{
    ViewData["Title"] = "Astrologers";

    var totalAstrologers = Model?.Count ?? 0;
    var activeAstrologers = Model?.Count(x => x.IsActive) ?? 0;
    var inactiveAstrologers = totalAstrologers - activeAstrologers;
}

<section class="astrologer-management-page">

    <div class="container">

        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="page-header">

            <div>

                <span class="section-label">
                    ADMINISTRATION
                </span>

                <h1>
                    Astrologers
                </h1>

                <p>
                    Manage astrologer profiles, professional experience,
                    specializations and account availability.
                </p>

            </div>


            <div class="header-actions">

                <a asp-controller="Admin"
                   asp-action="Index"
                   class="back-btn">

                    <i class="fa-solid fa-arrow-left"></i>

                    Dashboard

                </a>


                <a asp-action="Create"
                   class="add-astrologer-btn">

                    <i class="fa-solid fa-user-plus"></i>

                    Add Astrologer

                </a>

            </div>

        </div>


        <!-- =====================================================
             SUMMARY
             ===================================================== -->

        <section class="astrologer-summary">

            <div class="summary-main">

                <div class="summary-icon">

                    <i class="fa-solid fa-star"></i>

                </div>

                <div>

                    <span>
                        ASTROLOGER OVERVIEW
                    </span>

                    <h2>
                        Consultation Team
                    </h2>

                </div>

            </div>


            <div class="summary-stats">

                <div>

                    <span>
                        TOTAL
                    </span>

                    <strong>
                        @totalAstrologers
                    </strong>

                </div>


                <div class="summary-divider"></div>


                <div>

                    <span>
                        ACTIVE
                    </span>

                    <strong>
                        @activeAstrologers
                    </strong>

                </div>


                <div class="summary-divider"></div>


                <div>

                    <span>
                        INACTIVE
                    </span>

                    <strong>
                        @inactiveAstrologers
                    </strong>

                </div>

            </div>

        </section>


        <!-- =====================================================
             SEARCH
             ===================================================== -->

        <section class="search-card">

            <div class="search-heading">

                <div>

                    <span>
                        FIND ASTROLOGERS
                    </span>

                    <h2>
                        Search Profiles
                    </h2>

                </div>


                <div class="search-heading-icon">

                    <i class="fa-solid fa-magnifying-glass"></i>

                </div>

            </div>


            <div class="search-wrapper">

                <i class="fa-solid fa-magnifying-glass"></i>

                <input type="text"
                       id="astrologerSearch"
                       class="form-control"
                       placeholder="Search by name, specialization, language or email" />

            </div>

        </section>


        <!-- =====================================================
             EMPTY STATE
             ===================================================== -->
        @if (Model == null || !Model.Any())
        {
            <section class="empty-state">

                <div class="empty-icon">

                    <i class="fa-solid fa-star"></i>

                </div>

                <span>
                    ASTROLOGER DIRECTORY
                </span>

                <h2>
                    No astrologers found.
                </h2>

                <p>
                    Add your first astrologer profile to begin
                    assigning consultations.
                </p>


                <a asp-action="Create"
                   class="empty-add-btn">

                    <i class="fa-solid fa-user-plus"></i>

                    Add Astrologer

                </a>

            </section>
        }
        else
        {
            <!-- =================================================
                 LIST
                 ================================================= -->

            <section class="astrologers-card">

                <div class="astrologers-card-header">

                    <div class="astrologers-heading">

                        <div class="astrologers-heading-icon">

                            <i class="fa-solid fa-user-astronaut"></i>

                        </div>

                        <div>

                            <span>
                                ASTROLOGER DIRECTORY
                            </span>

                            <h2>
                                Registered Astrologers
                            </h2>

                            <p>
                                Review professional and consultation information.
                            </p>

                        </div>

                    </div>


                    <div class="record-count">

                        <strong id="visibleAstrologerCount">
                            @totalAstrologers
                        </strong>

                        <span>
                            astrologers
                        </span>

                    </div>

                </div>


                <!-- =================================================
                     DESKTOP TABLE
                     ================================================= -->

                <div class="desktop-astrologers">

                    <div class="table-responsive">

                        <table class="table astrologer-table align-middle"
                               id="astrologerTable">

                            <thead>

                                <tr>

                                    <th>
                                        Astrologer
                                    </th>

                                    <th>
                                        Contact
                                    </th>

                                    <th>
                                        Experience
                                    </th>

                                    <th>
                                        Specialization
                                    </th>

                                    <th>
                                        Language
                                    </th>

                                    <th>
                                        Status
                                    </th>

                                    <th class="text-end">
                                        Actions
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @foreach (var astrologer in Model)
                                {
                                    <tr>

                                        <!-- ASTROLOGER -->

                                        <td>

                                            <div class="astrologer-cell">

                                                <div class="astrologer-avatar">

                                                    <i class="fa-solid fa-star"></i>

                                                </div>

                                                <div>

                                                    <span>
                                                        ASTROLOGER
                                                    </span>

                                                    <strong>
                                                        @astrologer.FullName
                                                    </strong>

                                                </div>

                                            </div>

                                        </td>


                                        <!-- CONTACT -->

                                        <td>

                                            <div class="contact-cell">

                                                <div>

                                                    <i class="fa-regular fa-envelope"></i>

                                                    <span>
                                                        @astrologer.Email
                                                    </span>

                                                </div>


                                                <div>

                                                    <i class="fa-solid fa-phone"></i>

                                                    <span>

                                                        @(string.IsNullOrWhiteSpace(astrologer.PhoneNumber)
                                                                                                        ? "Not provided"
                                                                                                        : astrologer.PhoneNumber)

                                                    </span>

                                                </div>

                                            </div>

                                        </td>


                                        <!-- EXPERIENCE -->

                                        <td>

                                            <span class="experience-badge">

                                                <i class="fa-solid fa-award"></i>

                                                @astrologer.Experience Years

                                            </span>

                                        </td>


                                        <!-- SPECIALIZATION -->

                                        <td>

                                            <span class="specialization-badge">

                                                <i class="fa-solid fa-moon"></i>

                                                @(string.IsNullOrWhiteSpace(astrologer.Specialization)
                                                                                        ? "Not specified"
                                                                                        : astrologer.Specialization)

                                    </span>

                                        </td>


                                        <!-- LANGUAGE -->

                                        <td>

                                            <div class="language-cell">

                                                <i class="fa-solid fa-language"></i>

                                                <span>
                                                    @astrologer.Language
                                                </span>

                                            </div>

                                        </td>


                                        <!-- STATUS -->

                                        <td>

                                    @if (astrologer.IsActive)
                                            {
                                                <span class="status-badge status-active">

                                                    <span class="status-dot"></span>

                                                    Active

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-inactive">

                                                    <span class="status-dot"></span>

                                                    Inactive

                                                </span>
                                            }

                                        </td>


                                        <!-- ACTIONS -->

                                        <td class="text-end">

                                            <div class="astrologer-actions">

                                                <a asp-action="Edit"
                                                   asp-route-id="@astrologer.Id"
                                                   class="action-btn edit-btn"
                                                   title="Edit Astrologer">

                                                    <i class="fa-solid fa-pen"></i>

                                                </a>


                                                <a asp-action="Delete"
                                                   asp-route-id="@astrologer.Id"
                                                   class="action-btn delete-btn"
                                                   title="Delete Astrologer">

                                                    <i class="fa-solid fa-trash"></i>

                                                </a>

                                            </div>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>


                <!-- =================================================
                     MOBILE CARDS
                     ================================================= -->

                <div class="mobile-astrologers"
                     id="mobileAstrologerList">

                    @foreach (var astrologer in Model)
                    {
                        <article class="mobile-astrologer-card">

                            <div class="mobile-card-top">

                                <div class="mobile-profile">

                                    <div class="mobile-avatar">

                                        <i class="fa-solid fa-star"></i>

                                    </div>

                                    <div>

                                        <span>
                                            ASTROLOGER
                                        </span>

                                        <h3>
                                            @astrologer.FullName
                                        </h3>

                                    </div>

                                </div>


                                @if (astrologer.IsActive)
                                {
                                    <span class="status-badge status-active">

                                        <span class="status-dot"></span>

                                        Active

                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-inactive">

                                        <span class="status-dot"></span>

                                        Inactive

                                    </span>
                                }

                        </div>


                        <div class="mobile-info-grid">

                            <!-- EMAIL -->

                            <div>

                                <i class="fa-regular fa-envelope"></i>

                                <div>

                                    <span>
                                        Email
                                    </span>

                                    <strong>
                                        @astrologer.Email
                                    </strong>

                                </div>

                            </div>


                            <!-- PHONE -->

                            <div>

                                <i class="fa-solid fa-phone"></i>

                                <div>

                                    <span>
                                        Phone
                                    </span>

                                    <strong>

                                        @(string.IsNullOrWhiteSpace(astrologer.PhoneNumber)
                                                                            ? "Not provided"
                                                                            : astrologer.PhoneNumber)

                                    </strong>

                                </div>

                            </div>


                            <!-- EXPERIENCE -->

                            <div>

                                <i class="fa-solid fa-award"></i>

                                <div>

                                    <span>
                                        Experience
                                    </span>

                                    <strong>
                                        @astrologer.Experience Years
                                    </strong>

                                </div>

                            </div>


                            <!-- LANGUAGE -->

                            <div>

                                <i class="fa-solid fa-language"></i>

                                <div>

                                    <span>
                                        Language
                                    </span>

                                    <strong>
                                        @astrologer.Language
                                    </strong>

                                </div>

                            </div>

                        </div>


                        <div class="mobile-specialization">

                            <span>
                                SPECIALIZATION
                            </span>

                            <strong>
                                @(string.IsNullOrWhiteSpace(astrologer.Specialization)
                                                            ? "Not specified"
                                                            : astrologer.Specialization)
                        </strong>

                            </div>


                            <div class="mobile-actions">

                                <a asp-action="Edit"
                                   asp-route-id="@astrologer.Id"
                                   class="mobile-edit-btn">

                                    <i class="fa-solid fa-pen"></i>

                                    Edit Astrologer

                                </a>


                                <a asp-action="Delete"
                                   asp-route-id="@astrologer.Id"
                                   class="mobile-delete-btn">

                                    <i class="fa-solid fa-trash"></i>

                                    Delete

                                </a>

                            </div>

                        </article>
                                }

                </div>


                <!-- =================================================
                     FILTER EMPTY
                     ================================================= -->

                <div id="astrologerFilterEmpty"
                     class="filter-empty"
                     style="display:none;">

                    <div class="filter-empty-icon">

                        <i class="fa-solid fa-magnifying-glass"></i>

                    </div>

                    <span>
                        NO MATCHES
                    </span>

                    <h3>
                        No matching astrologers.
                    </h3>

                    <p>
                        Try another name, email, specialization or language.
                    </p>

                </div>

            </section>
        }


        <!-- =====================================================
             FOOTER
             ===================================================== -->
        @if (Model != null && Model.Any())
        {
            <section class="astrologer-footer">

                <div>

                    <div class="footer-icon">

                        <i class="fa-solid fa-star"></i>

                    </div>

                    <div>

                        <span>
                            ASTROLOGER MANAGEMENT
                        </span>

                        <h3>
                            Maintain your consultation team.
                        </h3>

                        <p>
                            Keep experience, specialization and availability
                            information accurate.
                        </p>

                    </div>

                </div>


                <a asp-action="Create"
                   class="footer-add-btn">

                    Add Astrologer

                    <i class="fa-solid fa-arrow-right"></i>

                </a>

            </section>
        }

    </div>

</section>


<style>

    /* =====================================================
           PAGE
           ===================================================== */

    .astrologer-management-page {
        min-height: 100vh;
        padding: 45px 0 80px;
        background: #f8f5ec;
    }


    /* =====================================================
           HEADER
           ===================================================== */

    .page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 30px;
        margin-bottom: 28px;
    }

    .section-label {
        display: block;
        margin-bottom: 8px;
        color: #987918;
        font-size: .63rem;
        font-weight: 800;
        letter-spacing: .17em;
    }

    .page-header h1 {
        margin-bottom: 8px;
        color: #181710;
        font-family: 'DM Serif Display', serif;
        font-size: clamp(2.5rem, 4vw, 3.8rem);
        font-weight: 400;
        line-height: 1;
    }

    .page-header p {
        max-width: 640px;
        margin: 0;
        color: #817b70;
        font-size: .8rem;
        line-height: 1.7;
    }

    .header-actions {
        display: flex;
        gap: 9px;
        flex-shrink: 0;
    }

    .back-btn,
    .add-astrologer-btn {
        min-height: 43px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 9px 16px;
        border-radius: 9px;
        font-size: .67rem;
        font-weight: 700;
        text-decoration: none;
        transition: all .2s ease;
    }

    .back-btn {
        border: 1px solid #ccc2af;
        background: transparent;
        color: #181710;
    }

        .back-btn:hover {
            border-color: #181710;
            background: #181710;
            color: white;
        }

    .add-astrologer-btn {
        border: 1px solid #181710;
        background: #181710;
        color: white;
    }

        .add-astrologer-btn:hover {
            border-color: #e1bf4a;
            background: #e1bf4a;
            color: #181710;
        }


    /* =====================================================
           SUMMARY
           ===================================================== */

    .astrologer-summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
        margin-bottom: 18px;
        padding: 23px 27px;
        border-radius: 18px;
        background: #181710;
        color: white;
    }

    .summary-main {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .summary-icon {
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 50%;
        background: #e1bf4a;
        color: #181710;
        font-size: .75rem;
    }

    .summary-main span {
        display: block;
        margin-bottom: 2px;
        color: #e1bf4a;
        font-size: .49rem;
        font-weight: 800;
        letter-spacing: .13em;
    }

    .summary-main h2 {
        margin: 0;
        font-family: 'DM Serif Display', serif;
        font-size: 1.5rem;
        font-weight: 400;
    }

    .summary-stats {
        display: flex;
        align-items: center;
        gap: 22px;
    }

        .summary-stats > div:not(.summary-divider) {
            min-width: 58px;
            text-align: center;
        }

        .summary-stats span,
        .summary-stats strong {
            display: block;
        }

        .summary-stats span {
            margin-bottom: 2px;
            color: rgba(255,255,255,.37);
            font-size: .47rem;
            font-weight: 800;
            letter-spacing: .08em;
        }

        .summary-stats strong {
            color: #e1bf4a;
            font-family: 'DM Serif Display', serif;
            font-size: 1.55rem;
            font-weight: 400;
            line-height: 1;
        }

    .summary-divider {
        width: 1px;
        height: 31px;
        background: rgba(255,255,255,.12);
    }


    /* =====================================================
           SEARCH
           ===================================================== */

    .search-card {
        margin-bottom: 18px;
        padding: 22px 24px;
        border: 1px solid #e1d9ca;
        border-radius: 17px;
        background: #fffdf8;
    }

    .search-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
    }

        .search-heading span {
            display: block;
            margin-bottom: 2px;
            color: #987918;
            font-size: .49rem;
            font-weight: 800;
            letter-spacing: .12em;
        }

        .search-heading h2 {
            margin: 0;
            color: #29251f;
            font-family: 'DM Serif Display', serif;
            font-size: 1.35rem;
            font-weight: 400;
        }

    .search-heading-icon {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #f1eadc;
        color: #8d7626;
        font-size: .61rem;
    }

    .search-wrapper {
        position: relative;
    }

        .search-wrapper > i {
            position: absolute;
            left: 14px;
            top: 50%;
            z-index: 2;
            transform: translateY(-50%);
            color: #9c9487;
            font-size: .62rem;
            pointer-events: none;
        }

        .search-wrapper .form-control {
            min-height: 44px;
            padding-left: 40px;
            border: 1px solid #ddd5c6;
            border-radius: 10px;
            background: #faf7ef;
            color: #39342c;
            font-size: .69rem;
        }

            .search-wrapper .form-control:focus {
                border-color: #c5a943;
                background: white;
                box-shadow: 0 0 0 .18rem rgba(225,191,74,.11);
            }


    /* =====================================================
           MAIN CARD
           ===================================================== */

    .astrologers-card {
        overflow: hidden;
        border: 1px solid #e1d9ca;
        border-radius: 19px;
        background: #fffdf8;
    }

    .astrologers-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
        padding: 26px 27px 21px;
    }

    .astrologers-heading {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .astrologers-heading-icon {
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 50%;
        background: #181710;
        color: #e1bf4a;
        font-size: .68rem;
    }

    .astrologers-heading span {
        display: block;
        margin-bottom: 2px;
        color: #987918;
        font-size: .49rem;
        font-weight: 800;
        letter-spacing: .12em;
    }

    .astrologers-heading h2 {
        margin-bottom: 2px;
        color: #29251f;
        font-family: 'DM Serif Display', serif;
        font-size: 1.45rem;
        font-weight: 400;
    }

    .astrologers-heading p {
        margin: 0;
        color: #958d80;
        font-size: .59rem;
    }

    .record-count {
        text-align: center;
        flex-shrink: 0;
    }

        .record-count strong,
        .record-count span {
            display: block;
        }

        .record-count strong {
            color: #181710;
            font-family: 'DM Serif Display', serif;
            font-size: 1.65rem;
            font-weight: 400;
            line-height: 1;
        }

        .record-count span {
            margin-top: 2px;
            color: #958d80;
            font-size: .48rem;
            font-weight: 700;
        }


    /* =====================================================
           TABLE
           ===================================================== */

    .astrologer-table {
        margin: 0;
    }

        .astrologer-table thead th {
            padding: 12px 14px;
            border-top: 1px solid #e7dfd2;
            border-bottom: 1px solid #ded5c6;
            background: #faf7ef;
            color: #8d8578;
            font-size: .51rem;
            font-weight: 800;
            letter-spacing: .07em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .astrologer-table tbody td {
            padding: 15px 14px;
            border-bottom: 1px solid #eee7dc;
            color: #554f46;
            font-size: .64rem;
        }

        .astrologer-table tbody tr:last-child td {
            border-bottom: 0;
        }

        .astrologer-table tbody tr:hover {
            background: #fbf8f1;
        }


    /* ASTROLOGER */

    .astrologer-cell {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .astrologer-avatar {
        width: 35px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 50%;
        background: #181710;
        color: #e1bf4a;
        font-size: .57rem;
    }

    .astrologer-cell span,
    .astrologer-cell strong {
        display: block;
    }

    .astrologer-cell span {
        margin-bottom: 1px;
        color: #a0998d;
        font-size: .43rem;
        font-weight: 800;
        letter-spacing: .06em;
    }

    .astrologer-cell strong {
        color: #373229;
        font-size: .65rem;
        white-space: nowrap;
    }


    /* CONTACT */

    .contact-cell {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

        .contact-cell > div {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .contact-cell i {
            width: 13px;
            color: #9a8129;
            text-align: center;
            font-size: .54rem;
        }


    /* EXPERIENCE */

    .experience-badge,
    .specialization-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 9px;
        border-radius: 999px;
        font-size: .53rem;
        font-weight: 800;
    }

    .experience-badge {
        background: #f1eadc;
        color: #786723;
        white-space: nowrap;
    }

    .specialization-badge {
        background: #fff0ad;
        color: #6d5811;
    }

    .language-cell {
        display: flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
    }

        .language-cell i {
            color: #927923;
            font-size: .56rem;
        }


    /* =====================================================
           STATUS
           ===================================================== */

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 9px;
        border-radius: 999px;
        font-size: .52rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .status-dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
    }

    .status-active {
        background: #dfeddf;
        color: #45694b;
    }

        .status-active .status-dot {
            background: #5a9765;
        }

    .status-inactive {
        background: #ece8e0;
        color: #655f55;
    }

        .status-inactive .status-dot {
            background: #827a6d;
        }


    /* =====================================================
           ACTIONS
           ===================================================== */

    .astrologer-actions {
