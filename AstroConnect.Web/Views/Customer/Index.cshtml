@model List<AstroConnect.Domain.Entities.Customer>

@{
    ViewData["Title"] = "Customers";

    var totalCustomers = Model?.Count ?? 0;
    var maleCustomers = Model?.Count(x => x.Gender == "Male") ?? 0;
    var femaleCustomers = Model?.Count(x => x.Gender == "Female") ?? 0;
}

<section class="customer-management-page">

    <div class="container">

        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="page-header">

            <div>

                <span class="section-label">
                    ADMINISTRATION
                </span>

                <h1>
                    Customers
                </h1>

                <p>
                    Manage registered customer profiles, contact details,
                    birth information and appointment records.
                </p>

            </div>


            <div class="header-actions">

                <a asp-controller="Admin"
                   asp-action="Index"
                   class="back-btn">

                    <i class="fa-solid fa-arrow-left"></i>

                    Dashboard

                </a>


                <a asp-action="Create"
                   class="add-customer-btn">

                    <i class="fa-solid fa-user-plus"></i>

                    Add Customer

                </a>

            </div>

        </div>


        <!-- =====================================================
             SUMMARY
             ===================================================== -->

        <section class="customer-summary">

            <div class="summary-main">

                <div class="summary-icon">

                    <i class="fa-solid fa-users"></i>

                </div>

                <div>

                    <span>
                        CUSTOMER OVERVIEW
                    </span>

                    <h2>
                        Registered Customers
                    </h2>

                </div>

            </div>


            <div class="summary-stats">

                <div>

                    <span>
                        TOTAL
                    </span>

                    <strong>
                        @totalCustomers
                    </strong>

                </div>


                <div class="summary-divider"></div>


                <div>

                    <span>
                        MALE
                    </span>

                    <strong>
                        @maleCustomers
                    </strong>

                </div>


                <div class="summary-divider"></div>


                <div>

                    <span>
                        FEMALE
                    </span>

                    <strong>
                        @femaleCustomers
                    </strong>

                </div>

            </div>

        </section>


        <!-- =====================================================
             SEARCH
             ===================================================== -->

        <section class="search-card">

            <div class="search-heading">

                <div>

                    <span>
                        FIND CUSTOMERS
                    </span>

                    <h2>
                        Search Customer Records
                    </h2>

                </div>


                <div class="search-heading-icon">

                    <i class="fa-solid fa-magnifying-glass"></i>

                </div>

            </div>


            <div class="search-wrapper">

                <i class="fa-solid fa-magnifying-glass"></i>

                <input type="text"
                       id="customerSearch"
                       class="form-control"
                       placeholder="Search by name, email, phone or birthplace" />

            </div>

        </section>


        <!-- =====================================================
             EMPTY STATE
             ===================================================== -->
        @if (Model == null || !Model.Any())
        {
            <section class="empty-state">

                <div class="empty-icon">

                    <i class="fa-solid fa-users-slash"></i>

                </div>

                <span>
                    CUSTOMER RECORDS
                </span>

                <h2>
                    No customers found.
                </h2>

                <p>
                    Add the first customer profile to begin
                    managing consultation records.
                </p>


                <a asp-action="Create"
                   class="empty-add-btn">

                    <i class="fa-solid fa-user-plus"></i>

                    Add Customer

                </a>

            </section>
        }
        else
        {
            <!-- =================================================
                 CUSTOMER LIST
                 ================================================= -->

            <section class="customers-card">

                <div class="customers-card-header">

                    <div class="customers-heading">

                        <div class="customers-heading-icon">

                            <i class="fa-solid fa-address-book"></i>

                        </div>

                        <div>

                            <span>
                                CUSTOMER DIRECTORY
                            </span>

                            <h2>
                                Customer Records
                            </h2>

                            <p>
                                Review customer contact and birth information.
                            </p>

                        </div>

                    </div>


                    <div class="record-count">

                        <strong id="visibleCustomerCount">
                            @totalCustomers
                        </strong>

                        <span>
                            customers
                        </span>

                    </div>

                </div>


                <!-- =================================================
                     DESKTOP TABLE
                     ================================================= -->

                <div class="desktop-customers">

                    <div class="table-responsive">

                        <table class="table customer-table align-middle"
                               id="customerTable">

                            <thead>

                                <tr>

                                    <th>
                                        Customer
                                    </th>

                                    <th>
                                        Contact
                                    </th>

                                    <th>
                                        Date of Birth
                                    </th>

                                    <th>
                                        Gender
                                    </th>

                                    <th>
                                        Birth Place
                                    </th>

                                    <th class="text-end">
                                        Actions
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @foreach (var customer in Model)
                                {
                                    <tr>

                                        <!-- CUSTOMER -->

                                        <td>

                                            <div class="customer-cell">

                                                <div class="customer-avatar">

                                                    <i class="fa-solid fa-user"></i>

                                                </div>

                                                <div>

                                                    <span>
                                                        CUSTOMER
                                                    </span>

                                                    <strong>
                                                        @customer.FullName
                                                    </strong>

                                                </div>

                                            </div>

                                        </td>


                                        <!-- CONTACT -->

                                        <td>

                                            <div class="contact-cell">

                                                <div>

                                                    <i class="fa-regular fa-envelope"></i>

                                                    <span>
                                                        @customer.Email
                                                    </span>

                                                </div>


                                                <div>

                                                    <i class="fa-solid fa-phone"></i>

                                                    <span>

                                                        @(string.IsNullOrWhiteSpace(customer.PhoneNumber)
                                                                                                        ? "Not provided"
                                                                                                        : customer.PhoneNumber)

                                            </span>

                                                </div>

                                            </div>

                                        </td>


                                        <!-- DATE OF BIRTH -->

                                        <td>

                                            <div class="date-cell">

                                                <i class="fa-regular fa-calendar"></i>

                                                <span>
                                                    @customer.DateOfBirth.ToString("dd MMM yyyy")
                                                </span>

                                            </div>

                                        </td>


                                        <!-- GENDER -->

                                        <td>

                                    @if (customer.Gender == "Male")
                                            {
                                                <span class="gender-badge gender-male">

                                                    <i class="fa-solid fa-mars"></i>

                                                    Male

                                                </span>
                                            }
                                            else if (customer.Gender == "Female")
                                            {
                                                <span class="gender-badge gender-female">

                                                    <i class="fa-solid fa-venus"></i>

                                                    Female

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="gender-badge gender-other">

                                                    <i class="fa-solid fa-venus-mars"></i>

                                                    @customer.Gender

                                                </span>
                                            }

                                    </td>


                                    <!-- BIRTH PLACE -->

                                    <td>

                                        <div class="birth-place-cell">

                                            <i class="fa-solid fa-location-dot"></i>

                                            <span>

                                                @(string.IsNullOrWhiteSpace(customer.BirthPlace)
                                                                                            ? "Not provided"
                                                                                            : customer.BirthPlace)

                                        </span>

                                            </div>

                                        </td>


                                        <!-- ACTIONS -->

                                        <td class="text-end">

                                            <div class="customer-actions">

                                                <a asp-controller="Receptionist"
                                                   asp-action="CustomerDetails"
                                                   asp-route-id="@customer.Id"
                                                   class="action-btn details-btn"
                                                   title="View Customer Details">

                                                    <i class="fa-solid fa-eye"></i>

                                                </a>


                                                <a asp-action="Edit"
                                                   asp-route-id="@customer.Id"
                                                   class="action-btn edit-btn"
                                                   title="Edit Customer">

                                                    <i class="fa-solid fa-pen"></i>

                                                </a>


                                                <a asp-action="Delete"
                                                   asp-route-id="@customer.Id"
                                                   class="action-btn delete-btn"
                                                   title="Delete Customer">

                                                    <i class="fa-solid fa-trash"></i>

                                                </a>

                                            </div>

                                        </td>

                                    </tr>
                                                        }

                            </tbody>

                        </table>

                    </div>

                </div>


                <!-- =================================================
                     MOBILE CARDS
                     ================================================= -->

                <div class="mobile-customers"
                     id="mobileCustomerList">

                    @foreach (var customer in Model)
                    {
                        <article class="mobile-customer-card">

                            <div class="mobile-card-top">

                                <div class="mobile-profile">

                                    <div class="mobile-avatar">

                                        <i class="fa-solid fa-user"></i>

                                    </div>

                                    <div>

                                        <span>
                                            CUSTOMER
                                        </span>

                                        <h3>
                                            @customer.FullName
                                        </h3>

                                    </div>

                                </div>


                                @if (customer.Gender == "Male")
                                {
                                    <span class="gender-badge gender-male">

                                        <i class="fa-solid fa-mars"></i>

                                        Male

                                    </span>
                                }
                                else if (customer.Gender == "Female")
                                {
                                    <span class="gender-badge gender-female">

                                        <i class="fa-solid fa-venus"></i>

                                        Female

                                    </span>
                                }
                                else
                                {
                                    <span class="gender-badge gender-other">

                                        <i class="fa-solid fa-venus-mars"></i>

                                        @customer.Gender

                                    </span>
                                }

                        </div>


                        <div class="mobile-info-grid">

                            <!-- EMAIL -->

                            <div>

                                <i class="fa-regular fa-envelope"></i>

                                <div>

                                    <span>
                                        Email
                                    </span>

                                    <strong>
                                        @customer.Email
                                    </strong>

                                </div>

                            </div>


                            <!-- PHONE -->

                            <div>

                                <i class="fa-solid fa-phone"></i>

                                <div>

                                    <span>
                                        Phone
                                    </span>

                                    <strong>

                                        @(string.IsNullOrWhiteSpace(customer.PhoneNumber)
                                                                            ? "Not provided"
                                                                            : customer.PhoneNumber)

                                    </strong>

                                </div>

                            </div>


                            <!-- DOB -->

                            <div>

                                <i class="fa-regular fa-calendar"></i>

                                <div>

                                    <span>
                                        Date of Birth
                                    </span>

                                    <strong>
                                        @customer.DateOfBirth.ToString("dd MMM yyyy")
                                    </strong>

                                </div>

                            </div>


                            <!-- BIRTH PLACE -->

                            <div>

                                <i class="fa-solid fa-location-dot"></i>

                                <div>

                                    <span>
                                        Birth Place
                                    </span>

                                    <strong>

                                        @(string.IsNullOrWhiteSpace(customer.BirthPlace)
                                                                            ? "Not provided"
                                                                            : customer.BirthPlace)

                                </strong>

                                    </div>

                                </div>

                            </div>


                            <div class="mobile-actions">

                                <a asp-controller="Receptionist"
                                   asp-action="CustomerDetails"
                                   asp-route-id="@customer.Id"
                                   class="mobile-details-btn">

                                    <i class="fa-solid fa-eye"></i>

                                    Details

                                </a>


                                <a asp-action="Edit"
                                   asp-route-id="@customer.Id"
                                   class="mobile-edit-btn">

                                    <i class="fa-solid fa-pen"></i>

                                    Edit

                                </a>


                                <a asp-action="Delete"
                                   asp-route-id="@customer.Id"
                                   class="mobile-delete-btn">

                                    <i class="fa-solid fa-trash"></i>

                                    Delete

                                </a>

                            </div>

                        </article>
                                }

                </div>


                <!-- =================================================
                     FILTER EMPTY
                     ================================================= -->

                <div id="customerFilterEmpty"
                     class="filter-empty"
                     style="display:none;">

                    <div class="filter-empty-icon">

                        <i class="fa-solid fa-magnifying-glass"></i>

                    </div>

                    <span>
                        NO MATCHES
                    </span>

                    <h3>
                        No matching customers.
                    </h3>

                    <p>
                        Try another name, email, phone number or birthplace.
                    </p>

                </div>

            </section>
        }


        <!-- =====================================================
             FOOTER
             ===================================================== -->
        @if (Model != null && Model.Any())
        {
            <section class="customer-footer">

                <div>

                    <div class="footer-icon">

                        <i class="fa-solid fa-users"></i>

                    </div>

                    <div>

                        <span>
                            CUSTOMER MANAGEMENT
                        </span>

                        <h3>
                            Keep customer records accurate.
                        </h3>

                        <p>
                            Maintain contact and birth information for smoother consultations.
                        </p>

                    </div>

                </div>


                <a asp-action="Create"
                   class="footer-add-btn">

                    Add Customer

                    <i class="fa-solid fa-arrow-right"></i>

                </a>

            </section>
        }

    </div>

</section>


<style>

    /* =====================================================
           PAGE
           ===================================================== */

    .customer-management-page {
        min-height: 100vh;
        padding: 45px 0 80px;
        background: #f8f5ec;
    }


    /* =====================================================
           HEADER
           ===================================================== */

    .page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 30px;
        margin-bottom: 28px;
    }

    .section-label {
        display: block;
        margin-bottom: 8px;
        color: #987918;
        font-size: .63rem;
        font-weight: 800;
        letter-spacing: .17em;
    }

    .page-header h1 {
        margin-bottom: 8px;
        color: #181710;
        font-family: 'DM Serif Display', serif;
        font-size: clamp(2.5rem, 4vw, 3.8rem);
        font-weight: 400;
        line-height: 1;
    }

    .page-header p {
        max-width: 650px;
        margin: 0;
        color: #817b70;
        font-size: .8rem;
        line-height: 1.7;
    }

    .header-actions {
        display: flex;
        gap: 9px;
        flex-shrink: 0;
    }

    .back-btn,
    .add-customer-btn {
        min-height: 43px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 9px 16px;
        border-radius: 9px;
        font-size: .67rem;
        font-weight: 700;
        text-decoration: none;
        transition: all .2s ease;
    }

    .back-btn {
        border: 1px solid #ccc2af;
        background: transparent;
        color: #181710;
    }

        .back-btn:hover {
            border-color: #181710;
            background: #181710;
            color: white;
        }

    .add-customer-btn {
        border: 1px solid #181710;
        background: #181710;
        color: white;
    }

        .add-customer-btn:hover {
            border-color: #e1bf4a;
            background: #e1bf4a;
            color: #181710;
        }


    /* =====================================================
           SUMMARY
           ===================================================== */

    .customer-summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
        margin-bottom: 18px;
        padding: 23px 27px;
        border-radius: 18px;
        background: #181710;
        color: white;
    }

    .summary-main {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .summary-icon {
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 50%;
        background: #e1bf4a;
        color: #181710;
        font-size: .75rem;
    }

    .summary-main span {
        display: block;
        margin-bottom: 2px;
        color: #e1bf4a;
        font-size: .49rem;
        font-weight: 800;
        letter-spacing: .13em;
    }

    .summary-main h2 {
        margin: 0;
        font-family: 'DM Serif Display', serif;
        font-size: 1.5rem;
        font-weight: 400;
    }

    .summary-stats {
        display: flex;
        align-items: center;
        gap: 22px;
    }

        .summary-stats > div:not(.summary-divider) {
            min-width: 58px;
            text-align: center;
        }

        .summary-stats span,
        .summary-stats strong {
            display: block;
        }

        .summary-stats span {
            margin-bottom: 2px;
            color: rgba(255,255,255,.37);
            font-size: .47rem;
            font-weight: 800;
            letter-spacing: .08em;
        }

        .summary-stats strong {
            color: #e1bf4a;
            font-family: 'DM Serif Display', serif;
            font-size: 1.55rem;
            font-weight: 400;
            line-height: 1;
        }

    .summary-divider {
        width: 1px;
        height: 31px;
        background: rgba(255,255,255,.12);
    }


    /* =====================================================
           SEARCH
           ===================================================== */

    .search-card {
        margin-bottom: 18px;
        padding: 22px 24px;
        border: 1px solid #e1d9ca;
        border-radius: 17px;
        background: #fffdf8;
    }

    .search-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
    }

        .search-heading span {
            display: block;
            margin-bottom: 2px;
            color: #987918;
            font-size: .49rem;
            font-weight: 800;
            letter-spacing: .12em;
        }

        .search-heading h2 {
            margin: 0;
            color: #29251f;
            font-family: 'DM Serif Display', serif;
            font-size: 1.35rem;
            font-weight: 400;
        }

    .search-heading-icon {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #f1eadc;
        color: #8d7626;
        font-size: .61rem;
    }

    .search-wrapper {
        position: relative;
    }

        .search-wrapper > i {
            position: absolute;
            left: 14px;
            top: 50%;
            z-index: 2;
            transform: translateY(-50%);
            color: #9c9487;
            font-size: .62rem;
            pointer-events: none;
        }

        .search-wrapper .form-control {
            min-height: 44px;
            padding-left: 40px;
            border: 1px solid #ddd5c6;
            border-radius: 10px;
            background: #faf7ef;
            color: #39342c;
            font-size: .69rem;
        }

            .search-wrapper .form-control:focus {
                border-color: #c5a943;
                background: white;
                box-shadow: 0 0 0 .18rem rgba(225,191,74,.11);
            }


    /* =====================================================
           MAIN CARD
           ===================================================== */

    .customers-card {
        overflow: hidden;
        border: 1px solid #e1d9ca;
        border-radius: 19px;
        background: #fffdf8;
    }

    .customers-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
        padding: 26px 27px 21px;
    }

    .customers-heading {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .customers-heading-icon {
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 50%;
        background: #181710;
        color: #e1bf4a;
        font-size: .68rem;
    }

    .customers-heading span {
        display: block;
        margin-bottom: 2px;
        color: #987918;
        font-size: .49rem;
        font-weight: 800;
        letter-spacing: .12em;
    }

    .customers-heading h2 {
        margin-bottom: 2px;
        color: #29251f;
        font-family: 'DM Serif Display', serif;
        font-size: 1.45rem;
        font-weight: 400;
    }

    .customers-heading p {
        margin: 0;
        color: #958d80;
        font-size: .59rem;
    }

    .record-count {
        text-align: center;
        flex-shrink: 0;
    }

        .record-count strong,
        .record-count span {
            display: block;
        }

        .record-count strong {
            color: #181710;
            font-family: 'DM Serif Display', serif;
            font-size: 1.65rem;
            font-weight: 400;
            line-height: 1;
        }

        .record-count span {
            margin-top: 2px;
            color: #958d80;
            font-size: .48rem;
            font-weight: 700;
        }


    /* =====================================================
           TABLE
           ===================================================== */

    .customer-table {
        margin: 0;
    }

        .customer-table thead th {
            padding: 12px 14px;
            border-top: 1px solid #e7dfd2;
            border-bottom: 1px solid #ded5c6;
            background: #faf7ef;
            color: #8d8578;
            font-size: .51rem;
            font-weight: 800;
            letter-spacing: .07em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .customer-table tbody td {
            padding: 15px 14px;
            border-bottom: 1px solid #eee7dc;
            color: #554f46;
            font-size: .64rem;
        }

        .customer-table tbody tr:last-child td {
            border-bottom: 0;
        }

        .customer-table tbody tr:hover {
            background: #fbf8f1;
        }


    /* CUSTOMER */

    .customer-cell {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .customer-avatar {
        width: 35px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 50%;
        background: #181710;
        color: #e1bf4a;
        font-size: .57rem;
    }

    .customer-cell span,
    .customer-cell strong {
        display: block;
    }

    .customer-cell span {
        margin-bottom: 1px;
        color: #a0998d;
        font-size: .43rem;
        font-weight: 800;
        letter-spacing: .06em;
    }

    .customer-cell strong {
        color: #373229;
        font-size: .65rem;
        white-space: nowrap;
    }


    /* CONTACT */

    .contact-cell {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

        .contact-cell > div {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .contact-cell i {
            width: 13px;
            color: #9a8129;
            text-align: center;
            font-size: .54rem;
        }


    /* DATE / PLACE */

    .date-cell,
    .birth-place-cell {
        display: flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
    }

        .date-cell i,
        .birth-place-cell i {
            color: #997f28;
            font-size: .55rem;
        }


    /* =====================================================
           GENDER
           ===================================================== */

    .gender-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 9px;
        border-radius: 999px;
        font-size: .52rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .gender-male {
        background: #e1e9ed;
        color: #4c6671;
    }

    .gender-female {
        background: #f3e1e5;
        color: #875562;
    }

    .gender-other {
        background: #ece8e0;
        color: #655f55;
    }


    /* =====================================================
           ACTIONS
           ===================================================== */

    .customer-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 5px;
    }

    .action-btn {
        width: 31px;
        height: 31px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
