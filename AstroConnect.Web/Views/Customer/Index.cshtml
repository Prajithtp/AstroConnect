@model List<AstroConnect.Domain.Entities.Customer>

@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="fw-bold">
            <i class="fa-solid fa-users text-primary"></i>
            Customers
        </h2>

        <p class="text-muted mb-0">
            Manage all registered customers
        </p>

    </div>

    <a asp-action="Create" class="btn btn-primary">
        <i class="fa-solid fa-user-plus"></i>
        Add Customer
    </a>

</div>


<!-- SEARCH -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-body">

        <input type="text"
               id="customerSearch"
               class="form-control"
               placeholder="🔍 Search customer by name, email, phone or birthplace">

    </div>

</div>


@if (!Model.Any())
{
    <div class="alert alert-info">

        <i class="fa-solid fa-circle-info me-2"></i>

        No customers found.

    </div>
}
else
{
    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle"
                       id="customerTable">

                    <thead class="table-dark">

                        <tr>

                            <th>Full Name</th>

                            <th>Email</th>

                            <th>Phone</th>

                            <th>Date of Birth</th>

                            <th>Gender</th>

                            <th>Birth Place</th>

                            <th class="text-center">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var customer in Model)
                        {
                            <tr>

                                <!-- NAME -->

                                <td>

                                    <strong>
                                        @customer.FullName
                                    </strong>

                                </td>


                                <!-- EMAIL -->

                                <td>
                                    @customer.Email
                                </td>


                                <!-- PHONE -->

                                <td>
                                    @customer.PhoneNumber
                                </td>


                                <!-- DATE OF BIRTH -->

                                <td>
                                    @customer.DateOfBirth.ToString("dd-MMM-yyyy")
                                </td>


                                <!-- GENDER -->

                                <td>

                                    @if (customer.Gender == "Male")
                                    {
                                        <span class="badge bg-primary">
                                            Male
                                        </span>
                                    }
                                    else if (customer.Gender == "Female")
                                    {
                                        <span class="badge bg-danger">
                                            Female
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @customer.Gender
                                        </span>
                                    }

                                </td>


                                <!-- BIRTH PLACE -->

                                <td>
                                    @customer.BirthPlace
                                </td>


                                <!-- ACTIONS -->

                                <td class="text-center">

                                    <!-- VIEW DETAILS -->

                                    <a asp-controller="Receptionist"
                                       asp-action="CustomerDetails"
                                       asp-route-id="@customer.Id"
                                       class="btn btn-primary btn-sm action-btn me-1"
                                       title="View Customer Details">

                                        <i class="fa-solid fa-eye"></i>

                                    </a>


                                    <!-- EDIT -->

                                    <a asp-action="Edit"
                                       asp-route-id="@customer.Id"
                                       class="btn btn-warning btn-sm action-btn me-1"
                                       title="Edit Customer">

                                        <i class="fa-solid fa-pen"></i>

                                    </a>


                                    <!-- DELETE -->

                                    <a asp-action="Delete"
                                       asp-route-id="@customer.Id"
                                       class="btn btn-danger btn-sm action-btn"
                                       title="Delete Customer">

                                        <i class="fa-solid fa-trash"></i>

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
}


<!-- STYLING -->

<style>

    .action-btn {
        min-width: 34px;
    }

    #customerTable tbody tr {
        transition: all .2s ease;
    }

        #customerTable tbody tr:hover {
            background-color: #f8f9fa;
        }

    .badge {
        font-size: .82rem;
    }

</style>


<!-- SEARCH SCRIPT -->
@section Scripts {

    <script>

        document
            .getElementById("customerSearch")
            .addEventListener("keyup", function () {

                let value = this.value
                    .toLowerCase()
                    .trim();

                let rows = document.querySelectorAll(
                    "#customerTable tbody tr"
                );

                rows.forEach(function (row) {

                    row.style.display =
                        row.innerText
                            .toLowerCase()
                            .includes(value)
                            ? ""
                            : "none";

                });

            });

    </script>

}