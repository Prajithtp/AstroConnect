@model List<AstroConnect.Domain.Entities.Notification>

@{
    ViewData["Title"] = "Notifications";

    var unreadCount = Model?.Count(n => !n.IsRead) ?? 0;
    var totalCount = Model?.Count ?? 0;
}

<section class="notifications-page">

    <div class="container">


        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="notifications-header">

            <div>

                <span class="section-label">
                    CUSTOMER UPDATES
                </span>

                <h1>
                    Notifications
                </h1>

                <p>
                    Stay informed about your appointments,
                    booking updates and consultation activity.
                </p>

            </div>


            <div class="header-actions">

                <a asp-controller="CustomerPortal"
                   asp-action="Index"
                   class="btn dashboard-btn">

                    <i class="fa-solid fa-arrow-left"></i>

                    Dashboard

                </a>


                @if (unreadCount > 0)
                {
                    <form asp-action="MarkAllAsRead"
                          method="post"
                          class="m-0">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn mark-all-btn">

                            <i class="fa-solid fa-check-double"></i>

                            Mark All as Read

                        </button>

                    </form>
                }

            </div>

        </div>


        <!-- =====================================================
             SUCCESS MESSAGE
             ===================================================== -->
        @if (TempData["Success"] != null)
        {
            <div class="success-message">

                <div class="success-icon">

                    <i class="fa-solid fa-circle-check"></i>

                </div>

                <div>

                    <strong>
                        Updated successfully
                    </strong>

                    <span>
                        @TempData["Success"]
                    </span>

                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>

            </div>
        }


        <!-- =====================================================
             SUMMARY
             ===================================================== -->

        <div class="notification-summary">

            <div class="summary-main">

                <div class="summary-icon">

                    <i class="fa-solid fa-bell"></i>

                </div>

                <div>

                    <span>
                        NOTIFICATION CENTER
                    </span>

                    <h2>
                        Stay up to date.
                    </h2>

                </div>

            </div>


            <div class="summary-stats">

                <div class="summary-stat">

                    <span>
                        TOTAL
                    </span>

                    <strong>
                        @totalCount
                    </strong>

                </div>


                <div class="summary-divider"></div>


                <div class="summary-stat">

                    <span>
                        UNREAD
                    </span>

                    <strong>
                        @unreadCount
                    </strong>

                </div>

            </div>

        </div>


        <!-- =====================================================
             EMPTY STATE
             ===================================================== -->
        @if (Model == null || !Model.Any())
        {
            <div class="empty-notifications">

                <div class="empty-orbit orbit-one"></div>
                <div class="empty-orbit orbit-two"></div>


                <div class="empty-content">

                    <div class="empty-icon">

                        <i class="fa-regular fa-bell-slash"></i>

                    </div>

                    <span>
                        ALL CLEAR
                    </span>

                    <h2>
                        No notifications yet.
                    </h2>

                    <p>
                        Booking confirmations, appointment updates
                        and other important messages will appear here.
                    </p>


                    <a asp-controller="Booking"
                       asp-action="Create"
                       class="btn empty-book-btn">

                        Book an Appointment

                        <i class="fa-solid fa-arrow-right"></i>

                    </a>

                </div>

            </div>
        }
        else
        {
            <!-- =================================================
                 NOTIFICATION LIST
                 ================================================= -->

            <div class="notification-list">

                @foreach (var notification in Model)
                {
                    <article class="notification-card @(notification.IsRead ? "notification-read" : "notification-unread")">


                        <!-- ICON -->

                        <div class="notification-icon">

                            @if (notification.IsRead)
                            {
                                <i class="fa-regular fa-bell"></i>
                            }
                            else
                            {
                                <i class="fa-solid fa-bell"></i>
                            }

                        </div>


                        <!-- CONTENT -->

                        <div class="notification-content">

                            <div class="notification-top">

                                <div class="notification-title-area">

                                    <div class="notification-meta">

                                        @if (!notification.IsRead)
                                        {
                                            <span class="new-badge">

                                                <span></span>

                                                NEW

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="read-badge">

                                                <i class="fa-solid fa-check"></i>

                                                READ

                                            </span>
                                        }


                                        <span class="notification-date">

                                            <i class="fa-regular fa-clock"></i>

                                            @notification.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")

                                        </span>

                                    </div>


                                    <h3>
                                        @notification.Title
                                    </h3>

                                </div>

                            </div>


                            <p class="notification-message">
                                @notification.Message
                            </p>


                            @if (!notification.IsRead)
                            {
                                <div class="notification-actions">

                                    <form asp-action="MarkAsRead"
                                          method="post"
                                          class="m-0">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@notification.Id" />


                                        <button type="submit"
                                                class="mark-read-btn">

                                            <i class="fa-solid fa-check"></i>

                                            Mark as Read

                                        </button>

                                    </form>

                                </div>
                            }

                        </div>


                        <!-- DECORATION -->
                        @if (!notification.IsRead)
                        {
                            <div class="unread-indicator"></div>
                        }

                    </article>
                }

            </div>


            <!-- =================================================
                 FOOTER CTA
                 ================================================= -->

            <div class="notifications-footer">

                <div>

                    <div class="footer-icon">

                        <i class="fa-solid fa-moon"></i>

                    </div>

                    <div>

                        <span>
                            ASTROCONNECT
                        </span>

                        <h3>
                            Ready for your next consultation?
                        </h3>

                        <p>
                            Choose a service and schedule another appointment.
                        </p>

                    </div>

                </div>


                <a asp-controller="Booking"
                   asp-action="Create"
                   class="btn footer-book-btn">

                    Book Appointment

                    <i class="fa-solid fa-arrow-right"></i>

                </a>

            </div>
        }

    </div>

</section>


<style>

    /* =====================================================
           PAGE
           ===================================================== */

    .notifications-page {
        min-height: 100vh;
        padding: 45px 0 80px;
        background: #f8f5ec;
    }


    /* =====================================================
           HEADER
           ===================================================== */

    .notifications-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 30px;
        margin-bottom: 30px;
    }

    .section-label {
        display: block;
        margin-bottom: 8px;
        color: #987918;
        font-size: .64rem;
        font-weight: 800;
        letter-spacing: .17em;
    }

    .notifications-header h1 {
        margin-bottom: 8px;
        color: #181710;
        font-family: 'DM Serif Display', serif;
        font-size: clamp(2.5rem, 4vw, 3.8rem);
        font-weight: 400;
        line-height: 1;
    }

    .notifications-header p {
        max-width: 620px;
        margin: 0;
        color: #817b70;
        font-size: .8rem;
        line-height: 1.7;
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 9px;
        flex-shrink: 0;
    }

    .dashboard-btn,
    .mark-all-btn {
        min-height: 43px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 9px 16px;
        font-size: .68rem;
        font-weight: 700;
    }

    .dashboard-btn {
        border: 1px solid #ccc2af;
        background: transparent;
        color: #181710;
    }

        .dashboard-btn:hover {
            border-color: #181710;
            background: #181710;
            color: white;
        }

    .mark-all-btn {
        border: 1px solid #181710;
        background: #181710;
        color: white;
    }

        .mark-all-btn:hover {
            border-color: #e1bf4a;
            background: #e1bf4a;
            color: #181710;
        }


    /* =====================================================
           SUCCESS MESSAGE
           ===================================================== */

    .success-message {
        position: relative;
        display: flex;
        align-items: center;
        gap: 11px;
        margin-bottom: 20px;
        padding: 13px 45px 13px 15px;
        border: 1px solid #cedfce;
        border-radius: 12px;
        background: #edf5ed;
        color: #49644d;
        font-size: .69rem;
    }

        .success-message strong,
        .success-message span {
            display: block;
        }

        .success-message strong {
            margin-bottom: 2px;
            font-size: .68rem;
        }

    .success-icon {
        color: #59815e;
        font-size: .9rem;
    }

    .success-message .btn-close {
        position: absolute;
        right: 13px;
        top: 50%;
        transform: translateY(-50%);
        font-size: .6rem;
    }


    /* =====================================================
           SUMMARY
           ===================================================== */

    .notification-summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
        margin-bottom: 20px;
        padding: 24px 28px;
        border-radius: 18px;
        background: #181710;
        color: white;
    }

    .summary-main {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .summary-icon {
        width: 46px;
        height: 46px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #e1bf4a;
        color: #181710;
        font-size: .8rem;
    }

    .summary-main span {
        display: block;
        margin-bottom: 3px;
        color: #e1bf4a;
        font-size: .53rem;
        font-weight: 800;
        letter-spacing: .14em;
    }

    .summary-main h2 {
        margin: 0;
        font-family: 'DM Serif Display', serif;
        font-size: 1.55rem;
        font-weight: 400;
    }


    /* SUMMARY STATS */

    .summary-stats {
        display: flex;
        align-items: center;
        gap: 22px;
    }

    .summary-stat {
        text-align: center;
    }

        .summary-stat span,
        .summary-stat strong {
            display: block;
        }

        .summary-stat span {
            margin-bottom: 2px;
            color: rgba(255,255,255,.38);
            font-size: .51rem;
            font-weight: 800;
            letter-spacing: .1em;
        }

        .summary-stat strong {
            color: #e1bf4a;
            font-family: 'DM Serif Display', serif;
            font-size: 1.65rem;
            font-weight: 400;
            line-height: 1;
        }

    .summary-divider {
        width: 1px;
        height: 32px;
        background: rgba(255,255,255,.12);
    }


    /* =====================================================
           LIST
           ===================================================== */

    .notification-list {
        display: flex;
        flex-direction: column;
        gap: 11px;
    }


    /* =====================================================
           CARD
           ===================================================== */

    .notification-card {
        position: relative;
        display: flex;
        align-items: flex-start;
        gap: 15px;
        overflow: hidden;
        padding: 22px 24px;
        border: 1px solid #e2dacb;
        border-radius: 16px;
        background: #fffdf8;
        transition: all .22s ease;
    }

        .notification-card:hover {
            transform: translateY(-2px);
            border-color: #d0ba62;
            box-shadow: 0 12px 30px rgba(39,33,21,.055);
        }

    .notification-unread {
        background: #fffdf5;
    }

    .notification-read {
        background: #fbf9f4;
    }


    /* ICON */

    .notification-icon {
        width: 44px;
        height: 44px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #eee8dc;
        color: #82796b;
        font-size: .78rem;
    }

    .notification-unread .notification-icon {
        background: #181710;
        color: #e1bf4a;
    }


    /* CONTENT */

    .notification-content {
        flex: 1;
        min-width: 0;
    }

    .notification-top {
        display: flex;
        justify-content: space-between;
        gap: 15px;
    }

    .notification-title-area {
        flex: 1;
    }

    .notification-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 6px;
    }

    .notification-content h3 {
        margin-bottom: 7px;
        color: #28241e;
        font-family: 'DM Serif Display', serif;
        font-size: 1.25rem;
        font-weight: 400;
    }

    .notification-message {
        max-width: 950px;
        margin: 0;
        color: #777064;
        font-size: .72rem;
        line-height: 1.7;
    }


    /* =====================================================
           NEW / READ BADGES
           ===================================================== */

    .new-badge,
    .read-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 7px;
        border-radius: 999px;
        font-size: .49rem;
        font-weight: 800;
        letter-spacing: .07em;
    }

    .new-badge {
        background: #fff0ad;
        color: #695510;
    }

        .new-badge > span {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: #b88c0d;
        }

    .read-badge {
        background: #ece8df;
        color: #777064;
    }

        .read-badge i {
            font-size: .43rem;
        }


    /* DATE */

    .notification-date {
        color: #9b9488;
        font-size: .56rem;
        font-weight: 600;
    }

        .notification-date i {
            margin-right: 3px;
        }


    /* =====================================================
           ACTION
           ===================================================== */

    .notification-actions {
        margin-top: 14px;
    }

    .mark-read-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-height: 34px;
        padding: 6px 11px;
        border: 1px solid #d0c6b4;
        border-radius: 8px;
        background: transparent;
        color: #4b463d;
        font-size: .59rem;
        font-weight: 800;
        transition: all .2s ease;
    }

        .mark-read-btn:hover {
            border-color: #181710;
            background: #181710;
            color: #e1bf4a;
        }


    /* UNREAD EDGE */

    .unread-indicator {
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 4px;
        background: #e1bf4a;
    }


    /* =====================================================
           EMPTY STATE
           ===================================================== */

    .empty-notifications {
        position: relative;
        overflow: hidden;
        padding: 70px 25px;
        border-radius: 22px;
        background: #181710;
        color: white;
        text-align: center;
    }

    .empty-content {
        position: relative;
        z-index: 2;
        max-width: 560px;
        margin: auto;
    }

    .empty-icon {
        width: 65px;
        height: 65px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 22px;
        border-radius: 50%;
        background: #e1bf4a;
        color: #181710;
        font-size: 1.15rem;
    }

    .empty-content > span {
        display: block;
        margin-bottom: 8px;
        color: #e1bf4a;
        font-size: .58rem;
        font-weight: 800;
        letter-spacing: .16em;
    }

    .empty-content h2 {
        margin-bottom: 13px;
        font-family: 'DM Serif Display', serif;
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 400;
    }

    .empty-content p {
        margin-bottom: 24px;
        color: rgba(255,255,255,.48);
        font-size: .74rem;
        line-height: 1.75;
    }

    .empty-book-btn {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        border: 1px solid #e1bf4a;
        background: #e1bf4a;
        color: #181710;
        font-size: .67rem;
        font-weight: 700;
    }

        .empty-book-btn:hover {
            border-color: #d4af34;
            background: #d4af34;
            color: #181710;
        }

    .empty-orbit {
        position: absolute;
        border: 1px solid rgba(225,191,74,.07);
        border-radius: 50%;
    }

    .orbit-one {
        width: 330px;
        height: 330px;
        right: -180px;
        top: -190px;
    }

    .orbit-two {
        width: 230px;
        height: 230px;
        left: -130px;
        bottom: -150px;
    }


    /* =====================================================
           FOOTER
           ===================================================== */

    .notifications-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
        margin-top: 20px;
        padding: 25px 28px;
        border-radius: 17px;
        background: #24221c;
        color: white;
    }

        .notifications-footer > div {
            display: flex;
            align-items: center;
            gap: 13px;
        }

    .footer-icon {
        width: 42px;
        height: 42px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #e1bf4a;
        color: #181710;
        font-size: .72rem;
    }

    .notifications-footer span {
        display: block;
        margin-bottom: 3px;
        color: #e1bf4a;
        font-size: .52rem;
        font-weight: 800;
        letter-spacing: .13em;
    }

    .notifications-footer h3 {
        margin-bottom: 3px;
        font-family: 'DM Serif Display', serif;
        font-size: 1.2rem;
        font-weight: 400;
    }

    .notifications-footer p {
        margin: 0;
        color: rgba(255,255,255,.43);
        font-size: .62rem;
    }

    .footer-book-btn {
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        flex-shrink: 0;
        border: 1px solid #e1bf4a;
        background: #e1bf4a;
        color: #181710;
        font-size: .64rem;
        font-weight: 700;
    }

        .footer-book-btn:hover {
            border-color: #d4af34;
            background: #d4af34;
            color: #181710;
        }


    /* =====================================================
           RESPONSIVE
           ===================================================== */

    @@media (max-width: 991px) {

        .notifications-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .notification-summary {
            align-items: flex-start;
            flex-direction: column;
        }

        .notifications-footer {
            align-items: flex-start;
            flex-direction: column;
        }
    }


    @@media (max-width: 767px) {

        .notifications-page {
            padding-top: 30px;
        }

        .header-actions {
            width: 100%;
            flex-direction: column;
        }

            .header-actions form {
                width: 100%;
            }

        .dashboard-btn,
        .mark-all-btn {
            width: 100%;
        }

        .notification-summary {
            padding: 22px;
        }

        .summary-stats {
            width: 100%;
            justify-content: space-around;
        }

        .notification-card {
            padding: 19px 18px;
            gap: 11px;
        }

        .notification-icon {
            width: 39px;
            height: 39px;
        }

        .notifications-footer {
            padding: 23px 21px;
        }

        .footer-book-btn {
            width: 100%;
        }
    }


    @@media (max-width: 480px) {

        .notification-card {
            flex-direction: column;
        }

        .notification-meta {
            align-items: flex-start;
            flex-direction: column;
        }

        .mark-read-btn {
            width: 100%;
        }
    }

</style>