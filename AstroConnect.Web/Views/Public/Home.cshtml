@{
    ViewData["Title"] = "AstroConnect";
}

<!-- =========================================================
     HERO
     ========================================================= -->

<section class="astro-hero">

    <div class="hero-orbit orbit-one"></div>
    <div class="hero-orbit orbit-two"></div>

    <div class="container position-relative">

        <div class="row align-items-center min-vh-hero">

            <!-- LEFT CONTENT -->

            <div class="col-lg-7">

                <div class="hero-badge mb-4">

                    <i class="fa-solid fa-star"></i>

                    Trusted Astrology Guidance

                </div>


                <h1 class="hero-title">

                    Guidance for your

                    <span>
                        life's important moments.
                    </span>

                </h1>


                <p class="hero-description">

                    Connect with experienced astrologers for personalized
                    guidance in marriage, career, horoscope, Vasthu and
                    other important decisions in your life.

                </p>


                <div class="hero-actions">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Booking"
                           asp-action="Create"
                           class="btn hero-primary-btn">

                            Book Appointment

                            <i class="fa-solid fa-arrow-right ms-2"></i>

                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account"
                           asp-action="Register"
                           class="btn hero-primary-btn">

                            Book Appointment

                            <i class="fa-solid fa-arrow-right ms-2"></i>

                        </a>
                    }


                    <a href="#services"
                       class="btn hero-secondary-btn">

                        Explore Services

                    </a>

                </div>


                <!-- SMALL TRUST ITEMS -->

                <div class="hero-trust">

                    <div>

                        <i class="fa-solid fa-circle-check"></i>

                        Experienced Astrologers

                    </div>

                    <div>

                        <i class="fa-solid fa-circle-check"></i>

                        Easy Appointments

                    </div>

                    <div>

                        <i class="fa-solid fa-circle-check"></i>

                        Personal Guidance

                    </div>

                </div>

            </div>


            <!-- RIGHT VISUAL -->

            <div class="col-lg-5 mt-5 mt-lg-0">

                <div class="zodiac-visual">

                    <div class="zodiac-outer">

                        <span class="zodiac-symbol symbol-1">♈</span>
                        <span class="zodiac-symbol symbol-2">♉</span>
                        <span class="zodiac-symbol symbol-3">♊</span>
                        <span class="zodiac-symbol symbol-4">♋</span>
                        <span class="zodiac-symbol symbol-5">♌</span>
                        <span class="zodiac-symbol symbol-6">♍</span>
                        <span class="zodiac-symbol symbol-7">♎</span>
                        <span class="zodiac-symbol symbol-8">♏</span>

                        <div class="zodiac-middle">

                            <div class="zodiac-center">

                                <i class="fa-solid fa-moon"></i>

                                <small>
                                    ASTRO
                                </small>

                                <strong>
                                    CONNECT
                                </strong>

                            </div>

                        </div>

                    </div>


                    <div class="floating-card floating-card-one">

                        <div class="floating-icon">

                            <i class="fa-solid fa-star"></i>

                        </div>

                        <div>

                            <small>
                                Personalized
                            </small>

                            <strong>
                                Guidance
                            </strong>

                        </div>

                    </div>


                    <div class="floating-card floating-card-two">

                        <div class="floating-icon">

                            <i class="fa-solid fa-calendar-check"></i>

                        </div>

                        <div>

                            <small>
                                Simple
                            </small>

                            <strong>
                                Booking
                            </strong>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     SERVICES
     ========================================================= -->

<section id="services"
         class="services-section">

    <div class="container">

        <div class="section-heading">

            <div>

                <span class="section-label">
                    OUR SERVICES
                </span>

                <h2>
                    Guidance for every chapter of life.
                </h2>

            </div>


            <a asp-controller="Public"
               asp-action="Services"
               class="section-link">

                View all services

                <i class="fa-solid fa-arrow-right ms-1"></i>

            </a>

        </div>


        <div class="row g-4">


            <!-- MARRIAGE -->

            <div class="col-md-6 col-lg-3">

                <div class="service-card">

                    <div class="service-number">
                        01
                    </div>

                    <div class="service-icon">

                        <i class="fa-solid fa-heart"></i>

                    </div>

                    <h4>
                        Marriage
                    </h4>

                    <p>

                        Personalized relationship and marriage
                        consultation for important life decisions.

                    </p>

                    <a asp-controller="Public"
                       asp-action="Services">

                        Learn more

                        <i class="fa-solid fa-arrow-right"></i>

                    </a>

                </div>

            </div>


            <!-- CAREER -->

            <div class="col-md-6 col-lg-3">

                <div class="service-card">

                    <div class="service-number">
                        02
                    </div>

                    <div class="service-icon">

                        <i class="fa-solid fa-briefcase"></i>

                    </div>

                    <h4>
                        Career
                    </h4>

                    <p>

                        Understand career opportunities, professional
                        direction and important career decisions.

                    </p>

                    <a asp-controller="Public"
                       asp-action="Services">

                        Learn more

                        <i class="fa-solid fa-arrow-right"></i>

                    </a>

                </div>

            </div>


            <!-- HOROSCOPE -->

            <div class="col-md-6 col-lg-3">

                <div class="service-card">

                    <div class="service-number">
                        03
                    </div>

                    <div class="service-icon">

                        <i class="fa-solid fa-star"></i>

                    </div>

                    <h4>
                        Horoscope
                    </h4>

                    <p>

                        Explore your horoscope with personalized
                        insights based on your birth information.

                    </p>

                    <a asp-controller="Public"
                       asp-action="Services">

                        Learn more

                        <i class="fa-solid fa-arrow-right"></i>

                    </a>

                </div>

            </div>


            <!-- VASTHU -->

            <div class="col-md-6 col-lg-3">

                <div class="service-card">

                    <div class="service-number">
                        04
                    </div>

                    <div class="service-icon">

                        <i class="fa-solid fa-house"></i>

                    </div>

                    <h4>
                        Vasthu
                    </h4>

                    <p>

                        Practical Vasthu consultation for your
                        home, property and business environment.

                    </p>

                    <a asp-controller="Public"
                       asp-action="Services">

                        Learn more

                        <i class="fa-solid fa-arrow-right"></i>

                    </a>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     WHY ASTROCONNECT
     ========================================================= -->

<section class="why-section">

    <div class="container">

        <div class="row align-items-center g-5">


            <!-- LEFT -->

            <div class="col-lg-5">

                <span class="section-label light-label">
                    WHY ASTROCONNECT
                </span>


                <h2 class="why-title">

                    Astrology made

                    <span>
                        simple and personal.
                    </span>

                </h2>


                <p class="why-description">

                    AstroConnect makes it easy to find the right
                    astrologer, select a suitable appointment and
                    receive guidance without complicated booking
                    processes.

                </p>


                <a asp-controller="Public"
                   asp-action="About"
                   class="btn why-button">

                    Discover AstroConnect

                    <i class="fa-solid fa-arrow-right ms-2"></i>

                </a>

            </div>


            <!-- RIGHT -->

            <div class="col-lg-7">

                <div class="row g-3">


                    <div class="col-md-6">

                        <div class="benefit-card">

                            <span>
                                01
                            </span>

                            <i class="fa-solid fa-user-check"></i>

                            <h4>
                                Experienced Astrologers
                            </h4>

                            <p>

                                Connect with astrologers who provide
                                thoughtful and personalized consultation.

                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="benefit-card">

                            <span>
                                02
                            </span>

                            <i class="fa-solid fa-calendar-check"></i>

                            <h4>
                                Easy Booking
                            </h4>

                            <p>

                                Select your astrologer, service, date and
                                available appointment time in a few steps.

                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="benefit-card">

                            <span>
                                03
                            </span>

                            <i class="fa-solid fa-bell"></i>

                            <h4>
                                Booking Updates
                            </h4>

                            <p>

                                Stay informed when your appointment is
                                confirmed, completed or cancelled.

                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="benefit-card">

                            <span>
                                04
                            </span>

                            <i class="fa-solid fa-headset"></i>

                            <h4>
                                Friendly Support
                            </h4>

                            <p>

                                Our receptionist workflow helps keep
                                appointments organized and customers supported.

                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     HOW IT WORKS
     ========================================================= -->

<section class="process-section">

    <div class="container">

        <div class="text-center process-heading">

            <span class="section-label">
                SIMPLE PROCESS
            </span>

            <h2>
                Your consultation in three steps.
            </h2>

            <p>

                Getting personalized astrology guidance
                should be simple.

            </p>

        </div>


        <div class="row g-4 process-row">


            <div class="col-md-4">

                <div class="process-item">

                    <div class="process-icon">
                        1
                    </div>

                    <h4>
                        Choose your service
                    </h4>

                    <p>

                        Select the consultation that best matches
                        the guidance you are looking for.

                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="process-item">

                    <div class="process-icon">
                        2
                    </div>

                    <h4>
                        Select an appointment
                    </h4>

                    <p>

                        Choose your astrologer, preferred date
                        and an available appointment slot.

                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="process-item">

                    <div class="process-icon">
                        3
                    </div>

                    <h4>
                        Receive guidance
                    </h4>

                    <p>

                        Track your booking and receive updates
                        throughout your appointment journey.

                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     ASTROLOGERS CTA
     ========================================================= -->

<section class="astrologer-preview-section">

    <div class="container">

        <div class="astrologer-preview-card">

            <div class="row align-items-center g-4">

                <div class="col-lg-8">

                    <span class="section-label light-label">
                        OUR ASTROLOGERS
                    </span>

                    <h2>

                        Meet the people behind
                        your guidance.

                    </h2>

                    <p>

                        Explore our astrologers, their experience,
                        specializations and consultation expertise
                        before booking your appointment.

                    </p>

                </div>


                <div class="col-lg-4 text-lg-end">

                    <a asp-controller="Public"
                       asp-action="Astrologers"
                       class="btn astrologer-button">

                        Meet Our Astrologers

                        <i class="fa-solid fa-arrow-right ms-2"></i>

                    </a>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     FINAL CTA
     ========================================================= -->

<section class="final-cta-section">

    <div class="container">

        <div class="final-cta">

            <div class="cta-stars">

                <i class="fa-solid fa-star"></i>

                <i class="fa-solid fa-star"></i>

                <i class="fa-solid fa-star"></i>

            </div>


            <h2>

                Ready to find the guidance
                you're looking for?

            </h2>


            <p>

                Book a personalized consultation with
                AstroConnect today.

            </p>


            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Booking"
                   asp-action="Create"
                   class="btn final-cta-button">

                    Book Your Appointment

                    <i class="fa-solid fa-arrow-right ms-2"></i>

                </a>
            }
            else
            {
                <a asp-controller="Account"
                   asp-action="Register"
                   class="btn final-cta-button">

                    Get Started

                    <i class="fa-solid fa-arrow-right ms-2"></i>

                </a>
            }

        </div>

    </div>

</section>


<!-- =========================================================
     PAGE STYLES
     ========================================================= -->

<style>

    /* =====================================================
           HERO
           ===================================================== */

    .astro-hero {
        position: relative;
        overflow: hidden;
        background: #181710;
        color: white;
    }

    .min-vh-hero {
        min-height: 680px;
        padding-top: 75px;
        padding-bottom: 75px;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 9px 15px;
        border: 1px solid rgba(225,191,74,.32);
        border-radius: 999px;
        background: rgba(225,191,74,.08);
        color: #e1bf4a;
        font-size: .76rem;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .hero-title {
        max-width: 760px;
        margin: 0;
        color: #fff;
        font-family: 'DM Serif Display', serif;
        font-size: clamp(3.4rem, 6vw, 6rem);
        font-weight: 400;
        line-height: .98;
        letter-spacing: -.04em;
    }

        .hero-title span {
            display: block;
            color: #e1bf4a;
        }

    .hero-description {
        max-width: 650px;
        margin-top: 27px;
        color: rgba(255,255,255,.67);
        font-size: 1.05rem;
        line-height: 1.85;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 13px;
        margin-top: 32px;
    }

    .hero-primary-btn,
    .hero-secondary-btn {
        min-height: 52px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 23px;
        font-size: .88rem;
        font-weight: 800;
    }

    .hero-primary-btn {
        background: #e1bf4a;
        border: 1px solid #e1bf4a;
        color: #181710;
    }

        .hero-primary-btn:hover {
            background: #d3ae32;
            border-color: #d3ae32;
            color: #181710;
            transform: translateY(-2px);
        }

    .hero-secondary-btn {
        border: 1px solid rgba(255,255,255,.22);
        color: white;
        background: transparent;
    }

        .hero-secondary-btn:hover {
            border-color: rgba(255,255,255,.4);
            background: rgba(255,255,255,.07);
            color: white;
        }

    .hero-trust {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        margin-top: 38px;
        color: rgba(255,255,255,.55);
        font-size: .75rem;
        font-weight: 600;
    }

        .hero-trust i {
            color: #e1bf4a;
            margin-right: 5px;
        }


    /* DECORATIVE ORBITS */

    .hero-orbit {
        position: absolute;
        border: 1px solid rgba(225,191,74,.07);
        border-radius: 50%;
        pointer-events: none;
    }

    .orbit-one {
        width: 700px;
        height: 700px;
        right: -250px;
        top: -250px;
    }

    .orbit-two {
        width: 500px;
        height: 500px;
        left: -300px;
        bottom: -300px;
    }


    /* =====================================================
           ZODIAC VISUAL
           ===================================================== */

    .zodiac-visual {
        position: relative;
        width: min(440px, 100%);
        aspect-ratio: 1;
        margin-left: auto;
        margin-right: auto;
    }

    .zodiac-outer {
        position: absolute;
        inset: 4%;
        border: 1px solid rgba(225,191,74,.25);
        border-radius: 50%;
        animation: slowSpin 40s linear infinite;
    }

        .zodiac-outer::before {
            content: "";
            position: absolute;
            inset: 9%;
            border: 1px dashed rgba(255,255,255,.12);
            border-radius: 50%;
        }

    .zodiac-middle {
        position: absolute;
        inset: 25%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(225,191,74,.3);
        border-radius: 50%;
        background: radial-gradient( circle, rgba(225,191,74,.12), rgba(225,191,74,.02) 60%, transparent 61% );
        animation: reverseSpin 40s linear infinite;
    }

    .zodiac-center {
        width: 150px;
        height: 150px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #e1bf4a;
        color: #181710;
        box-shadow: 0 0 60px rgba(225,191,74,.17);
    }

        .zodiac-center i {
            font-size: 32px;
            margin-bottom: 7px;
        }

        .zodiac-center small {
            font-size: .62rem;
            font-weight: 800;
            letter-spacing: .25em;
        }

        .zodiac-center strong {
            font-size: 1rem;
            letter-spacing: .08em;
        }

    .zodiac-symbol {
        position: absolute;
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #24221c;
        border: 1px solid rgba(225,191,74,.3);
        color: #e1bf4a;
        font-size: 1rem;
    }

    .symbol-1 {
        left: 50%;
        top: -19px;
        transform: translateX(-50%);
    }

    .symbol-2 {
        right: 9%;
        top: 11%;
    }

    .symbol-3 {
        right: -19px;
        top: 50%;
        transform: translateY(-50%);
    }

    .symbol-4 {
        right: 9%;
        bottom: 11%;
    }

    .symbol-5 {
        left: 50%;
        bottom: -19px;
        transform: translateX(-50%);
    }

    .symbol-6 {
        left: 9%;
        bottom: 11%;
    }

    .symbol-7 {
        left: -19px;
        top: 50%;
        transform: translateY(-50%);
    }

    .symbol-8 {
        left: 9%;
        top: 11%;
    }

    @@keyframes slowSpin {

        from {
            transform: rotate(0);
        }

        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes reverseSpin {

        from {
            transform: rotate(0);
        }

        to {
            transform: rotate(-360deg);
        }
    }


    /* FLOATING CARDS */

    .floating-card {
        position: absolute;
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 160px;
        padding: 12px 15px;
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 14px;
        background: rgba(31,29,23,.88);
        backdrop-filter: blur(10px);
        box-shadow: 0 16px 35px rgba(0,0,0,.2);
    }

    .floating-card-one {
        left: -12px;
        bottom: 25%;
    }

    .floating-card-two {
        right: -12px;
        top: 23%;
    }

    .floating-icon {
        width: 36px;
        height: 36px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: rgba(225,191,74,.13);
        color: #e1bf4a;
    }

    .floating-card small,
    .floating-card strong {
        display: block;
    }

    .floating-card small {
        color: rgba(255,255,255,.5);
        font-size: .62rem;
    }

    .floating-card strong {
        color: white;
        font-size: .77rem;
    }


    /* =====================================================
           COMMON SECTION
           ===================================================== */

    .section-label {
        display: block;
        margin-bottom: 12px;
        color: #91751b;
        font-size: .7rem;
        font-weight: 800;
        letter-spacing: .18em;
    }

    .light-label {
        color: #e1bf4a;
    }


    /* =====================================================
           SERVICES
           ===================================================== */

    .services-section {
        padding: 105px 0;
        background: #f8f5ec;
    }

    .section-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 30px;
        margin-bottom: 45px;
    }

        .section-heading h2,
        .process-heading h2 {
            max-width: 650px;
            margin: 0;
            font-family: 'DM Serif Display', serif;
            font-size: clamp(2.3rem, 4vw, 3.7rem);
            font-weight: 400;
            line-height: 1.05;
            color: #181710;
        }

    .section-link {
        color: #181710;
        text-decoration: none;
        font-size: .82rem;
        font-weight: 800;
    }

        .section-link:hover {
            color: #91751b;
        }

    .service-card {
        position: relative;
        height: 100%;
        padding: 30px;
        border: 1px solid #e5dece;
        border-radius: 20px;
        background: #fffdf8;
        transition: all .3s ease;
    }

        .service-card:hover {
            transform: translateY(-7px);
            border-color: #d7c36d;
            box-shadow: 0 22px 45px rgba(42,35,22,.09);
        }

    .service-number {
        position: absolute;
        right: 25px;
        top: 22px;
        color: #d8d1c1;
        font-family: 'DM Serif Display', serif;
        font-size: 1.6rem;
    }

    .service-icon {
        width: 54px;
        height: 54px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 25px;
        border-radius: 50%;
        background: #fff0ad;
        color: #5f4c0f;
        font-size: 1.1rem;
    }

    .service-card h4 {
        margin-bottom: 13px;
        color: #181710;
        font-family: 'DM Serif Display', serif;
        font-size: 1.5rem;
        font-weight: 400;
    }

    .service-card p {
        min-height: 88px;
        color: #777267;
        font-size: .84rem;
        line-height: 1.75;
    }

    .service-card a {
        color: #181710;
        text-decoration: none;
        font-size: .75rem;
        font-weight: 800;
    }

        .service-card a i {
            margin-left: 5px;
            font-size: .65rem;
        }


    /* =====================================================
           WHY
           ===================================================== */

    .why-section {
        padding: 105px 0;
        background: #181710;
        color: white;
    }

    .why-title {
        max-width: 520px;
        margin-top: 0;
        margin-bottom: 24px;
        font-family: 'DM Serif Display', serif;
        font-size: clamp(2.5rem, 4.5vw, 4.3rem);
        font-weight: 400;
        line-height: 1;
        color: white;
    }

        .why-title span {
            color: #e1bf4a;
        }

    .why-description {
        max-width: 500px;
        margin-bottom: 28px;
        color: rgba(255,255,255,.6);
        font-size: .9rem;
        line-height: 1.85;
    }

    .why-button {
        min-height: 49px;
        display: inline-flex;
        align-items: center;
        background: #e1bf4a;
        color: #181710;
        border: none;
        padding: 10px 21px;
    }

        .why-button:hover {
            background: #d3ae32;
