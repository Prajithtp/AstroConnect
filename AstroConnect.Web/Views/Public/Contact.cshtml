@{
    ViewData["Title"] = "Contact Us";
}

<!-- =========================================================
     HERO
     ========================================================= -->

<section class="contact-hero">

    <div class="hero-orbit orbit-one"></div>
    <div class="hero-orbit orbit-two"></div>

    <div class="container position-relative">

        <div class="contact-hero-content">

            <span class="section-label">
                CONTACT ASTROCONNECT
            </span>

            <h1>
                We're here when you
                <span>need a little guidance.</span>
            </h1>

            <p>
                Have a question about a service, booking or appointment?
                Get in touch with AstroConnect and we'll be happy to help.
            </p>

        </div>

    </div>

</section>


<!-- =========================================================
     CONTACT INFORMATION
     ========================================================= -->

<section class="contact-section">

    <div class="container">

        <div class="contact-heading">

            <div>

                <span class="section-label dark-label">
                    GET IN TOUCH
                </span>

                <h2>
                    We'd love to hear from you.
                </h2>

            </div>

            <p>
                Reach out for appointment questions,
                service information or general support.
            </p>

        </div>


        <div class="row g-4 mb-5">

            <!-- LOCATION -->

            <div class="col-md-6 col-xl-3">

                <div class="contact-info-card">

                    <div class="contact-icon">

                        <i class="fa-solid fa-location-dot"></i>

                    </div>

                    <span class="contact-label">
                        LOCATION
                    </span>

                    <h4>
                        Kozhikode
                    </h4>

                    <p>
                        Kerala, India
                    </p>

                </div>

            </div>


            <!-- PHONE -->

            <div class="col-md-6 col-xl-3">

                <div class="contact-info-card">

                    <div class="contact-icon">

                        <i class="fa-solid fa-phone"></i>

                    </div>

                    <span class="contact-label">
                        PHONE
                    </span>

                    <h4>
                        Call Us
                    </h4>

                    <p>
                        +91 98765 43210
                    </p>

                </div>

            </div>


            <!-- EMAIL -->

            <div class="col-md-6 col-xl-3">

                <div class="contact-info-card">

                    <div class="contact-icon">

                        <i class="fa-solid fa-envelope"></i>

                    </div>

                    <span class="contact-label">
                        EMAIL
                    </span>

                    <h4>
                        Write to Us
                    </h4>

                    <p>
                        support@astroconnect.com
                    </p>

                </div>

            </div>


            <!-- HOURS -->

            <div class="col-md-6 col-xl-3">

                <div class="contact-info-card">

                    <div class="contact-icon">

                        <i class="fa-solid fa-clock"></i>

                    </div>

                    <span class="contact-label">
                        WORKING HOURS
                    </span>

                    <h4>
                        Mon – Sat
                    </h4>

                    <p>
                        9:00 AM – 7:00 PM
                    </p>

                </div>

            </div>

        </div>


        <!-- =================================================
             CONTACT FORM + SUPPORT PANEL
             ================================================= -->

        <div class="row g-4 align-items-stretch">

            <!-- FORM -->

            <div class="col-lg-7">

                <div class="contact-form-card h-100">

                    <span class="section-label dark-label">
                        SEND A MESSAGE
                    </span>

                    <h3>
                        How can we help?
                    </h3>

                    <p class="form-intro">
                        Fill out the form below and our team will get
                        back to you as soon as possible.
                    </p>


                    <form>

                        <div class="row g-3">

                            <div class="col-md-6">

                                <label class="form-label">
                                    Full Name
                                </label>

                                <input type="text"
                                       class="form-control"
                                       placeholder="Enter your name" />

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Email Address
                                </label>

                                <input type="email"
                                       class="form-control"
                                       placeholder="Enter your email" />

                            </div>


                            <div class="col-12">

                                <label class="form-label">
                                    Subject
                                </label>

                                <input type="text"
                                       class="form-control"
                                       placeholder="How can we help?" />

                            </div>


                            <div class="col-12">

                                <label class="form-label">
                                    Message
                                </label>

                                <textarea rows="6"
                                          class="form-control"
                                          placeholder="Write your message"></textarea>

                            </div>


                            <div class="col-12">

                                <button type="button"
                                        class="btn send-btn">

                                    Send Message

                                    <i class="fa-solid fa-arrow-right ms-2"></i>

                                </button>

                            </div>

                        </div>

                    </form>

                </div>

            </div>


            <!-- SUPPORT -->

            <div class="col-lg-5">

                <div class="support-card h-100">

                    <span class="section-label light-label">
                        NEED APPOINTMENT HELP?
                    </span>

                    <h2>
                        Planning your consultation?
                    </h2>

                    <p>
                        If you are ready to book, you can explore
                        our services and astrologers before selecting
                        a convenient appointment time.
                    </p>


                    <div class="support-list">

                        <div>

                            <i class="fa-solid fa-circle-check"></i>

                            <span>
                                Explore available services
                            </span>

                        </div>

                        <div>

                            <i class="fa-solid fa-circle-check"></i>

                            <span>
                                Review astrologer profiles
                            </span>

                        </div>

                        <div>

                            <i class="fa-solid fa-circle-check"></i>

                            <span>
                                Select an available time slot
                            </span>

                        </div>

                        <div>

                            <i class="fa-solid fa-circle-check"></i>

                            <span>
                                Track your appointment status
                            </span>

                        </div>

                    </div>


                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Booking"
                           asp-action="Create"
                           class="btn support-button">

                            Book Appointment

                            <i class="fa-solid fa-arrow-right ms-2"></i>

                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account"
                           asp-action="Register"
                           class="btn support-button">

                            Get Started

                            <i class="fa-solid fa-arrow-right ms-2"></i>

                        </a>
                    }

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     LOCATION / VISUAL SECTION
     ========================================================= -->

<section class="location-section">

    <div class="container">

        <div class="location-card">

            <div class="location-visual">

                <div class="location-pin">

                    <i class="fa-solid fa-location-dot"></i>

                </div>

                <div class="location-ring ring-one"></div>
                <div class="location-ring ring-two"></div>
                <div class="location-ring ring-three"></div>

            </div>


            <div class="location-content">

                <span class="section-label dark-label">
                    OUR LOCATION
                </span>

                <h2>
                    Based in Kozhikode, Kerala.
                </h2>

                <p>
                    AstroConnect provides an organized digital appointment
                    experience for customers looking for astrology
                    consultation and guidance.
                </p>

            </div>

        </div>

    </div>

</section>


<style>

    /* =====================================================
           COMMON
           ===================================================== */

    .section-label {
        display: block;
        margin-bottom: 14px;
        color: #e1bf4a;
        font-size: .7rem;
        font-weight: 800;
        letter-spacing: .18em;
    }

    .dark-label {
        color: #987918;
    }

    .light-label {
        color: #e1bf4a;
    }


    /* =====================================================
           HERO
           ===================================================== */

    .contact-hero {
        position: relative;
        overflow: hidden;
        padding: 105px 0 95px;
        background: #181710;
        color: white;
    }

    .contact-hero-content {
        position: relative;
        z-index: 2;
        max-width: 850px;
    }

    .contact-hero h1 {
        margin: 0;
        font-family: 'DM Serif Display', serif;
        font-size: clamp(3rem, 6vw, 5.4rem);
        font-weight: 400;
        line-height: 1;
        letter-spacing: -.035em;
    }

        .contact-hero h1 span {
            display: block;
            color: #e1bf4a;
        }

    .contact-hero p {
        max-width: 650px;
        margin-top: 25px;
        margin-bottom: 0;
        color: rgba(255,255,255,.62);
        font-size: 1rem;
        line-height: 1.8;
    }

    .hero-orbit {
        position: absolute;
        border: 1px solid rgba(225,191,74,.08);
        border-radius: 50%;
    }

    .orbit-one {
        width: 500px;
        height: 500px;
        right: -170px;
        top: -270px;
    }

    .orbit-two {
        width: 300px;
        height: 300px;
        right: 80px;
        bottom: -220px;
    }


    /* =====================================================
           CONTACT SECTION
           ===================================================== */

    .contact-section {
        padding: 105px 0;
        background: #f8f5ec;
    }

    .contact-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 35px;
        margin-bottom: 48px;
    }

        .contact-heading h2 {
            margin: 0;
            color: #181710;
            font-family: 'DM Serif Display', serif;
            font-size: clamp(2.4rem, 4vw, 3.7rem);
            font-weight: 400;
            line-height: 1;
        }

        .contact-heading > p {
            max-width: 450px;
            margin: 0;
            color: #777267;
            font-size: .86rem;
            line-height: 1.75;
        }


    /* =====================================================
           INFO CARDS
           ===================================================== */

    .contact-info-card {
        height: 100%;
        padding: 27px;
        border: 1px solid #e4ddce;
        border-radius: 18px;
        background: #fffdf8;
        transition: all .25s ease;
    }

        .contact-info-card:hover {
            transform: translateY(-5px);
            border-color: #d3bc61;
            box-shadow: 0 18px 38px rgba(38,32,20,.07);
        }

    .contact-icon {
        width: 47px;
        height: 47px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 19px;
        border-radius: 50%;
        background: #fff0ad;
        color: #64500e;
    }

    .contact-label {
        display: block;
        margin-bottom: 5px;
        color: #9b9589;
        font-size: .62rem;
        font-weight: 800;
        letter-spacing: .1em;
    }

    .contact-info-card h4 {
        margin-bottom: 6px;
        color: #181710;
        font-family: 'DM Serif Display', serif;
        font-size: 1.3rem;
        font-weight: 400;
    }

    .contact-info-card p {
        margin: 0;
        color: #777267;
        font-size: .79rem;
        word-break: break-word;
    }


    /* =====================================================
           FORM
           ===================================================== */

    .contact-form-card {
        padding: 38px;
        border: 1px solid #e4ddce;
        border-radius: 22px;
        background: #fffdf8;
    }

        .contact-form-card h3 {
            margin-bottom: 10px;
            color: #181710;
            font-family: 'DM Serif Display', serif;
            font-size: 2rem;
            font-weight: 400;
        }

    .form-intro {
        max-width: 560px;
        margin-bottom: 28px;
        color: #777267;
        font-size: .84rem;
        line-height: 1.7;
    }

    .contact-form-card .form-label {
        margin-bottom: 7px;
        color: #4e493f;
        font-size: .73rem;
        font-weight: 800;
    }

    .contact-form-card .form-control {
        min-height: 48px;
        border-color: #ddd5c5;
        border-radius: 12px;
        background: #fbf8f0;
        font-size: .82rem;
    }

    .contact-form-card textarea.form-control {
        min-height: 150px;
        resize: vertical;
    }

    .contact-form-card .form-control:focus {
        background: white;
        border-color: #c5a849;
        box-shadow: 0 0 0 .2rem rgba(225,191,74,.14);
    }

    .send-btn {
        min-height: 50px;
        display: inline-flex;
        align-items: center;
        margin-top: 7px;
        padding: 11px 23px;
        background: #181710;
        border: 1px solid #181710;
        color: white;
    }

        .send-btn:hover {
            background: #e1bf4a;
            border-color: #e1bf4a;
            color: #181710;
            transform: translateY(-1px);
        }


    /* =====================================================
           SUPPORT
           ===================================================== */

    .support-card {
        padding: 40px;
        border-radius: 22px;
        background: radial-gradient( circle at 85% 10%, rgba(225,191,74,.14), transparent 27% ), #211f19;
        color: white;
    }

        .support-card h2 {
            margin-bottom: 17px;
            font-family: 'DM Serif Display', serif;
            font-size: clamp(2.1rem, 3.5vw, 3rem);
            font-weight: 400;
            line-height: 1.05;
        }

        .support-card > p {
            margin-bottom: 28px;
            color: rgba(255,255,255,.56);
            font-size: .84rem;
            line-height: 1.8;
        }

    .support-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
        margin-bottom: 32px;
    }

        .support-list > div {
            display: flex;
            align-items: center;
            gap: 9px;
            color: rgba(255,255,255,.76);
            font-size: .78rem;
            font-weight: 600;
        }

        .support-list i {
            color: #e1bf4a;
        }

    .support-button {
        min-height: 49px;
        display: inline-flex;
        align-items: center;
        background: #e1bf4a;
        border: none;
        color: #181710;
    }

        .support-button:hover {
            background: #d3ae32;
            color: #181710;
            transform: translateY(-2px);
        }


    /* =====================================================
           LOCATION
           ===================================================== */

    .location-section {
        padding: 10px 0 105px;
        background: #f8f5ec;
    }

    .location-card {
        display: grid;
        grid-template-columns: .9fr 1.1fr;
        overflow: hidden;
        border: 1px solid #e4ddce;
        border-radius: 24px;
        background: #fffdf8;
    }

    .location-visual {
        position: relative;
        min-height: 330px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background: #24221c;
    }

    .location-pin {
        position: relative;
        z-index: 4;
        width: 72px;
        height: 72px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #e1bf4a;
        color: #181710;
        font-size: 27px;
    }

    .location-ring {
        position: absolute;
        border: 1px solid rgba(225,191,74,.16);
        border-radius: 50%;
    }

    .ring-one {
        width: 160px;
        height: 160px;
    }

    .ring-two {
        width: 260px;
        height: 260px;
    }

    .ring-three {
        width: 380px;
        height: 380px;
    }

    .location-content {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 55px;
    }

        .location-content h2 {
            margin-bottom: 15px;
            color: #181710;
            font-family: 'DM Serif Display', serif;
            font-size: clamp(2.1rem, 4vw, 3.3rem);
            font-weight: 400;
            line-height: 1.05;
        }

        .location-content p {
            max-width: 560px;
            margin: 0;
            color: #777267;
            font-size: .86rem;
            line-height: 1.8;
        }


    /* =====================================================
           RESPONSIVE
           ===================================================== */

    @@media (max-width: 991px) {

        .contact-heading {
            flex-direction: column;
            align-items: flex-start;
        }

        .location-card {
            grid-template-columns: 1fr;
        }

        .location-visual {
            min-height: 280px;
        }
    }


    @@media (max-width: 575px) {

        .contact-hero {
            padding: 75px 0;
        }

        .contact-section {
            padding: 75px 0;
        }

        .contact-form-card,
        .support-card {
            padding: 30px 22px;
        }

        .send-btn,
        .support-button {
            width: 100%;
            justify-content: center;
        }

        .location-content {
            padding: 38px 25px;
        }
    }

</style>