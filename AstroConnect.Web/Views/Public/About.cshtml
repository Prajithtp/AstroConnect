@{
    ViewData["Title"] = "About Us";
}

<!-- =========================================================
     HERO
     ========================================================= -->

<section class="about-hero">

    <div class="hero-orbit orbit-one"></div>
    <div class="hero-orbit orbit-two"></div>

    <div class="container position-relative">

        <div class="about-hero-content">

            <span class="section-label">
                ABOUT ASTROCONNECT
            </span>

            <h1>
                Astrology guidance made
                <span>simple and personal.</span>
            </h1>

            <p>
                AstroConnect brings customers and experienced astrologers
                together through a simple, organized and convenient
                appointment booking experience.
            </p>

        </div>

    </div>

</section>


<!-- =========================================================
     OUR STORY
     ========================================================= -->

<section class="story-section">

    <div class="container">

        <div class="row align-items-center g-5">

            <!-- LEFT VISUAL -->

            <div class="col-lg-5">

                <div class="story-visual">

                    <div class="story-orbit">

                        <div class="story-center">

                            <i class="fa-solid fa-moon"></i>

                            <small>
                                ASTRO
                            </small>

                            <strong>
                                CONNECT
                            </strong>

                        </div>


                        <span class="story-star star-one">
                            <i class="fa-solid fa-star"></i>
                        </span>

                        <span class="story-star star-two">
                            <i class="fa-solid fa-star"></i>
                        </span>

                        <span class="story-star star-three">
                            <i class="fa-solid fa-star"></i>
                        </span>

                        <span class="story-star star-four">
                            <i class="fa-solid fa-star"></i>
                        </span>

                    </div>

                </div>

            </div>


            <!-- RIGHT CONTENT -->

            <div class="col-lg-7">

                <span class="section-label dark-label">
                    OUR PURPOSE
                </span>

                <h2 class="story-title">
                    Connecting people with guidance when it matters.
                </h2>

                <p class="story-text">
                    Finding the right astrology consultation should not
                    require a complicated process. AstroConnect was designed
                    to make appointment booking clear and convenient for
                    customers while helping astrologers and reception staff
                    manage consultations efficiently.
                </p>

                <p class="story-text">
                    Customers can explore available services and astrologers,
                    choose a suitable appointment slot, provide the necessary
                    birth information and follow their booking from request
                    through completion.
                </p>


                <div class="story-points">

                    <div>

                        <i class="fa-solid fa-circle-check"></i>

                        <span>
                            Simple appointment booking
                        </span>

                    </div>


                    <div>

                        <i class="fa-solid fa-circle-check"></i>

                        <span>
                            Personalized consultation information
                        </span>

                    </div>


                    <div>

                        <i class="fa-solid fa-circle-check"></i>

                        <span>
                            Clear booking status updates
                        </span>

                    </div>


                    <div>

                        <i class="fa-solid fa-circle-check"></i>

                        <span>
                            Organized appointment management
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     MISSION
     ========================================================= -->

<section class="mission-section">

    <div class="container">

        <div class="row align-items-center g-5">

            <!-- LEFT -->

            <div class="col-lg-5">

                <span class="section-label light-label">
                    OUR MISSION
                </span>

                <h2 class="mission-title">
                    A better way to organize
                    <span>astrology consultations.</span>
                </h2>

                <p class="mission-description">
                    Our goal is to create a comfortable connection between
                    customers and astrologers while making every stage of
                    the appointment process easier to understand and manage.
                </p>

            </div>


            <!-- RIGHT -->

            <div class="col-lg-7">

                <div class="row g-3">

                    <div class="col-md-6">

                        <div class="mission-card">

                            <div class="mission-number">
                                01
                            </div>

                            <div class="mission-icon">

                                <i class="fa-solid fa-user-check"></i>

                            </div>

                            <h4>
                                Experienced Guidance
                            </h4>

                            <p>
                                Customers can explore astrologer profiles,
                                specializations and experience before
                                choosing a consultation.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="mission-card">

                            <div class="mission-number">
                                02
                            </div>

                            <div class="mission-icon">

                                <i class="fa-solid fa-calendar-check"></i>

                            </div>

                            <h4>
                                Easy Scheduling
                            </h4>

                            <p>
                                Available appointment slots help customers
                                choose a convenient date and time without
                                conflicting bookings.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="mission-card">

                            <div class="mission-number">
                                03
                            </div>

                            <div class="mission-icon">

                                <i class="fa-solid fa-bell"></i>

                            </div>

                            <h4>
                                Clear Updates
                            </h4>

                            <p>
                                Customers can follow their booking status
                                and receive notifications when important
                                appointment changes occur.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="mission-card">

                            <div class="mission-number">
                                04
                            </div>

                            <div class="mission-icon">

                                <i class="fa-solid fa-headset"></i>

                            </div>

                            <h4>
                                Organized Support
                            </h4>

                            <p>
                                Reception staff can manage appointments,
                                customers and schedules through a dedicated
                                workflow.
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     HOW ASTROCONNECT WORKS
     ========================================================= -->

<section class="workflow-section">

    <div class="container">

        <div class="workflow-heading text-center">

            <span class="section-label dark-label">
                THE ASTROCONNECT EXPERIENCE
            </span>

            <h2>
                From booking to consultation.
            </h2>

            <p>
                A simple process keeps customers informed
                throughout their appointment journey.
            </p>

        </div>


        <div class="row g-4">

            <!-- STEP 1 -->

            <div class="col-md-6 col-lg-3">

                <div class="workflow-card">

                    <div class="workflow-step">
                        01
                    </div>

                    <div class="workflow-icon">

                        <i class="fa-solid fa-list-check"></i>

                    </div>

                    <h4>
                        Choose a Service
                    </h4>

                    <p>
                        Explore available astrology consultation
                        services and select the guidance you need.
                    </p>

                </div>

            </div>


            <!-- STEP 2 -->

            <div class="col-md-6 col-lg-3">

                <div class="workflow-card">

                    <div class="workflow-step">
                        02
                    </div>

                    <div class="workflow-icon">

                        <i class="fa-solid fa-user"></i>

                    </div>

                    <h4>
                        Select an Astrologer
                    </h4>

                    <p>
                        Review astrologer profiles and choose the
                        professional you would like to consult.
                    </p>

                </div>

            </div>


            <!-- STEP 3 -->

            <div class="col-md-6 col-lg-3">

                <div class="workflow-card">

                    <div class="workflow-step">
                        03
                    </div>

                    <div class="workflow-icon">

                        <i class="fa-solid fa-calendar-days"></i>

                    </div>

                    <h4>
                        Book Your Time
                    </h4>

                    <p>
                        Select your preferred date and an available
                        appointment time.
                    </p>

                </div>

            </div>


            <!-- STEP 4 -->

            <div class="col-md-6 col-lg-3">

                <div class="workflow-card">

                    <div class="workflow-step">
                        04
                    </div>

                    <div class="workflow-icon">

                        <i class="fa-solid fa-star"></i>

                    </div>

                    <h4>
                        Receive Guidance
                    </h4>

                    <p>
                        Follow your appointment status and complete
                        your personalized consultation.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     VALUES
     ========================================================= -->

<section class="values-section">

    <div class="container">

        <div class="values-box">

            <div class="row align-items-center g-5">

                <div class="col-lg-5">

                    <span class="section-label light-label">
                        WHAT WE VALUE
                    </span>

                    <h2>
                        Built around clarity,
                        convenience and care.
                    </h2>

                </div>


                <div class="col-lg-7">

                    <div class="values-list">

                        <div class="value-item">

                            <span>
                                01
                            </span>

                            <div>

                                <h5>
                                    Simplicity
                                </h5>

                                <p>
                                    Straightforward booking without
                                    unnecessary complexity.
                                </p>

                            </div>

                        </div>


                        <div class="value-item">

                            <span>
                                02
                            </span>

                            <div>

                                <h5>
                                    Transparency
                                </h5>

                                <p>
                                    Clear service, astrologer and
                                    appointment information.
                                </p>

                            </div>

                        </div>


                        <div class="value-item">

                            <span>
                                03
                            </span>

                            <div>

                                <h5>
                                    Personal Attention
                                </h5>

                                <p>
                                    Consultation information tailored
                                    to each customer's booking.
                                </p>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     FINAL CTA
     ========================================================= -->

<section class="about-cta-section">

    <div class="container">

        <div class="about-cta text-center">

            <div class="cta-symbol">

                <i class="fa-solid fa-moon"></i>

            </div>

            <span class="section-label dark-label">
                BEGIN YOUR JOURNEY
            </span>

            <h2>
                Ready to connect with an astrologer?
            </h2>

            <p>
                Explore our services and book a consultation
                at a time that works for you.
            </p>


            <div class="cta-actions">

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Booking"
                       asp-action="Create"
                       class="btn primary-cta">

                        Book Appointment

                        <i class="fa-solid fa-arrow-right ms-2"></i>

                    </a>
                }
                else
                {
                    <a asp-controller="Account"
                       asp-action="Register"
                       class="btn primary-cta">

                        Get Started

                        <i class="fa-solid fa-arrow-right ms-2"></i>

                    </a>
                }


                <a asp-controller="Public"
                   asp-action="Astrologers"
                   class="btn secondary-cta">

                    Meet Our Astrologers

                </a>

            </div>

        </div>

    </div>

</section>


<style>

    /* =====================================================
           COMMON
           ===================================================== */

    .section-label {
        display: block;
        margin-bottom: 14px;
        color: #e1bf4a;
        font-size: .7rem;
        font-weight: 800;
        letter-spacing: .18em;
    }

    .dark-label {
        color: #987918;
    }

    .light-label {
        color: #e1bf4a;
    }


    /* =====================================================
           HERO
           ===================================================== */

    .about-hero {
        position: relative;
        overflow: hidden;
        padding: 105px 0 95px;
        background: #181710;
        color: white;
    }

    .about-hero-content {
        position: relative;
        z-index: 2;
        max-width: 880px;
    }

    .about-hero h1 {
        margin: 0;
        font-family: 'DM Serif Display', serif;
        font-size: clamp(3.1rem, 6vw, 5.5rem);
        font-weight: 400;
        line-height: 1;
        letter-spacing: -.035em;
    }

        .about-hero h1 span {
            display: block;
            color: #e1bf4a;
        }

    .about-hero p {
        max-width: 670px;
        margin-top: 26px;
        margin-bottom: 0;
        color: rgba(255,255,255,.62);
        font-size: 1rem;
        line-height: 1.8;
    }

    .hero-orbit {
        position: absolute;
        border: 1px solid rgba(225,191,74,.08);
        border-radius: 50%;
    }

    .orbit-one {
        width: 500px;
        height: 500px;
        right: -150px;
        top: -270px;
    }

    .orbit-two {
        width: 300px;
        height: 300px;
        right: 100px;
        bottom: -220px;
    }


    /* =====================================================
           STORY
           ===================================================== */

    .story-section {
        padding: 110px 0;
        background: #f8f5ec;
    }

    .story-title {
        max-width: 700px;
        margin-bottom: 25px;
        color: #181710;
        font-family: 'DM Serif Display', serif;
        font-size: clamp(2.5rem, 4.5vw, 4rem);
        font-weight: 400;
        line-height: 1.03;
    }

    .story-text {
        max-width: 700px;
        color: #777267;
        font-size: .9rem;
        line-height: 1.85;
    }


    /* STORY VISUAL */

    .story-visual {
        min-height: 440px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 26px;
        background: #211f19;
        overflow: hidden;
    }

    .story-orbit {
        position: relative;
        width: 310px;
        height: 310px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(225,191,74,.28);
        border-radius: 50%;
    }

        .story-orbit::before {
            content: "";
            position: absolute;
            inset: 38px;
            border: 1px dashed rgba(225,191,74,.18);
            border-radius: 50%;
        }

    .story-center {
        position: relative;
        z-index: 2;
        width: 150px;
        height: 150px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #e1bf4a;
        color: #181710;
    }

        .story-center i {
            margin-bottom: 8px;
            font-size: 30px;
        }

        .story-center small {
            font-size: .6rem;
            font-weight: 800;
            letter-spacing: .25em;
        }

        .story-center strong {
            font-size: .95rem;
            letter-spacing: .08em;
        }

    .story-star {
        position: absolute;
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(225,191,74,.3);
        border-radius: 50%;
        background: #29271f;
        color: #e1bf4a;
        font-size: .65rem;
    }

    .star-one {
        left: 50%;
        top: -19px;
        transform: translateX(-50%);
    }

    .star-two {
        right: -19px;
        top: 50%;
        transform: translateY(-50%);
    }

    .star-three {
        left: 50%;
        bottom: -19px;
        transform: translateX(-50%);
    }

    .star-four {
        left: -19px;
        top: 50%;
        transform: translateY(-50%);
    }


    /* POINTS */

    .story-points {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
        margin-top: 30px;
    }

        .story-points > div {
            display: flex;
            align-items: center;
            gap: 9px;
            color: #37332b;
            font-size: .78rem;
            font-weight: 700;
        }

        .story-points i {
            color: #a1821e;
        }


    /* =====================================================
           MISSION
           ===================================================== */

    .mission-section {
        padding: 110px 0;
        background: #181710;
        color: white;
    }

    .mission-title {
        max-width: 540px;
        margin-bottom: 23px;
        font-family: 'DM Serif Display', serif;
        font-size: clamp(2.6rem, 4.5vw, 4.2rem);
        font-weight: 400;
        line-height: 1;
    }

        .mission-title span {
            color: #e1bf4a;
        }

    .mission-description {
        max-width: 500px;
        color: rgba(255,255,255,.57);
        font-size: .9rem;
        line-height: 1.85;
    }


    /* MISSION CARDS */

    .mission-card {
        position: relative;
        height: 100%;
        padding: 28px;
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 18px;
        background: #211f19;
    }

    .mission-number {
        position: absolute;
        right: 20px;
        top: 17px;
        color: rgba(255,255,255,.11);
        font-family: 'DM Serif Display', serif;
        font-size: 1.5rem;
    }

    .mission-icon {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        border-radius: 50%;
        background: rgba(225,191,74,.12);
        color: #e1bf4a;
    }

    .mission-card h4 {
        margin-bottom: 10px;
        font-family: 'DM Serif Display', serif;
        font-size: 1.35rem;
        font-weight: 400;
    }

    .mission-card p {
        margin: 0;
        color: rgba(255,255,255,.5);
        font-size: .77rem;
        line-height: 1.75;
    }


    /* =====================================================
           WORKFLOW
           ===================================================== */

    .workflow-section {
        padding: 110px 0;
        background: #fffdf8;
    }

    .workflow-heading {
        max-width: 720px;
        margin: 0 auto 55px;
    }

        .workflow-heading h2 {
            margin-bottom: 16px;
            color: #181710;
            font-family: 'DM Serif Display', serif;
            font-size: clamp(2.5rem, 4vw, 3.8rem);
            font-weight: 400;
            line-height: 1;
        }

        .workflow-heading p {
            color: #777267;
            font-size: .88rem;
            line-height: 1.7;
        }

    .workflow-card {
        position: relative;
        height: 100%;
        padding: 27px;
        border: 1px solid #e5dece;
        border-radius: 18px;
        background: #f8f5ec;
        transition: all .3s ease;
    }

        .workflow-card:hover {
            transform: translateY(-5px);
            border-color: #d4be65;
        }

    .workflow-step {
        position: absolute;
        right: 20px;
        top: 18px;
        color: #d5cebf;
        font-family: 'DM Serif Display', serif;
        font-size: 1.4rem;
    }

    .workflow-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 21px;
        border-radius: 50%;
        background: #181710;
        color: #e1bf4a;
    }

    .workflow-card h4 {
        margin-bottom: 11px;
        color: #181710;
        font-family: 'DM Serif Display', serif;
        font-size: 1.35rem;
        font-weight: 400;
    }

    .workflow-card p {
        margin: 0;
        color: #777267;
        font-size: .76rem;
        line-height: 1.7;
    }


    /* =====================================================
           VALUES
           ===================================================== */

    .values-section {
        padding: 15px 0 105px;
        background: #fffdf8;
    }

    .values-box {
        padding: 55px 60px;
        border-radius: 25px;
        background: #24221c;
        color: white;
    }

        .values-box h2 {
            max-width: 520px;
            margin: 0;
            font-family: 'DM Serif Display', serif;
            font-size: clamp(2.2rem, 4vw, 3.4rem);
            font-weight: 400;
            line-height: 1.05;
        }

    .values-list {
        display: flex;
        flex-direction: column;
    }

    .value-item {
        display: grid;
        grid-template-columns: 50px 1fr;
        gap: 15px;
        padding: 17px 0;
        border-bottom: 1px solid rgba(255,255,255,.09);
    }

        .value-item:last-child {
            border-bottom: none;
        }

        .value-item > span {
            color: #e1bf4a;
            font-family: 'DM Serif Display', serif;
            font-size: 1.1rem;
        }

        .value-item h5 {
            margin-bottom: 5px;
            font-size: .9rem;
            font-weight: 800;
        }

        .value-item p {
            margin: 0;
            color: rgba(255,255,255,.5);
            font-size: .75rem;
        }


    /* =====================================================
           CTA
           ===================================================== */

    .about-cta-section {
        padding: 100px 0;
        background: #f8f5ec;
    }

    .about-cta {
        max-width: 850px;
        margin: auto;
    }

    .cta-symbol {
        width: 58px;
        height: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 22px;
        border-radius: 50%;
        background: #e1bf4a;
        color: #181710;
        font-size: 20px;
    }

    .about-cta h2 {
        margin-bottom: 17px;
        color: #181710;
        font-family: 'DM Serif Display', serif;
        font-size: clamp(2.5rem, 5vw, 4.3rem);
        font-weight: 400;
        line-height: 1;
    }

    .about-cta p {
        max-width: 580px;
        margin: 0 auto 27px;
        color: #777267;
        line-height: 1.75;
    }

    .cta-actions {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 12px;
    }

    .primary-cta,
    .secondary-cta {
        min-height: 50px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 11px 22px;
    }

    .primary-cta {
        background: #181710;
        border: 1px solid #181710;
        color: white;
    }

        .primary-cta:hover {
            background: #302d25;
            border-color: #302d25;
            color: white;
            transform: translateY(-2px);
        }

    .secondary-cta {
        border: 1px solid #cfc6b4;
        background: transparent;
        color: #181710;
    }

        .secondary-cta:hover {
            border-color: #e1bf4a;
            background: #e1bf4a;
            color: #181710;
        }


    /* =====================================================
           RESPONSIVE
           ===================================================== */

    @@media (max-width: 991px) {

        .story-visual {
            min-height: 400px;
        }

        .values-box {
            padding: 45px 35px;
        }
    }


    @@media (max-width: 575px) {

        .about-hero {
            padding: 75px 0;
        }

        .story-section,
        .mission-section,
        .workflow-section,
        .about-cta-section {
            padding-top: 75px;
            padding-bottom: 75px;
        }

        .story-visual {
            min-height: 340px;
        }

        .story-orbit {
            width: 240px;
            height: 240px;
        }

        .story-center {
            width: 120px;
            height: 120px;
        }

        .story-points {
            grid-template-columns: 1fr;
        }

        .values-box {
            padding: 38px 25px;
        }

        .cta-actions {
            flex-direction: column;
        }

        .primary-cta,
        .secondary-cta {
            width: 100%;
        }
    }

</style>